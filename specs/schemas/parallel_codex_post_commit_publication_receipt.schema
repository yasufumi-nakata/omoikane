$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/parallel_codex_post_commit_publication_receipt.schema"
title: ParallelCodexPostCommitPublicationReceipt
description: >
  Digest-only receipt for binding a commit-finalized Parallel Codex integration
  execution to a command-level origin/main push, remote-head verification,
  pre-push and post-push ls-remote head/ref output bindings, and
  protected-branch provider policy receipt, and post-push status/check suite
  evidence before GitHub handoff. The receipt keeps raw execution, pre-push
  verification, push, remote verification, branch-provider, and status-check
  payloads redacted while preserving command, observed head/ref, policy,
  provider freshness, signed timestamp, timestamp replay-guard, provider
  receipt, status-check suite, status-check suite freshness, status-check
  poll budget, signed timestamp, status-check timestamp replay-guard, and
  publication digests.
type: object
additionalProperties: false
required:
  - kind
  - schema_version
  - receipt_id
  - generated_at
  - profile_id
  - integration_policy_profile
  - reference_runbook_ref
  - source_execution_receipt_ref
  - source_execution_receipt_digest
  - source_execution_receipt_digest_bound
  - source_execution_decision
  - source_execution_ready_to_apply
  - source_execution_commit_finalization_ref
  - source_execution_commit_finalization_digest
  - source_execution_commit_finalization_ready
  - source_execution_current_checkout_head
  - source_execution_post_apply_head
  - local_commit_head
  - local_commit_head_matches_source
  - remote_name
  - remote_ref
  - remote_tracking_ref
  - pre_push_remote_head
  - pre_push_remote_head_matches_source
  - pre_push_remote_verification_profile
  - pre_push_remote_verification_result
  - pre_push_remote_verification_command_receipt_digest
  - pre_push_remote_verification_output_profile
  - pre_push_remote_verification_observed_head
  - pre_push_remote_verification_observed_ref
  - pre_push_remote_verification_output_digest
  - pre_push_remote_verification_output_digest_bound
  - remote_head
  - remote_head_matches_local_commit
  - push_command_profile
  - push_command_result
  - push_command_receipt_digest
  - remote_verification_profile
  - remote_verification_result
  - remote_verification_command_receipt_digest
  - remote_verification_output_profile
  - remote_verification_observed_head
  - remote_verification_observed_ref
  - remote_verification_output_digest
  - remote_verification_output_digest_bound
  - protected_branch_profile
  - protected_branch_provider
  - protected_branch_ref
  - protected_branch_policy_ref
  - protected_branch_policy_digest
  - protected_branch_policy_bound
  - protected_branch_status
  - protected_branch_required_checks
  - protected_branch_required_check_count
  - protected_branch_policy_freshness_profile
  - protected_branch_policy_checked_at_ref
  - protected_branch_policy_freshness_window_seconds
  - protected_branch_policy_freshness_status
  - protected_branch_policy_freshness_digest
  - protected_branch_policy_freshness_digest_bound
  - protected_branch_provider_timestamp_profile
  - protected_branch_provider_timestamp_ref
  - protected_branch_provider_timestamp_status
  - protected_branch_provider_timestamp_signature_profile
  - protected_branch_provider_timestamp_signature_digest
  - protected_branch_provider_timestamp_digest
  - protected_branch_provider_timestamp_digest_bound
  - protected_branch_provider_timestamp_replay_profile
  - protected_branch_provider_timestamp_nonce_ref
  - protected_branch_provider_timestamp_replay_status
  - protected_branch_provider_timestamp_replay_digest
  - protected_branch_provider_timestamp_replay_digest_bound
  - status_check_profile
  - status_check_provider
  - status_check_suite_ref
  - status_check_commit_head
  - status_check_required_checks
  - status_check_results
  - status_check_result_count
  - status_check_results_bound
  - status_check_all_required_passed
  - status_check_suite_digest
  - status_check_suite_digest_bound
  - status_check_suite_freshness_profile
  - status_check_suite_checked_at_ref
  - status_check_suite_freshness_window_seconds
  - status_check_suite_freshness_status
  - status_check_suite_freshness_digest
  - status_check_suite_freshness_digest_bound
  - status_check_poll_profile
  - status_check_poll_attempt_count
  - status_check_poll_max_attempts
  - status_check_poll_interval_seconds
  - status_check_poll_terminal_status
  - status_check_poll_digest
  - status_check_poll_digest_bound
  - status_check_suite_timestamp_profile
  - status_check_suite_timestamp_ref
  - status_check_suite_timestamp_status
  - status_check_suite_timestamp_signature_profile
  - status_check_suite_timestamp_signature_digest
  - status_check_suite_timestamp_digest
  - status_check_suite_timestamp_digest_bound
  - status_check_suite_timestamp_replay_profile
  - status_check_suite_timestamp_nonce_ref
  - status_check_suite_timestamp_replay_status
  - status_check_suite_timestamp_replay_digest
  - status_check_suite_timestamp_replay_digest_bound
  - protected_branch_receipt_digest
  - protected_branch_receipt_digest_bound
  - publication_digest
  - publication_status
  - ready_for_github_handoff
  - blocking_reasons
  - result_summary
  - raw_execution_payload_stored
  - raw_post_commit_publication_payload_stored
  - raw_pre_push_remote_verification_stdout_stored
  - raw_pre_push_remote_verification_stderr_stored
  - raw_push_stdout_stored
  - raw_push_stderr_stored
  - raw_remote_verification_stdout_stored
  - raw_remote_verification_stderr_stored
  - raw_protected_branch_provider_payload_stored
  - raw_protected_branch_policy_freshness_payload_stored
  - raw_protected_branch_provider_timestamp_payload_stored
  - raw_protected_branch_provider_timestamp_replay_guard_payload_stored
  - raw_status_check_provider_payload_stored
  - raw_status_check_suite_freshness_payload_stored
  - raw_status_check_poll_payload_stored
  - raw_status_check_suite_timestamp_payload_stored
  - raw_status_check_suite_timestamp_replay_guard_payload_stored
  - receipt_digest
  - receipt_ref
properties:
  kind:
    const: parallel_codex_post_commit_publication_receipt
  schema_version:
    type: string
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  receipt_id:
    type: string
    pattern: "^parallel-codex-publication-[a-f0-9]{12}$"
  generated_at:
    type: string
    format: date-time
  profile_id:
    const: origin-main-post-commit-publication-v1
  integration_policy_profile:
    const: main-checkout-worker-result-ingestion-v1
  reference_runbook_ref:
    const: references/parallel-codex-orchestration.md
  source_execution_receipt_ref:
    type: string
    pattern: "^receipt://parallel-codex/parallel-codex-execution-[a-f0-9]{12}$"
  source_execution_receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_execution_receipt_digest_bound:
    type: boolean
  source_execution_decision:
    enum:
      - ready-to-apply
      - blocked
  source_execution_ready_to_apply:
    type: boolean
  source_execution_commit_finalization_ref:
    type: string
    pattern: "^commit-finalization://parallel-codex/[a-f0-9]{12}$"
  source_execution_commit_finalization_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_execution_commit_finalization_ready:
    type: boolean
  source_execution_current_checkout_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  source_execution_post_apply_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  local_commit_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  local_commit_head_matches_source:
    type: boolean
  remote_name:
    const: origin
  remote_ref:
    const: refs/heads/main
  remote_tracking_ref:
    const: refs/remotes/origin/main
  pre_push_remote_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  pre_push_remote_head_matches_source:
    type: boolean
  pre_push_remote_verification_profile:
    const: command-bound-git-ls-remote-origin-main-v1
  pre_push_remote_verification_result:
    $ref: "#/$defs/command_result"
  pre_push_remote_verification_command_receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  pre_push_remote_verification_output_profile:
    const: ls-remote-head-ref-output-binding-v1
  pre_push_remote_verification_observed_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  pre_push_remote_verification_observed_ref:
    const: refs/heads/main
  pre_push_remote_verification_output_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  pre_push_remote_verification_output_digest_bound:
    type: boolean
  remote_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  remote_head_matches_local_commit:
    type: boolean
  push_command_profile:
    const: command-bound-git-push-origin-main-v1
  push_command_result:
    $ref: "#/$defs/command_result"
  push_command_receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  remote_verification_profile:
    const: command-bound-git-ls-remote-origin-main-v1
  remote_verification_result:
    $ref: "#/$defs/command_result"
  remote_verification_command_receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  remote_verification_output_profile:
    const: ls-remote-head-ref-output-binding-v1
  remote_verification_observed_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  remote_verification_observed_ref:
    const: refs/heads/main
  remote_verification_output_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  remote_verification_output_digest_bound:
    type: boolean
  protected_branch_profile:
    const: protected-branch-provider-policy-receipt-v1
  protected_branch_provider:
    const: github
  protected_branch_ref:
    const: refs/heads/main
  protected_branch_policy_ref:
    type: string
    minLength: 1
  protected_branch_policy_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  protected_branch_policy_bound:
    type: boolean
  protected_branch_status:
    enum:
      - protected
      - unprotected
      - unknown
  protected_branch_required_checks:
    type: array
    minItems: 1
    items:
      type: string
      minLength: 1
  protected_branch_required_check_count:
    type: integer
    minimum: 1
  protected_branch_policy_freshness_profile:
    const: protected-branch-provider-policy-freshness-v1
  protected_branch_policy_checked_at_ref:
    type: string
    minLength: 1
  protected_branch_policy_freshness_window_seconds:
    type: integer
    minimum: 1
    maximum: 900
  protected_branch_policy_freshness_status:
    enum:
      - fresh
      - expired
      - unknown
  protected_branch_policy_freshness_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  protected_branch_policy_freshness_digest_bound:
    type: boolean
  protected_branch_provider_timestamp_profile:
    const: protected-branch-provider-policy-signed-timestamp-v1
  protected_branch_provider_timestamp_ref:
    type: string
    minLength: 1
  protected_branch_provider_timestamp_status:
    enum:
      - signed-current
      - stale
      - invalid
  protected_branch_provider_timestamp_signature_profile:
    const: protected-branch-provider-policy-timestamp-signature-v1
  protected_branch_provider_timestamp_signature_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  protected_branch_provider_timestamp_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  protected_branch_provider_timestamp_digest_bound:
    type: boolean
  protected_branch_provider_timestamp_replay_profile:
    const: protected-branch-provider-policy-timestamp-replay-guard-v1
  protected_branch_provider_timestamp_nonce_ref:
    type: string
    minLength: 1
  protected_branch_provider_timestamp_replay_status:
    enum:
      - unique
      - replayed
  protected_branch_provider_timestamp_replay_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  protected_branch_provider_timestamp_replay_digest_bound:
    type: boolean
  status_check_profile:
    const: post-push-provider-status-check-suite-v1
  status_check_provider:
    const: github
  status_check_suite_ref:
    type: string
    minLength: 1
  status_check_commit_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  status_check_required_checks:
    type: array
    minItems: 1
    items:
      type: string
      minLength: 1
  status_check_results:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/status_check_result"
  status_check_result_count:
    type: integer
    minimum: 1
  status_check_results_bound:
    type: boolean
  status_check_all_required_passed:
    type: boolean
  status_check_suite_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  status_check_suite_digest_bound:
    type: boolean
  status_check_suite_freshness_profile:
    const: post-push-provider-status-check-suite-freshness-v1
  status_check_suite_checked_at_ref:
    type: string
    minLength: 1
  status_check_suite_freshness_window_seconds:
    type: integer
    minimum: 1
    maximum: 900
  status_check_suite_freshness_status:
    enum:
      - fresh
      - expired
      - unknown
  status_check_suite_freshness_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  status_check_suite_freshness_digest_bound:
    type: boolean
  status_check_poll_profile:
    const: post-push-status-check-poll-budget-v1
  status_check_poll_attempt_count:
    type: integer
    minimum: 1
    maximum: 5
  status_check_poll_max_attempts:
    type: integer
    minimum: 1
    maximum: 5
  status_check_poll_interval_seconds:
    type: integer
    minimum: 1
    maximum: 30
  status_check_poll_terminal_status:
    enum:
      - completed
      - exhausted
  status_check_poll_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  status_check_poll_digest_bound:
    type: boolean
  status_check_suite_timestamp_profile:
    const: post-push-provider-status-check-suite-signed-timestamp-v1
  status_check_suite_timestamp_ref:
    type: string
    minLength: 1
  status_check_suite_timestamp_status:
    enum:
      - signed-current
      - stale
      - invalid
  status_check_suite_timestamp_signature_profile:
    const: post-push-provider-status-check-suite-timestamp-signature-v1
  status_check_suite_timestamp_signature_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  status_check_suite_timestamp_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  status_check_suite_timestamp_digest_bound:
    type: boolean
  status_check_suite_timestamp_replay_profile:
    const: post-push-provider-status-check-suite-timestamp-replay-guard-v1
  status_check_suite_timestamp_nonce_ref:
    type: string
    minLength: 1
  status_check_suite_timestamp_replay_status:
    enum:
      - unique
      - replayed
  status_check_suite_timestamp_replay_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  status_check_suite_timestamp_replay_digest_bound:
    type: boolean
  protected_branch_receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  protected_branch_receipt_digest_bound:
    type: boolean
  publication_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  publication_status:
    enum:
      - published
      - blocked
  ready_for_github_handoff:
    type: boolean
  blocking_reasons:
    type: array
    items:
      type: string
  result_summary:
    type: string
    minLength: 1
  raw_execution_payload_stored:
    const: false
  raw_post_commit_publication_payload_stored:
    const: false
  raw_pre_push_remote_verification_stdout_stored:
    const: false
  raw_pre_push_remote_verification_stderr_stored:
    const: false
  raw_push_stdout_stored:
    const: false
  raw_push_stderr_stored:
    const: false
  raw_remote_verification_stdout_stored:
    const: false
  raw_remote_verification_stderr_stored:
    const: false
  raw_protected_branch_provider_payload_stored:
    const: false
  raw_protected_branch_policy_freshness_payload_stored:
    const: false
  raw_protected_branch_provider_timestamp_payload_stored:
    const: false
  raw_protected_branch_provider_timestamp_replay_guard_payload_stored:
    const: false
  raw_status_check_provider_payload_stored:
    const: false
  raw_status_check_suite_freshness_payload_stored:
    const: false
  raw_status_check_poll_payload_stored:
    const: false
  raw_status_check_suite_timestamp_payload_stored:
    const: false
  raw_status_check_suite_timestamp_replay_guard_payload_stored:
    const: false
  receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  receipt_ref:
    type: string
    pattern: "^receipt://parallel-codex/parallel-codex-publication-[a-f0-9]{12}$"
$defs:
  command_result:
    type: object
    additionalProperties: false
    required:
      - command_profile
      - command
      - status
      - exit_code
      - stdout_digest
      - stderr_digest
      - raw_stdout_stored
      - raw_stderr_stored
      - command_receipt_digest
    properties:
      command_profile:
        enum:
          - command-bound-git-push-origin-main-v1
          - command-bound-git-ls-remote-origin-main-v1
      command:
        type: string
        minLength: 1
      status:
        type: string
        minLength: 1
      exit_code:
        type: integer
      stdout_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      stderr_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      raw_stdout_stored:
        const: false
      raw_stderr_stored:
        const: false
      command_receipt_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
  status_check_result:
    type: object
    additionalProperties: false
    required:
      - check_profile
      - check_name
      - status
      - conclusion
      - commit_head
      - details_ref
      - raw_status_check_payload_stored
      - check_run_digest
    properties:
      check_profile:
        const: post-push-provider-status-check-run-v1
      check_name:
        type: string
        minLength: 1
      status:
        enum:
          - completed
          - queued
          - in_progress
          - failed
          - unknown
      conclusion:
        enum:
          - success
          - failure
          - cancelled
          - timed_out
          - neutral
          - skipped
          - unknown
      commit_head:
        type: string
        pattern: "^[a-f0-9]{40}$"
      details_ref:
        type: string
        minLength: 1
      raw_status_check_payload_stored:
        const: false
      check_run_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
