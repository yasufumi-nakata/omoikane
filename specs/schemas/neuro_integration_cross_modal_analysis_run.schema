$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/neuro_integration_cross_modal_analysis_run.schema"
title: NeuroIntegrationCrossModalAnalysisRun
description: >
  Digest-only bounded result receipt for executing a Neuro Integration Workbench
  cross-modal analysis plan without storing raw source, connector, or result
  payloads.
type: object
additionalProperties: false
required:
  - schema_version
  - cross_modal_analysis_run_ref
  - created_at
  - profile_id
  - identity_id
  - source_bundle_ref
  - source_bundle_digest
  - connector_bundle_ref
  - connector_bundle_digest
  - cross_modal_analysis_plan_ref
  - cross_modal_analysis_plan_digest
  - analysis_pair_count
  - result_count
  - pair_results
  - result_digests
  - result_digest_set
  - all_pair_results_bound
  - seed_survey_eeg_result_bound
  - operator_review_ready
  - coding_agent_review_ready
  - result_summary
  - cross_modal_analysis_run_bound
  - storage_policy
  - claim_ceiling
  - conflict_refs
  - mind_upload_conflict_sink_url
  - raw_source_payload_stored
  - raw_analysis_payload_stored
  - raw_connector_payload_stored
  - raw_result_payload_stored
  - clinical_diagnosis_claimed
  - consciousness_reproduction_claimed
  - identity_replacement_claimed
  - cross_modal_analysis_run_digest
properties:
  schema_version:
    const: "1.0"
  cross_modal_analysis_run_ref:
    type: string
    pattern: "^cross-modal-analysis-run://neuro-integration/niw-cross-modal-run-[a-f0-9]{12}$"
  created_at:
    type: string
    format: date-time
  profile_id:
    const: neuro-cross-modal-analysis-run-v1
  identity_id:
    type: string
    minLength: 1
  source_bundle_ref:
    type: string
    minLength: 1
  source_bundle_digest:
    $ref: "#/$defs/sha256"
  connector_bundle_ref:
    type: string
    pattern: "^connector-bundle://neuro-integration/niw-connector-bundle-[a-f0-9]{12}$"
  connector_bundle_digest:
    $ref: "#/$defs/sha256"
  cross_modal_analysis_plan_ref:
    type: string
    pattern: "^cross-modal-analysis-plan://neuro-integration/niw-cross-modal-plan-[a-f0-9]{12}$"
  cross_modal_analysis_plan_digest:
    $ref: "#/$defs/sha256"
  analysis_pair_count:
    type: integer
    minimum: 1
  result_count:
    type: integer
    minimum: 1
  pair_results:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/pair_result"
  result_digests:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/sha256"
  result_digest_set:
    $ref: "#/$defs/sha256"
  all_pair_results_bound:
    const: true
  seed_survey_eeg_result_bound:
    const: true
  operator_review_ready:
    const: true
  coding_agent_review_ready:
    const: true
  result_summary:
    type: object
    additionalProperties: false
    required:
      - result_count
      - bounded_result_count
      - average_compatibility_score
      - max_uncertainty_proxy
    properties:
      result_count:
        type: integer
        minimum: 1
      bounded_result_count:
        type: integer
        minimum: 1
      average_compatibility_score:
        type: number
        minimum: 0
        maximum: 1
      max_uncertainty_proxy:
        type: number
        minimum: 0
        maximum: 1
  cross_modal_analysis_run_bound:
    const: true
  storage_policy:
    const: pair-digest+bounded-result-summary+operator-review-only
  claim_ceiling:
    const: feature-alignment-and-analysis-plan-only
  conflict_refs:
    type: array
    minItems: 1
    items:
      type: object
  mind_upload_conflict_sink_url:
    const: https://mind-upload.com/frontiers/neurodata-integration
  raw_source_payload_stored:
    const: false
  raw_analysis_payload_stored:
    const: false
  raw_connector_payload_stored:
    const: false
  raw_result_payload_stored:
    const: false
  clinical_diagnosis_claimed:
    const: false
  consciousness_reproduction_claimed:
    const: false
  identity_replacement_claimed:
    const: false
  cross_modal_analysis_run_digest:
    $ref: "#/$defs/sha256"
$defs:
  sha256:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_type:
    type: string
    pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
  analysis_recipe_id:
    enum:
      - survey-eeg-feature-alignment
      - neural-electrical-hemodynamic-context
      - organoid-context-comparison
      - biosignal-autonomic-context-screen
      - behavioral-performance-context-screen
      - omics-physiology-context-screen
      - omics-clinical-context-screen
      - clinical-context-modulator-screen
      - feature-summary-cross-modal-screen
  result_status:
    enum:
      - seed-survey-eeg-result-bound
      - in-vitro-context-result-bound
      - biosignal-context-result-bound
      - behavioral-context-result-bound
      - omics-context-result-bound
      - clinical-context-result-bound
      - cross-modal-context-result-bound
  result_axis_summary:
    type: object
    additionalProperties: false
    required:
      - left_axis_mean
      - right_axis_mean
      - bounded_compatibility_score
      - construct_coverage_proxy
      - uncertainty_proxy
    properties:
      left_axis_mean:
        type: number
        minimum: 0
        maximum: 1
      right_axis_mean:
        type: number
        minimum: 0
        maximum: 1
      bounded_compatibility_score:
        type: number
        minimum: 0
        maximum: 1
      construct_coverage_proxy:
        type: number
        minimum: 0
        maximum: 1
      uncertainty_proxy:
        type: number
        minimum: 0
        maximum: 1
  pair_result:
    type: object
    additionalProperties: false
    required:
      - result_ref
      - pair_ref
      - pair_digest
      - source_types
      - analysis_recipe_id
      - result_status
      - result_axis_summary
      - operator_summary
      - agent_next_action
      - evidence_refs
      - requires_ml_expertise
      - result_bound
      - claim_ceiling
      - raw_result_payload_stored
      - clinical_diagnosis_claimed
      - consciousness_reproduction_claimed
      - identity_replacement_claimed
      - result_digest
    properties:
      result_ref:
        type: string
        pattern: "^analysis-result://neuro-integration/niw-analysis-result-[a-f0-9]{12}$"
      pair_ref:
        type: string
        pattern: "^analysis-pair://neuro-integration/niw-analysis-pair-[a-f0-9]{12}$"
      pair_digest:
        $ref: "#/$defs/sha256"
      source_types:
        type: array
        minItems: 2
        maxItems: 2
        uniqueItems: true
        items:
          $ref: "#/$defs/source_type"
      analysis_recipe_id:
        $ref: "#/$defs/analysis_recipe_id"
      result_status:
        $ref: "#/$defs/result_status"
      result_axis_summary:
        $ref: "#/$defs/result_axis_summary"
      operator_summary:
        type: string
        minLength: 1
      agent_next_action:
        type: string
        minLength: 1
      evidence_refs:
        type: array
        minItems: 6
        items:
          type: string
          minLength: 1
      requires_ml_expertise:
        const: false
      result_bound:
        const: true
      claim_ceiling:
        const: feature-alignment-and-analysis-plan-only
      raw_result_payload_stored:
        const: false
      clinical_diagnosis_claimed:
        const: false
      consciousness_reproduction_claimed:
        const: false
      identity_replacement_claimed:
        const: false
      result_digest:
        $ref: "#/$defs/sha256"
