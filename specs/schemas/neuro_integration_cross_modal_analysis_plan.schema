$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/neuro_integration_cross_modal_analysis_plan.schema"
title: NeuroIntegrationCrossModalAnalysisPlan
description: >
  Digest-only plan that enumerates bounded cross-modal analysis recipes for every
  current Neuro Integration Workbench source-type pair while binding each pair to
  connector refs, including modality-specific open biodata context screens, and
  preserving the feature-alignment claim ceiling.
type: object
additionalProperties: false
required:
  - schema_version
  - cross_modal_analysis_plan_ref
  - created_at
  - profile_id
  - identity_id
  - source_bundle_ref
  - source_bundle_digest
  - analysis_ref
  - analysis_digest
  - operator_guide_ref
  - operator_guide_digest
  - replacement_plan_ref
  - replacement_plan_digest
  - connector_bundle_ref
  - connector_bundle_digest
  - source_types
  - source_families
  - source_type_count
  - analysis_pair_count
  - expected_analysis_pair_count
  - analysis_pairs
  - pair_digests
  - pair_digest_set
  - recipe_catalog
  - all_source_types_represented
  - source_pair_coverage_bound
  - survey_eeg_seed_analysis_bound
  - connector_bundle_bound
  - non_ml_operator_ready
  - coding_agent_ready
  - cross_modal_analysis_plan_bound
  - planning_scope
  - storage_policy
  - claim_ceiling
  - conflict_refs
  - mind_upload_conflict_sink_url
  - raw_source_payload_stored
  - raw_analysis_payload_stored
  - raw_connector_payload_stored
  - raw_plan_payload_stored
  - clinical_diagnosis_claimed
  - consciousness_reproduction_claimed
  - identity_replacement_claimed
  - cross_modal_analysis_plan_digest
properties:
  schema_version:
    const: "1.0"
  cross_modal_analysis_plan_ref:
    type: string
    pattern: "^cross-modal-analysis-plan://neuro-integration/niw-cross-modal-plan-[a-f0-9]{12}$"
  created_at:
    type: string
    format: date-time
  profile_id:
    const: neuro-cross-modal-analysis-plan-v1
  identity_id:
    type: string
    minLength: 1
  source_bundle_ref:
    type: string
    minLength: 1
  source_bundle_digest:
    $ref: "#/$defs/sha256"
  analysis_ref:
    type: string
    minLength: 1
  analysis_digest:
    $ref: "#/$defs/sha256"
  operator_guide_ref:
    type: string
    minLength: 1
  operator_guide_digest:
    $ref: "#/$defs/sha256"
  replacement_plan_ref:
    type: string
    pattern: "^replacement-plan://neuro-integration/niw-replacement-plan-[a-f0-9]{12}$"
  replacement_plan_digest:
    $ref: "#/$defs/sha256"
  connector_bundle_ref:
    type: string
    pattern: "^connector-bundle://neuro-integration/niw-connector-bundle-[a-f0-9]{12}$"
  connector_bundle_digest:
    $ref: "#/$defs/sha256"
  source_types:
    type: array
    minItems: 2
    uniqueItems: true
    items:
      $ref: "#/$defs/source_type"
  source_families:
    type: object
    minProperties: 2
    additionalProperties:
      type: string
      minLength: 1
  source_type_count:
    type: integer
    minimum: 2
  analysis_pair_count:
    type: integer
    minimum: 1
  expected_analysis_pair_count:
    type: integer
    minimum: 1
  analysis_pairs:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/analysis_pair"
  pair_digests:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/sha256"
  pair_digest_set:
    $ref: "#/$defs/sha256"
  recipe_catalog:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/recipe_catalog_item"
  all_source_types_represented:
    const: true
  source_pair_coverage_bound:
    const: true
  survey_eeg_seed_analysis_bound:
    const: true
  connector_bundle_bound:
    const: true
  non_ml_operator_ready:
    const: true
  coding_agent_ready:
    const: true
  cross_modal_analysis_plan_bound:
    const: true
  planning_scope:
    const: all-current-source-type-pairs
  storage_policy:
    const: source-pair-feature-digest+connector-ref-analysis-plan-only
  claim_ceiling:
    const: feature-alignment-and-analysis-plan-only
  conflict_refs:
    type: array
    minItems: 1
    items:
      type: object
  mind_upload_conflict_sink_url:
    const: https://mind-upload.com/frontiers/neurodata-integration
  raw_source_payload_stored:
    const: false
  raw_analysis_payload_stored:
    const: false
  raw_connector_payload_stored:
    const: false
  raw_plan_payload_stored:
    const: false
  clinical_diagnosis_claimed:
    const: false
  consciousness_reproduction_claimed:
    const: false
  identity_replacement_claimed:
    const: false
  cross_modal_analysis_plan_digest:
    $ref: "#/$defs/sha256"
$defs:
  sha256:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_type:
    type: string
    pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
  replacement_lane:
    enum:
      - measurement
      - analysis
      - data-curation
      - operator-copilot
      - agent-automation
  analysis_recipe_id:
    enum:
      - survey-eeg-feature-alignment
      - neural-electrical-hemodynamic-context
      - organoid-context-comparison
      - biosignal-autonomic-context-screen
      - behavioral-performance-context-screen
      - omics-physiology-context-screen
      - omics-clinical-context-screen
      - clinical-context-modulator-screen
      - feature-summary-cross-modal-screen
  connector_support:
    type: object
    additionalProperties: false
    required:
      - replacement_lane
      - connector_refs
      - connector_digests
      - bound
    properties:
      replacement_lane:
        $ref: "#/$defs/replacement_lane"
      connector_refs:
        type: array
        minItems: 1
        items:
          type: string
          minLength: 1
      connector_digests:
        type: array
        minItems: 1
        items:
          $ref: "#/$defs/sha256"
      bound:
        const: true
  analysis_pair:
    type: object
    additionalProperties: false
    required:
      - pair_ref
      - source_types
      - source_families
      - source_feature_digests
      - analysis_recipe_id
      - target_constructs
      - plain_language_question
      - agent_action
      - seed_analysis_digest
      - connector_support
      - all_required_connectors_bound
      - requires_ml_expertise
      - claim_ceiling
      - raw_pair_payload_stored
      - clinical_diagnosis_claimed
      - consciousness_reproduction_claimed
      - identity_replacement_claimed
      - pair_digest
    properties:
      pair_ref:
        type: string
        pattern: "^analysis-pair://neuro-integration/niw-analysis-pair-[a-f0-9]{12}$"
      source_types:
        type: array
        minItems: 2
        maxItems: 2
        uniqueItems: true
        items:
          $ref: "#/$defs/source_type"
      source_families:
        type: object
        minProperties: 2
        additionalProperties:
          type: string
          minLength: 1
      source_feature_digests:
        type: object
        minProperties: 2
        additionalProperties:
          $ref: "#/$defs/sha256"
      analysis_recipe_id:
        $ref: "#/$defs/analysis_recipe_id"
      target_constructs:
        type: array
        minItems: 1
        items:
          type: string
          minLength: 1
      plain_language_question:
        type: string
        minLength: 1
      agent_action:
        type: string
        minLength: 1
      seed_analysis_digest:
        anyOf:
          - $ref: "#/$defs/sha256"
          - const: ""
      connector_support:
        type: array
        minItems: 5
        items:
          $ref: "#/$defs/connector_support"
      all_required_connectors_bound:
        const: true
      requires_ml_expertise:
        const: false
      claim_ceiling:
        const: feature-alignment-and-analysis-plan-only
      raw_pair_payload_stored:
        const: false
      clinical_diagnosis_claimed:
        const: false
      consciousness_reproduction_claimed:
        const: false
      identity_replacement_claimed:
        const: false
      pair_digest:
        $ref: "#/$defs/sha256"
  recipe_catalog_item:
    type: object
    additionalProperties: false
    required:
      - analysis_recipe_id
      - pair_count
      - requires_ml_expertise
      - claim_ceiling
    properties:
      analysis_recipe_id:
        $ref: "#/$defs/analysis_recipe_id"
      pair_count:
        type: integer
        minimum: 1
      requires_ml_expertise:
        const: false
      claim_ceiling:
        const: feature-alignment-and-analysis-plan-only
