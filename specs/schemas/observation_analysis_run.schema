$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/observation_analysis_run.schema"
title: ObservationAnalysisRun
description: >
  Digest-only bounded run receipt for executing a universal observation analysis
  plan as lane-level summaries without storing raw source, model, instruction,
  or result payloads.
type: object
additionalProperties: false
required:
  - schema_version
  - analysis_run_ref
  - created_at
  - profile_id
  - source_bundle_ref
  - source_bundle_digest
  - integration_graph_ref
  - integration_graph_digest
  - analysis_plan_ref
  - analysis_plan_digest
  - operator_guide_ref
  - operator_guide_digest
  - required_analysis_lanes
  - analysis_lane_count
  - result_count
  - lane_results
  - result_digests
  - result_digest_set
  - all_lane_results_bound
  - operator_review_ready
  - coding_agent_review_ready
  - analysis_run_summary
  - observation_analysis_run_bound
  - storage_policy
  - claim_ceiling
  - conflict_refs
  - mind_upload_conflict_sink_url
  - raw_source_payload_stored
  - raw_analysis_payload_stored
  - raw_model_payload_stored
  - raw_instruction_payload_stored
  - raw_result_payload_stored
  - clinical_diagnosis_claimed
  - causal_truth_claimed
  - truth_unification_claimed
  - complete_human_knowledge_claimed
  - consciousness_reproduction_claimed
  - identity_replacement_claimed
  - analysis_run_digest
properties:
  schema_version:
    const: "1.0"
  analysis_run_ref:
    type: string
    pattern: "^analysis-run://universal-observation/uoi-run-[a-f0-9]{12}$"
  created_at:
    type: string
    format: date-time
  profile_id:
    const: universal-observation-analysis-run-v1
  source_bundle_ref:
    type: string
    minLength: 1
  source_bundle_digest:
    $ref: "#/$defs/sha256"
  integration_graph_ref:
    type: string
    pattern: "^graph://universal-observation/uoi-graph-[a-f0-9]{12}$"
  integration_graph_digest:
    $ref: "#/$defs/sha256"
  analysis_plan_ref:
    type: string
    pattern: "^analysis-plan://universal-observation/uoi-plan-[a-f0-9]{12}$"
  analysis_plan_digest:
    $ref: "#/$defs/sha256"
  operator_guide_ref:
    type: string
    pattern: "^operator-guide://universal-observation/uoi-guide-[a-f0-9]{12}$"
  operator_guide_digest:
    $ref: "#/$defs/sha256"
  required_analysis_lanes:
    const:
      - ingest
      - normalize
      - align
      - model
      - audit
      - publish-digest
  analysis_lane_count:
    const: 6
  result_count:
    const: 6
  lane_results:
    type: array
    minItems: 6
    maxItems: 6
    items:
      $ref: "#/$defs/lane_result"
  result_digests:
    type: array
    minItems: 6
    maxItems: 6
    items:
      $ref: "#/$defs/sha256"
  result_digest_set:
    $ref: "#/$defs/sha256"
  all_lane_results_bound:
    const: true
  operator_review_ready:
    const: true
  coding_agent_review_ready:
    const: true
  analysis_run_summary:
    type: object
    additionalProperties: false
    required:
      - result_count
      - bounded_result_count
      - source_count
      - family_coverage_count
      - average_integration_readiness
      - maximum_uncertainty_proxy
    properties:
      result_count:
        const: 6
      bounded_result_count:
        const: 6
      source_count:
        type: integer
        minimum: 4
      family_coverage_count:
        type: integer
        minimum: 4
      average_integration_readiness:
        type: number
        minimum: 0
        maximum: 1
      maximum_uncertainty_proxy:
        type: number
        minimum: 0
        maximum: 1
  observation_analysis_run_bound:
    const: true
  storage_policy:
    const: lane-digest+bounded-result-summary+operator-review-only
  claim_ceiling:
    const: cross-domain-feature-integration-plan-only
  conflict_refs:
    type: array
    minItems: 1
    items:
      type: object
  mind_upload_conflict_sink_url:
    const: https://mind-upload.com/frontiers/universal-observation-integration
  raw_source_payload_stored:
    const: false
  raw_analysis_payload_stored:
    const: false
  raw_model_payload_stored:
    const: false
  raw_instruction_payload_stored:
    const: false
  raw_result_payload_stored:
    const: false
  clinical_diagnosis_claimed:
    const: false
  causal_truth_claimed:
    const: false
  truth_unification_claimed:
    const: false
  complete_human_knowledge_claimed:
    const: false
  consciousness_reproduction_claimed:
    const: false
  identity_replacement_claimed:
    const: false
  analysis_run_digest:
    $ref: "#/$defs/sha256"
$defs:
  sha256:
    type: string
    pattern: "^[a-f0-9]{64}$"
  lane_id:
    enum:
      - ingest
      - normalize
      - align
      - model
      - audit
      - publish-digest
  result_status:
    enum:
      - ingest-result-bound
      - normalize-result-bound
      - align-result-bound
      - model-result-bound
      - audit-result-bound
      - publish-digest-result-bound
  result_axis_summary:
    type: object
    additionalProperties: false
    required:
      - source_count
      - family_coverage_count
      - edge_count
      - alignment_axis_count
      - average_integration_readiness
      - maximum_uncertainty_proxy
      - average_edge_confidence_proxy
      - rights_boundary_bound
    properties:
      source_count:
        type: integer
        minimum: 4
      family_coverage_count:
        type: integer
        minimum: 4
      edge_count:
        type: integer
        minimum: 4
      alignment_axis_count:
        const: 7
      average_integration_readiness:
        type: number
        minimum: 0
        maximum: 1
      maximum_uncertainty_proxy:
        type: number
        minimum: 0
        maximum: 1
      average_edge_confidence_proxy:
        type: number
        minimum: 0
        maximum: 1
      rights_boundary_bound:
        const: true
  lane_result:
    type: object
    additionalProperties: false
    required:
      - result_ref
      - lane_id
      - lane_digest
      - planned_analysis_id
      - result_status
      - source_bundle_digest
      - integration_graph_digest
      - analysis_plan_digest
      - result_axis_summary
      - operator_summary
      - agent_next_action
      - evidence_refs
      - requires_ml_expertise
      - result_bound
      - claim_ceiling
      - raw_lane_payload_stored
      - raw_result_payload_stored
      - clinical_diagnosis_claimed
      - causal_truth_claimed
      - truth_unification_claimed
      - complete_human_knowledge_claimed
      - consciousness_reproduction_claimed
      - identity_replacement_claimed
      - result_digest
    properties:
      result_ref:
        type: string
        pattern: "^analysis-result://universal-observation/uoi-result-[a-f0-9]{12}$"
      lane_id:
        $ref: "#/$defs/lane_id"
      lane_digest:
        $ref: "#/$defs/sha256"
      planned_analysis_id:
        type: string
        minLength: 1
      result_status:
        $ref: "#/$defs/result_status"
      source_bundle_digest:
        $ref: "#/$defs/sha256"
      integration_graph_digest:
        $ref: "#/$defs/sha256"
      analysis_plan_digest:
        $ref: "#/$defs/sha256"
      result_axis_summary:
        $ref: "#/$defs/result_axis_summary"
      operator_summary:
        type: string
        minLength: 1
      agent_next_action:
        type: string
        minLength: 1
      evidence_refs:
        type: array
        minItems: 4
        items:
          type: string
          minLength: 1
      requires_ml_expertise:
        const: false
      result_bound:
        const: true
      claim_ceiling:
        const: cross-domain-feature-integration-plan-only
      raw_lane_payload_stored:
        const: false
      raw_result_payload_stored:
        const: false
      clinical_diagnosis_claimed:
        const: false
      causal_truth_claimed:
        const: false
      truth_unification_claimed:
        const: false
      complete_human_knowledge_claimed:
        const: false
      consciousness_reproduction_claimed:
        const: false
      identity_replacement_claimed:
        const: false
      result_digest:
        $ref: "#/$defs/sha256"
