$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/neuro_integration_operator_runbook.schema"
title: NeuroIntegrationOperatorRunbook
description: >
  Digest-only operator runbook receipt that binds the Neuro Integration
  Workbench receipt chain into ordered plain-language workflow steps and
  coding-agent tasks for non-ML operators.
type: object
additionalProperties: false
required:
  - schema_version
  - operator_runbook_ref
  - created_at
  - profile_id
  - identity_id
  - source_bundle_ref
  - source_bundle_digest
  - workspace_ref
  - workspace_digest
  - analysis_ref
  - analysis_digest
  - operator_guide_ref
  - operator_guide_digest
  - replacement_plan_ref
  - replacement_plan_digest
  - connector_bundle_ref
  - connector_bundle_digest
  - collection_protocol_ref
  - collection_protocol_digest
  - collection_run_ref
  - collection_run_digest
  - measurement_quality_gate_ref
  - measurement_quality_gate_digest
  - cross_modal_analysis_plan_ref
  - cross_modal_analysis_plan_digest
  - cross_modal_analysis_run_ref
  - cross_modal_analysis_run_digest
  - interpretation_synthesis_ref
  - interpretation_synthesis_digest
  - longitudinal_timeline_ref
  - longitudinal_timeline_digest
  - source_types
  - source_type_count
  - required_replacement_lanes
  - receipt_bindings
  - receipt_digest_set
  - workflow_steps
  - workflow_step_count
  - workflow_step_digests
  - workflow_step_digest_set
  - all_required_receipts_bound
  - all_workflow_steps_bound
  - operator_cards_bound
  - coding_agent_tasks_bound
  - beginner_operator_supported
  - llm_native_workflow_bound
  - coding_agent_ready
  - operator_runbook_summary
  - operator_runbook_bound
  - storage_policy
  - claim_ceiling
  - conflict_refs
  - mind_upload_conflict_sink_url
  - raw_receipt_payload_stored
  - raw_runbook_payload_stored
  - raw_operator_payload_stored
  - raw_agent_task_payload_stored
  - clinical_diagnosis_claimed
  - semantic_thought_content_generated
  - consciousness_reproduction_claimed
  - identity_replacement_claimed
  - upload_readiness_claimed
  - operator_runbook_digest
properties:
  schema_version:
    const: "1.0"
  operator_runbook_ref:
    type: string
    pattern: "^operator-runbook://neuro-integration/niw-runbook-[a-f0-9]{12}$"
  created_at:
    type: string
    format: date-time
  profile_id:
    const: neuro-operator-runbook-v1
  identity_id:
    type: string
    minLength: 1
  source_bundle_ref:
    type: string
    minLength: 1
  source_bundle_digest:
    $ref: "#/$defs/sha256"
  workspace_ref:
    type: string
    minLength: 1
  workspace_digest:
    $ref: "#/$defs/sha256"
  analysis_ref:
    type: string
    minLength: 1
  analysis_digest:
    $ref: "#/$defs/sha256"
  operator_guide_ref:
    type: string
    minLength: 1
  operator_guide_digest:
    $ref: "#/$defs/sha256"
  replacement_plan_ref:
    type: string
    minLength: 1
  replacement_plan_digest:
    $ref: "#/$defs/sha256"
  connector_bundle_ref:
    type: string
    minLength: 1
  connector_bundle_digest:
    $ref: "#/$defs/sha256"
  collection_protocol_ref:
    type: string
    minLength: 1
  collection_protocol_digest:
    $ref: "#/$defs/sha256"
  collection_run_ref:
    type: string
    minLength: 1
  collection_run_digest:
    $ref: "#/$defs/sha256"
  measurement_quality_gate_ref:
    type: string
    minLength: 1
  measurement_quality_gate_digest:
    $ref: "#/$defs/sha256"
  cross_modal_analysis_plan_ref:
    type: string
    minLength: 1
  cross_modal_analysis_plan_digest:
    $ref: "#/$defs/sha256"
  cross_modal_analysis_run_ref:
    type: string
    minLength: 1
  cross_modal_analysis_run_digest:
    $ref: "#/$defs/sha256"
  interpretation_synthesis_ref:
    type: string
    minLength: 1
  interpretation_synthesis_digest:
    $ref: "#/$defs/sha256"
  longitudinal_timeline_ref:
    type: string
    minLength: 1
  longitudinal_timeline_digest:
    $ref: "#/$defs/sha256"
  source_types:
    type: array
    minItems: 2
    uniqueItems: true
    items:
      $ref: "#/$defs/source_type"
  source_type_count:
    type: integer
    minimum: 2
  required_replacement_lanes:
    type: array
    minItems: 5
    uniqueItems: true
    items:
      enum:
        - measurement
        - analysis
        - data-curation
        - operator-copilot
        - agent-automation
  receipt_bindings:
    type: array
    minItems: 13
    items:
      $ref: "#/$defs/receipt_binding"
  receipt_digest_set:
    $ref: "#/$defs/sha256"
  workflow_steps:
    type: array
    minItems: 9
    items:
      $ref: "#/$defs/workflow_step"
  workflow_step_count:
    type: integer
    minimum: 9
  workflow_step_digests:
    type: array
    minItems: 9
    items:
      $ref: "#/$defs/sha256"
  workflow_step_digest_set:
    $ref: "#/$defs/sha256"
  all_required_receipts_bound:
    const: true
  all_workflow_steps_bound:
    const: true
  operator_cards_bound:
    const: true
  coding_agent_tasks_bound:
    const: true
  beginner_operator_supported:
    const: true
  llm_native_workflow_bound:
    const: true
  coding_agent_ready:
    const: true
  operator_runbook_summary:
    type: object
    additionalProperties: false
    required:
      - step_count
      - bound_step_count
      - source_type_count
      - replacement_lane_count
      - operator_card_count
      - coding_agent_task_count
      - receipt_binding_count
      - unsupported_step_count
    properties:
      step_count:
        type: integer
        minimum: 9
      bound_step_count:
        type: integer
        minimum: 9
      source_type_count:
        type: integer
        minimum: 2
      replacement_lane_count:
        type: integer
        minimum: 5
      operator_card_count:
        type: integer
        minimum: 9
      coding_agent_task_count:
        type: integer
        minimum: 9
      receipt_binding_count:
        type: integer
        minimum: 13
      unsupported_step_count:
        const: 0
  operator_runbook_bound:
    const: true
  storage_policy:
    const: receipt-digest+plain-language-workflow-step-only
  claim_ceiling:
    const: feature-alignment-and-analysis-plan-only
  conflict_refs:
    type: array
    minItems: 1
    items:
      type: object
  mind_upload_conflict_sink_url:
    const: https://mind-upload.com/frontiers/neurodata-integration
  raw_receipt_payload_stored:
    const: false
  raw_runbook_payload_stored:
    const: false
  raw_operator_payload_stored:
    const: false
  raw_agent_task_payload_stored:
    const: false
  clinical_diagnosis_claimed:
    const: false
  semantic_thought_content_generated:
    const: false
  consciousness_reproduction_claimed:
    const: false
  identity_replacement_claimed:
    const: false
  upload_readiness_claimed:
    const: false
  operator_runbook_digest:
    $ref: "#/$defs/sha256"
$defs:
  sha256:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_type:
    type: string
    pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
  receipt_role:
    enum:
      - source-bundle
      - workspace
      - survey-eeg-analysis
      - operator-guide
      - replacement-plan
      - connector-bundle
      - collection-protocol
      - collection-run
      - measurement-quality-gate
      - cross-modal-analysis-plan
      - cross-modal-analysis-run
      - interpretation-synthesis
      - longitudinal-timeline
  receipt_binding:
    type: object
    additionalProperties: false
    required:
      - receipt_role
      - receipt_ref
      - receipt_digest
      - profile_id
      - bound
      - raw_receipt_payload_stored
      - clinical_diagnosis_claimed
      - semantic_thought_content_generated
      - consciousness_reproduction_claimed
      - identity_replacement_claimed
      - upload_readiness_claimed
      - receipt_binding_digest
    properties:
      receipt_role:
        $ref: "#/$defs/receipt_role"
      receipt_ref:
        type: string
        minLength: 1
      receipt_digest:
        $ref: "#/$defs/sha256"
      profile_id:
        type: string
        minLength: 1
      bound:
        const: true
      raw_receipt_payload_stored:
        const: false
      clinical_diagnosis_claimed:
        const: false
      semantic_thought_content_generated:
        const: false
      consciousness_reproduction_claimed:
        const: false
      identity_replacement_claimed:
        const: false
      upload_readiness_claimed:
        const: false
      receipt_binding_digest:
        $ref: "#/$defs/sha256"
  stage_kind:
    enum:
      - source-import
      - workspace-orientation
      - application-replacement
      - collection-protocol
      - collection-run
      - measurement-quality
      - cross-modal-analysis
      - interpretation-review
      - longitudinal-review
  workflow_step:
    type: object
    additionalProperties: false
    required:
      - runbook_step_ref
      - position
      - step_id
      - stage_kind
      - source_types
      - input_receipt_refs
      - input_receipt_digests
      - operator_card
      - coding_agent_task
      - required_checks
      - requires_ml_expertise
      - runbook_step_bound
      - claim_ceiling
      - raw_receipt_payload_stored
      - raw_operator_payload_stored
      - raw_agent_task_payload_stored
      - clinical_diagnosis_claimed
      - semantic_thought_content_generated
      - consciousness_reproduction_claimed
      - identity_replacement_claimed
      - upload_readiness_claimed
      - runbook_step_digest
    properties:
      runbook_step_ref:
        type: string
        pattern: "^runbook-step://neuro-integration/niw-runbook-step-[a-f0-9]{12}$"
      position:
        type: integer
        minimum: 1
      step_id:
        type: string
        minLength: 1
      stage_kind:
        $ref: "#/$defs/stage_kind"
      source_types:
        type: array
        minItems: 2
        items:
          $ref: "#/$defs/source_type"
      input_receipt_refs:
        type: array
        minItems: 1
        items:
          type: string
          minLength: 1
      input_receipt_digests:
        type: array
        minItems: 1
        items:
          $ref: "#/$defs/sha256"
      operator_card:
        type: string
        minLength: 1
      coding_agent_task:
        type: string
        minLength: 1
      required_checks:
        type: array
        minItems: 1
        items:
          type: string
          minLength: 1
      requires_ml_expertise:
        const: false
      runbook_step_bound:
        const: true
      claim_ceiling:
        const: feature-alignment-and-analysis-plan-only
      raw_receipt_payload_stored:
        const: false
      raw_operator_payload_stored:
        const: false
      raw_agent_task_payload_stored:
        const: false
      clinical_diagnosis_claimed:
        const: false
      semantic_thought_content_generated:
        const: false
      consciousness_reproduction_claimed:
        const: false
      identity_replacement_claimed:
        const: false
      upload_readiness_claimed:
        const: false
      runbook_step_digest:
        $ref: "#/$defs/sha256"
