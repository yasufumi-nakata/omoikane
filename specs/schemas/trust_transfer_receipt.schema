$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/trust_transfer_receipt.schema"
title: TrustTransferReceipt
description: >
  Digest-bound cross-substrate trust export/import receipt with fixed
  guardian/human quorum, live remote verifier federation, re-attestation
  cadence, destination lifecycle history, and a selectable public export
  profile with verifier, destination lifecycle, and recovery-review
  disclosure-floor branching.
type: object
additionalProperties: false
required:
  - kind
  - schema_version
  - receipt_id
  - transfer_policy_id
  - attestation_policy_id
  - export_profile_id
  - agent_id
  - source_substrate_ref
  - destination_substrate_ref
  - destination_host_ref
  - transferred_at
  - source_snapshot_ref
  - source_snapshot_digest
  - destination_snapshot_ref
  - destination_snapshot_digest
  - export_receipt
  - federation_attestation
  - import_receipt
  - destination_lifecycle
  - validation
  - status
  - receipt_digest
properties:
  kind:
    const: trust_transfer_receipt
  schema_version:
    type: string
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  receipt_id:
    type: string
    pattern: "^trust-transfer-[a-f0-9]{12}$"
  transfer_policy_id:
    const: bounded-cross-substrate-trust-transfer-v1
  attestation_policy_id:
    const: bounded-trust-transfer-attestation-federation-v1
  export_profile_id:
    type: string
    enum:
      - snapshot-clone-with-history
      - bounded-trust-transfer-redacted-export-v1
  agent_id:
    type: string
    minLength: 1
  source_substrate_ref:
    type: string
    minLength: 1
  destination_substrate_ref:
    type: string
    minLength: 1
  destination_host_ref:
    type: string
    minLength: 1
  transferred_at:
    type: string
    format: date-time
  source_snapshot_ref:
    type: string
    minLength: 1
  source_snapshot_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_snapshot:
    $ref: "./trust_snapshot.schema"
  source_snapshot_redacted:
    $ref: "./trust_redacted_snapshot.schema"
  destination_snapshot_ref:
    type: string
    minLength: 1
  destination_snapshot_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  destination_snapshot:
    $ref: "./trust_snapshot.schema"
  destination_snapshot_redacted:
    $ref: "./trust_redacted_snapshot.schema"
  export_receipt:
    type: object
    additionalProperties: false
    required:
      - export_id
      - export_ref
      - source_policy_id
      - provenance_policy_id
      - threshold_digest
      - history_digest
      - history_commitment_digest
      - eligibility_digest
      - history_event_count
      - council_session_ref
      - rationale
      - redaction_policy_id
      - redacted_fields
    properties:
      export_id:
        type: string
        pattern: "^trust-export-[a-f0-9]{12}$"
      export_ref:
        type: string
        minLength: 1
      source_policy_id:
        type: string
        minLength: 1
      provenance_policy_id:
        type: string
        minLength: 1
      threshold_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      history_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      history_commitment_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      eligibility_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      history_event_count:
        type: integer
        minimum: 0
      council_session_ref:
        type: string
        minLength: 1
      rationale:
        type: string
        minLength: 1
      redaction_policy_id:
        type: string
        enum:
          - trust-transfer-no-redaction-v1
          - bounded-trust-transfer-history-redaction-v1
      redacted_fields:
        type: array
        uniqueItems: true
        items:
          type: string
          minLength: 1
  federation_attestation:
    type: object
    additionalProperties: false
    required:
      - attestation_id
      - attestation_ref
      - required_roles
      - received_roles
      - attestors
      - quorum
      - quorum_received
      - route_ref
      - route_digest
      - remote_verifier_federation
      - re_attestation_cadence
      - cross_substrate_attested
    properties:
      attestation_id:
        type: string
        pattern: "^trust-attestation-[a-f0-9]{12}$"
      attestation_ref:
        type: string
        minLength: 1
      required_roles:
        type: array
        minItems: 3
        maxItems: 3
        uniqueItems: true
        items:
          type: string
          enum:
            - source-guardian
            - destination-guardian
            - human-reviewer
      received_roles:
        type: array
        minItems: 3
        maxItems: 3
        uniqueItems: true
        items:
          type: string
          enum:
            - source-guardian
            - destination-guardian
            - human-reviewer
      attestors:
        type: array
        minItems: 3
        maxItems: 3
        items:
          type: object
          additionalProperties: false
          required:
            - role
            - actor_ref
            - attestation_ref
            - eligibility_gate
            - status
          properties:
            role:
              type: string
              enum:
                - source-guardian
                - destination-guardian
                - human-reviewer
            actor_ref:
              type: string
              minLength: 1
            attestation_ref:
              type: string
              minLength: 1
            eligibility_gate:
              type: string
              enum:
                - guardian_role
                - human-explicit-approval
            status:
              const: attested
      quorum:
        const: 3
      quorum_received:
        type: integer
        minimum: 0
      route_ref:
        type: string
        minLength: 1
      route_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      remote_verifier_federation:
        oneOf:
          - type: object
            additionalProperties: false
            required:
              - federation_id
              - federation_ref
              - federation_policy_id
              - network_profile_id
              - quorum_policy_id
              - human_reviewer_ref
              - required_verifier_count
              - received_verifier_count
              - verifier_receipts
              - verifier_refs
              - trust_root_refs
              - jurisdictions
              - trust_root_quorum
              - jurisdiction_quorum
              - authority_chain_refs
              - reviewer_binding_digest
              - federation_status
              - receipt_digest
            properties:
              federation_id:
                type: string
                pattern: "^trust-verifier-federation-[a-f0-9]{12}$"
              federation_ref:
                type: string
                minLength: 1
              federation_policy_id:
                const: bounded-live-trust-transfer-verifier-federation-v1
              network_profile_id:
                const: guardian-reviewer-remote-attestation-v1
              quorum_policy_id:
                type: string
                enum:
                  - bounded-trust-transfer-fixed-verifier-pair-v1
                  - bounded-trust-transfer-multi-root-recovery-v1
              human_reviewer_ref:
                type: string
                minLength: 1
              required_verifier_count:
                type: integer
                minimum: 2
              received_verifier_count:
                type: integer
                minimum: 0
              verifier_receipts:
                type: array
                minItems: 2
                items:
                  $ref: "./guardian_verifier_network_receipt.schema"
              verifier_refs:
                type: array
                minItems: 2
                uniqueItems: true
                items:
                  type: string
                  minLength: 1
              trust_root_refs:
                type: array
                minItems: 1
                uniqueItems: true
                items:
                  type: string
                  minLength: 1
              jurisdictions:
                type: array
                minItems: 1
                uniqueItems: true
                items:
                  type: string
                  minLength: 1
              trust_root_quorum:
                type: integer
                minimum: 1
              jurisdiction_quorum:
                type: integer
                minimum: 1
              authority_chain_refs:
                type: array
                minItems: 1
                uniqueItems: true
                items:
                  type: string
                  minLength: 1
              reviewer_binding_digest:
                type: string
                pattern: "^[a-f0-9]{64}$"
              federation_status:
                const: verified
              receipt_digest:
                type: string
                pattern: "^[a-f0-9]{64}$"
          - $ref: "./trust_redacted_verifier_federation.schema"
      re_attestation_cadence:
        type: object
        additionalProperties: false
        required:
          - cadence_id
          - cadence_ref
          - cadence_policy_id
          - attested_at
          - renew_after
          - valid_until
          - grace_window_seconds
          - covered_verifier_receipt_ids
          - bound_federation_ref
          - bound_federation_digest
          - cadence_status
          - receipt_digest
        properties:
          cadence_id:
            type: string
            pattern: "^trust-re-attestation-[a-f0-9]{12}$"
          cadence_ref:
            type: string
            minLength: 1
          cadence_policy_id:
            const: bounded-trust-transfer-re-attestation-cadence-v1
          attested_at:
            type: string
            format: date-time
          renew_after:
            type: string
            format: date-time
          valid_until:
            type: string
            format: date-time
          grace_window_seconds:
            const: 240
          covered_verifier_receipt_ids:
            type: array
            minItems: 2
            uniqueItems: true
            items:
              type: string
              minLength: 1
          bound_federation_ref:
            type: string
            minLength: 1
          bound_federation_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          cadence_status:
            const: scheduled
          receipt_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
      cross_substrate_attested:
        const: true
  import_receipt:
    type: object
    additionalProperties: false
    required:
      - import_id
      - import_ref
      - destination_policy_id
      - provenance_policy_id
      - threshold_digest
      - history_digest
      - history_commitment_digest
      - eligibility_digest
      - history_event_count
      - seed_mode
      - destination_seeded
    properties:
      import_id:
        type: string
        pattern: "^trust-import-[a-f0-9]{12}$"
      import_ref:
        type: string
        minLength: 1
      destination_policy_id:
        type: string
        minLength: 1
      provenance_policy_id:
        type: string
        minLength: 1
      threshold_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      history_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      history_commitment_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      eligibility_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      history_event_count:
        type: integer
        minimum: 0
      seed_mode:
        const: snapshot-clone-with-history
      destination_seeded:
        const: true
  destination_lifecycle:
    oneOf:
      - type: object
        additionalProperties: false
        required:
          - lifecycle_id
          - lifecycle_ref
          - lifecycle_policy_id
          - current_status
          - active_entry_ref
          - latest_federation_ref
          - latest_federation_digest
          - latest_cadence_ref
          - latest_cadence_digest
          - revocation_fail_closed_action
          - history
          - lifecycle_digest
        properties:
          lifecycle_id:
            type: string
            pattern: "^trust-destination-lifecycle-[a-f0-9]{12}$"
          lifecycle_ref:
            type: string
            minLength: 1
          lifecycle_policy_id:
            const: bounded-trust-transfer-destination-lifecycle-v1
          current_status:
            type: string
            enum:
              - current
              - revoked
          active_entry_ref:
            type: string
            minLength: 1
          latest_federation_ref:
            type: string
            minLength: 1
          latest_federation_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          latest_cadence_ref:
            type: string
            minLength: 1
          latest_cadence_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          revocation_fail_closed_action:
            const: disable-destination-trust-usage
          history:
            type: array
            minItems: 4
            items:
              type: object
              additionalProperties: false
              required:
                - sequence
                - entry_id
                - entry_ref
                - event_type
                - status
                - recorded_at
                - attested_at
                - valid_until
                - quorum_policy_id
                - federation_ref
                - federation_digest
                - cadence_ref
                - cadence_digest
                - trust_root_quorum
                - jurisdiction_quorum
                - covered_verifier_receipt_ids
                - covered_trust_root_refs
                - covered_jurisdictions
                - destination_snapshot_digest
                - rationale
              properties:
                sequence:
                  type: integer
                  minimum: 0
                entry_id:
                  type: string
                  pattern: "^trust-destination-entry-[a-f0-9]{12}$"
                entry_ref:
                  type: string
                  minLength: 1
                event_type:
                  type: string
                  enum:
                    - imported
                    - renewed
                    - revoked
                    - recovered
                status:
                  type: string
                  enum:
                    - current
                    - revoked
                recorded_at:
                  type: string
                  format: date-time
                attested_at:
                  type: string
                  format: date-time
                valid_until:
                  type: string
                  format: date-time
                quorum_policy_id:
                  type: string
                  enum:
                    - bounded-trust-transfer-fixed-verifier-pair-v1
                    - bounded-trust-transfer-multi-root-recovery-v1
                federation_ref:
                  type: string
                  minLength: 1
                federation_digest:
                  type: string
                  pattern: "^[a-f0-9]{64}$"
                cadence_ref:
                  type: string
                  minLength: 1
                cadence_digest:
                  type: string
                  pattern: "^[a-f0-9]{64}$"
                trust_root_quorum:
                  type: integer
                  minimum: 1
                jurisdiction_quorum:
                  type: integer
                  minimum: 1
                covered_verifier_receipt_ids:
                  type: array
                  minItems: 2
                  uniqueItems: true
                  items:
                    type: string
                    minLength: 1
                covered_trust_root_refs:
                  type: array
                  minItems: 1
                  uniqueItems: true
                  items:
                    type: string
                    minLength: 1
                covered_jurisdictions:
                  type: array
                  minItems: 1
                  uniqueItems: true
                  items:
                    type: string
                    minLength: 1
                destination_snapshot_digest:
                  type: string
                  pattern: "^[a-f0-9]{64}$"
                rationale:
                  type: string
                  minLength: 1
                recovery_review:
                  $ref: "./trust_recovery_review.schema"
          lifecycle_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
      - $ref: "./trust_redacted_destination_lifecycle.schema"
  validation:
    type: object
    additionalProperties: false
    required:
      - source_snapshot_digest_bound
      - destination_snapshot_digest_bound
      - export_profile_bound
      - history_commitment_bound
      - history_preserved
      - thresholds_preserved
      - provenance_policy_preserved
      - eligibility_preserved
      - federation_quorum_attested
      - live_remote_verifier_attested
      - remote_verifier_receipts_bound
      - remote_verifier_disclosure_bound
      - re_attestation_cadence_bound
      - re_attestation_current
      - destination_lifecycle_bound
      - destination_lifecycle_disclosure_bound
      - destination_renewal_history_bound
      - destination_revocation_history_bound
      - destination_recovery_history_bound
      - recovery_quorum_bound
      - recovery_review_bound
      - recovery_notice_scope_bound
      - destination_current
      - destination_seeded
      - receipt_digest_bound
      - ok
    properties:
      source_snapshot_digest_bound:
        type: boolean
      destination_snapshot_digest_bound:
        type: boolean
      export_profile_bound:
        type: boolean
      history_commitment_bound:
        type: boolean
      history_preserved:
        type: boolean
      thresholds_preserved:
        type: boolean
      provenance_policy_preserved:
        type: boolean
      eligibility_preserved:
        type: boolean
      federation_quorum_attested:
        type: boolean
      live_remote_verifier_attested:
        type: boolean
      remote_verifier_receipts_bound:
        type: boolean
      remote_verifier_disclosure_bound:
        type: boolean
      re_attestation_cadence_bound:
        type: boolean
      re_attestation_current:
        type: boolean
      destination_lifecycle_bound:
        type: boolean
      destination_lifecycle_disclosure_bound:
        type: boolean
      destination_renewal_history_bound:
        type: boolean
      destination_revocation_history_bound:
        type: boolean
      destination_recovery_history_bound:
        type: boolean
      recovery_quorum_bound:
        type: boolean
      recovery_review_bound:
        type: boolean
      recovery_notice_scope_bound:
        type: boolean
      destination_current:
        type: boolean
      destination_seeded:
        type: boolean
      receipt_digest_bound:
        type: boolean
      ok:
        type: boolean
  status:
    const: imported
  receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
allOf:
  - if:
      properties:
        export_profile_id:
          const: snapshot-clone-with-history
    then:
      properties:
        federation_attestation:
          properties:
            remote_verifier_federation:
              type: object
              required:
                - verifier_receipts
        destination_lifecycle:
          type: object
          required:
            - active_entry_ref
            - history
  - if:
      properties:
        export_profile_id:
          const: bounded-trust-transfer-redacted-export-v1
    then:
      properties:
        federation_attestation:
          properties:
            remote_verifier_federation:
              $ref: "./trust_redacted_verifier_federation.schema"
        destination_lifecycle:
          $ref: "./trust_redacted_destination_lifecycle.schema"
oneOf:
  - required:
      - source_snapshot
      - destination_snapshot
    properties:
      export_profile_id:
        const: snapshot-clone-with-history
  - required:
      - source_snapshot_redacted
      - destination_snapshot_redacted
    properties:
      export_profile_id:
        const: bounded-trust-transfer-redacted-export-v1
