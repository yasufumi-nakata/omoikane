$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/neuro_integration_measurement_quality_gate.schema"
title: NeuroIntegrationMeasurementQualityGate
description: >
  Digest-only measurement quality gate that binds collection run results to
  calibration, artifact/QC, consent freshness, operator review, and quality
  authority refs before downstream analysis planning.
type: object
additionalProperties: false
required:
  - schema_version
  - measurement_quality_gate_ref
  - created_at
  - profile_id
  - identity_id
  - source_bundle_ref
  - source_bundle_digest
  - collection_run_ref
  - collection_run_digest
  - source_types
  - source_type_count
  - quality_item_count
  - quality_items
  - quality_item_digests
  - quality_item_digest_set
  - all_quality_items_bound
  - seed_survey_eeg_quality_bound
  - expansion_quality_bound
  - calibration_refs_bound
  - artifact_qc_refs_bound
  - consent_freshness_bound
  - operator_review_ready
  - coding_agent_review_ready
  - quality_summary
  - measurement_quality_gate_bound
  - storage_policy
  - claim_ceiling
  - conflict_refs
  - mind_upload_conflict_sink_url
  - raw_source_payload_stored
  - raw_quality_payload_stored
  - raw_calibration_payload_stored
  - raw_artifact_payload_stored
  - raw_consent_payload_stored
  - clinical_diagnosis_claimed
  - consciousness_reproduction_claimed
  - identity_replacement_claimed
  - measurement_quality_gate_digest
properties:
  schema_version:
    const: "1.0"
  measurement_quality_gate_ref:
    type: string
    pattern: "^quality-gate://neuro-integration/niw-quality-gate-[a-f0-9]{12}$"
  created_at:
    type: string
    format: date-time
  profile_id:
    const: neuro-measurement-quality-gate-v1
  identity_id:
    type: string
    minLength: 1
  source_bundle_ref:
    type: string
    minLength: 1
  source_bundle_digest:
    $ref: "#/$defs/sha256"
  collection_run_ref:
    type: string
    pattern: "^collection-run://neuro-integration/niw-collection-run-[a-f0-9]{12}$"
  collection_run_digest:
    $ref: "#/$defs/sha256"
  source_types:
    type: array
    minItems: 2
    uniqueItems: true
    items:
      $ref: "#/$defs/source_type"
  source_type_count:
    type: integer
    minimum: 2
  quality_item_count:
    type: integer
    minimum: 2
  quality_items:
    type: array
    minItems: 2
    items:
      $ref: "#/$defs/quality_item"
  quality_item_digests:
    type: array
    minItems: 2
    items:
      $ref: "#/$defs/sha256"
  quality_item_digest_set:
    $ref: "#/$defs/sha256"
  all_quality_items_bound:
    const: true
  seed_survey_eeg_quality_bound:
    const: true
  expansion_quality_bound:
    const: true
  calibration_refs_bound:
    const: true
  artifact_qc_refs_bound:
    const: true
  consent_freshness_bound:
    const: true
  operator_review_ready:
    const: true
  coding_agent_review_ready:
    const: true
  quality_summary:
    type: object
    additionalProperties: false
    required:
      - quality_item_count
      - bounded_quality_item_count
      - average_measurement_quality_score
      - max_measurement_risk_proxy
    properties:
      quality_item_count:
        type: integer
        minimum: 2
      bounded_quality_item_count:
        type: integer
        minimum: 2
      average_measurement_quality_score:
        type: number
        minimum: 0
        maximum: 1
      max_measurement_risk_proxy:
        type: number
        minimum: 0
        maximum: 1
  measurement_quality_gate_bound:
    const: true
  storage_policy:
    const: collection-result-digest+calibration-artifact-consent-quality-gate-only
  claim_ceiling:
    const: feature-alignment-and-analysis-plan-only
  conflict_refs:
    type: array
    minItems: 1
    items:
      type: object
  mind_upload_conflict_sink_url:
    const: https://mind-upload.com/frontiers/neurodata-integration
  raw_source_payload_stored:
    const: false
  raw_quality_payload_stored:
    const: false
  raw_calibration_payload_stored:
    const: false
  raw_artifact_payload_stored:
    const: false
  raw_consent_payload_stored:
    const: false
  clinical_diagnosis_claimed:
    const: false
  consciousness_reproduction_claimed:
    const: false
  identity_replacement_claimed:
    const: false
  measurement_quality_gate_digest:
    $ref: "#/$defs/sha256"
$defs:
  sha256:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_type:
    type: string
    pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
  quality_gate_status:
    enum:
      - seed-questionnaire-quality-gate-bound
      - seed-eeg-quality-gate-bound
      - neuroimaging-quality-context-bound
      - in-vitro-quality-context-bound
      - generic-biodata-quality-gate-bound
  quality_axis_summary:
    type: object
    additionalProperties: false
    required:
      - collection_quality_score
      - calibration_score
      - artifact_acceptance_score
      - consent_freshness_score
      - sampling_completeness_score
      - measurement_quality_score
      - measurement_risk_proxy
    properties:
      collection_quality_score:
        type: number
        minimum: 0
        maximum: 1
      calibration_score:
        type: number
        minimum: 0
        maximum: 1
      artifact_acceptance_score:
        type: number
        minimum: 0
        maximum: 1
      consent_freshness_score:
        type: number
        minimum: 0
        maximum: 1
      sampling_completeness_score:
        type: number
        minimum: 0
        maximum: 1
      measurement_quality_score:
        type: number
        minimum: 0
        maximum: 1
      measurement_risk_proxy:
        type: number
        minimum: 0
        maximum: 1
  quality_item:
    type: object
    additionalProperties: false
    required:
      - quality_item_ref
      - source_type
      - source_family
      - source_ref
      - feature_summary_ref
      - feature_digest
      - collection_result_ref
      - collection_result_digest
      - collection_window_ref
      - measurement_connector_refs
      - measurement_connector_digests
      - calibration_ref
      - artifact_qc_ref
      - consent_freshness_ref
      - operator_review_ref
      - quality_authority_ref
      - calibration_score
      - artifact_acceptance_score
      - consent_freshness_score
      - sampling_completeness_score
      - quality_axis_summary
      - quality_gate_status
      - operator_summary
      - agent_next_action
      - evidence_refs
      - requires_ml_expertise
      - quality_item_bound
      - claim_ceiling
      - raw_source_payload_stored
      - raw_quality_payload_stored
      - raw_calibration_payload_stored
      - raw_artifact_payload_stored
      - raw_consent_payload_stored
      - clinical_diagnosis_claimed
      - consciousness_reproduction_claimed
      - identity_replacement_claimed
      - quality_item_digest
    properties:
      quality_item_ref:
        type: string
        pattern: "^quality-item://neuro-integration/niw-quality-item-[a-f0-9]{12}$"
      source_type:
        $ref: "#/$defs/source_type"
      source_family:
        type: string
        minLength: 1
      source_ref:
        type: string
        minLength: 1
      feature_summary_ref:
        type: string
        minLength: 1
      feature_digest:
        $ref: "#/$defs/sha256"
      collection_result_ref:
        type: string
        pattern: "^collection-result://neuro-integration/niw-collection-result-[a-f0-9]{12}$"
      collection_result_digest:
        $ref: "#/$defs/sha256"
      collection_window_ref:
        type: string
        pattern: "^collection-window://neuro-integration/[a-z0-9_-]+/niw-window-[a-f0-9]{12}$"
      measurement_connector_refs:
        type: array
        minItems: 1
        items:
          type: string
          minLength: 1
      measurement_connector_digests:
        type: array
        minItems: 1
        items:
          $ref: "#/$defs/sha256"
      calibration_ref:
        type: string
        minLength: 1
      artifact_qc_ref:
        type: string
        minLength: 1
      consent_freshness_ref:
        type: string
        minLength: 1
      operator_review_ref:
        type: string
        minLength: 1
      quality_authority_ref:
        type: string
        minLength: 1
      calibration_score:
        type: number
        minimum: 0
        maximum: 1
      artifact_acceptance_score:
        type: number
        minimum: 0
        maximum: 1
      consent_freshness_score:
        type: number
        minimum: 0
        maximum: 1
      sampling_completeness_score:
        type: number
        minimum: 0
        maximum: 1
      quality_axis_summary:
        $ref: "#/$defs/quality_axis_summary"
      quality_gate_status:
        $ref: "#/$defs/quality_gate_status"
      operator_summary:
        type: string
        minLength: 1
      agent_next_action:
        type: string
        minLength: 1
      evidence_refs:
        type: array
        minItems: 6
        items:
          type: string
          minLength: 1
      requires_ml_expertise:
        const: false
      quality_item_bound:
        const: true
      claim_ceiling:
        const: feature-alignment-and-analysis-plan-only
      raw_source_payload_stored:
        const: false
      raw_quality_payload_stored:
        const: false
      raw_calibration_payload_stored:
        const: false
      raw_artifact_payload_stored:
        const: false
      raw_consent_payload_stored:
        const: false
      clinical_diagnosis_claimed:
        const: false
      consciousness_reproduction_claimed:
        const: false
      identity_replacement_claimed:
        const: false
      quality_item_digest:
        $ref: "#/$defs/sha256"
