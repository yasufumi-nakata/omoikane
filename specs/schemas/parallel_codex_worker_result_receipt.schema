$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/parallel_codex_worker_result_receipt.schema"
title: ParallelCodexWorkerResultReceipt
description: >
  Digest-only receipt for accepting or blocking one parallel Codex worker result
  before it is integrated into the main checkout, including signed worker
  identity evidence and remote branch / PR source metadata without storing raw
  worker identity, remote metadata, or remote revocation payloads.
  Workspace-enacted marker-only file changes are separately counted and
  digest-bound so worker output that only appends local enactment comments cannot
  be accepted as a substantive integration payload.
  Remote source revocation evidence also carries a bounded freshness window so
  old current-not-revoked checks cannot be reused silently, and the freshness
  refs are bound to a signed provider timestamp digest before acceptance.
  The signed timestamp is also chained to a replay nonce and previous nonce
  digest so a current-looking provider timestamp cannot be reused silently.
type: object
additionalProperties: false
required:
  - kind
  - schema_version
  - receipt_id
  - generated_at
  - profile_id
  - integration_policy_profile
  - reference_runbook_ref
  - source_system
  - remote_metadata_profile
  - remote_branch_ref
  - remote_pr_ref
  - remote_review_authority_profile
  - remote_review_authority_ref
  - remote_review_authority_digest
  - accepted_source_policy_ref
  - accepted_source_policy_digest
  - remote_source_revocation_profile
  - remote_source_revocation_ref
  - remote_source_revocation_status
  - remote_source_revocation_digest
  - remote_source_revocation_freshness_profile
  - remote_source_revocation_checked_at_ref
  - remote_source_revocation_freshness_window_seconds
  - remote_source_revocation_expires_at_ref
  - remote_source_revocation_freshness_status
  - remote_source_revocation_freshness_digest
  - remote_source_revocation_timestamp_profile
  - remote_source_revocation_timestamp_ref
  - remote_source_revocation_timestamp_status
  - remote_source_revocation_timestamp_digest
  - remote_source_revocation_timestamp_signature_profile
  - remote_source_revocation_timestamp_signature_digest
  - remote_source_revocation_timestamp_replay_guard_profile
  - remote_source_revocation_timestamp_nonce_ref
  - remote_source_revocation_timestamp_previous_nonce_digest
  - remote_source_revocation_timestamp_replay_status
  - remote_source_revocation_timestamp_replay_guard_digest
  - remote_metadata_digest
  - remote_metadata_bound
  - worker_identity_profile
  - worker_identity_ref
  - worker_identity_digest
  - worker_identity_signature_profile
  - worker_identity_signature_role
  - worker_identity_signature_digest
  - worker_identity_evidence_bound
  - upstream_receipt_ref
  - upstream_receipt_digest
  - upstream_patch_candidate_receipt_refs
  - upstream_patch_candidate_receipt_digests
  - upstream_binding_digest
  - worker_id
  - worker_role
  - worker_result_status
  - main_checkout_head
  - worker_base_commit
  - base_head_matches
  - ownership_scope
  - changed_files
  - changed_file_count
  - changed_file_manifest_digest
  - workspace_marker_hygiene_profile
  - workspace_marker_only_changed_files
  - workspace_marker_only_change_count
  - workspace_marker_hygiene_status
  - workspace_marker_hygiene_digest
  - patch_digest
  - verification_results
  - verification_command_count
  - verification_manifest_digest
  - required_verifications_passed
  - blocking_reasons
  - integration_decision
  - result_summary
  - raw_patch_payload_stored
  - raw_upstream_payload_stored
  - raw_worker_identity_payload_stored
  - raw_workspace_marker_payload_stored
  - raw_remote_metadata_payload_stored
  - raw_remote_revocation_payload_stored
  - raw_remote_revocation_freshness_payload_stored
  - raw_remote_revocation_timestamp_payload_stored
  - raw_remote_revocation_timestamp_replay_guard_payload_stored
  - raw_transcript_payload_stored
  - raw_verification_payload_stored
  - receipt_digest
  - receipt_ref
properties:
  kind:
    const: parallel_codex_worker_result_receipt
  schema_version:
    type: string
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  receipt_id:
    type: string
    pattern: "^parallel-codex-result-[a-f0-9]{12}$"
  generated_at:
    type: string
    format: date-time
  profile_id:
    const: parallel-codex-worker-result-ingestion-v1
  integration_policy_profile:
    const: main-checkout-worker-result-ingestion-v1
  reference_runbook_ref:
    const: references/parallel-codex-orchestration.md
  source_system:
    type: string
    enum:
      - direct-worker-result
      - yaoyorozu-worker-dispatch
      - remote-branch-pr-worker-result
  remote_metadata_profile:
    type: string
    enum:
      - remote-branch-pr-metadata-binding-v1
      - not-applicable
  remote_branch_ref:
    type: string
  remote_pr_ref:
    type: string
  remote_review_authority_profile:
    type: string
    enum:
      - integrity-guardian-remote-review-authority-v1
      - not-applicable
  remote_review_authority_ref:
    type: string
  remote_review_authority_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  accepted_source_policy_ref:
    type: string
  accepted_source_policy_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  remote_source_revocation_profile:
    type: string
    enum:
      - remote-source-system-revocation-check-v1
      - not-applicable
  remote_source_revocation_ref:
    type: string
  remote_source_revocation_status:
    type: string
    enum:
      - current-not-revoked
      - revoked
      - stale
      - not-applicable
  remote_source_revocation_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  remote_source_revocation_freshness_profile:
    type: string
    enum:
      - remote-source-revocation-freshness-window-v1
      - not-applicable
  remote_source_revocation_checked_at_ref:
    type: string
  remote_source_revocation_freshness_window_seconds:
    type: integer
    minimum: 0
    maximum: 900
  remote_source_revocation_expires_at_ref:
    type: string
  remote_source_revocation_freshness_status:
    type: string
    enum:
      - fresh
      - expired
      - not-applicable
  remote_source_revocation_freshness_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  remote_source_revocation_timestamp_profile:
    type: string
    enum:
      - remote-source-revocation-signed-provider-timestamp-v1
      - not-applicable
  remote_source_revocation_timestamp_ref:
    type: string
  remote_source_revocation_timestamp_status:
    type: string
    enum:
      - signed-current
      - stale
      - invalid
      - not-applicable
  remote_source_revocation_timestamp_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  remote_source_revocation_timestamp_signature_profile:
    type: string
    enum:
      - remote-source-revocation-provider-timestamp-signature-v1
      - not-applicable
  remote_source_revocation_timestamp_signature_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  remote_source_revocation_timestamp_replay_guard_profile:
    type: string
    enum:
      - remote-source-revocation-timestamp-replay-guard-v1
      - not-applicable
  remote_source_revocation_timestamp_nonce_ref:
    type: string
  remote_source_revocation_timestamp_previous_nonce_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  remote_source_revocation_timestamp_replay_status:
    type: string
    enum:
      - unique
      - replayed
      - not-applicable
  remote_source_revocation_timestamp_replay_guard_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  remote_metadata_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  remote_metadata_bound:
    type: boolean
  worker_identity_profile:
    const: signed-worker-identity-evidence-v1
  worker_identity_ref:
    type: string
    minLength: 1
  worker_identity_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  worker_identity_signature_profile:
    const: digest-bound-worker-identity-signature-v1
  worker_identity_signature_role:
    const: integrity-guardian
  worker_identity_signature_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  worker_identity_evidence_bound:
    type: boolean
  upstream_receipt_ref:
    type: string
  upstream_receipt_digest:
    type: string
    pattern: "^$|^[a-f0-9]{64}$"
  upstream_patch_candidate_receipt_refs:
    type: array
    uniqueItems: true
    items:
      type: string
      minLength: 1
  upstream_patch_candidate_receipt_digests:
    type: array
    uniqueItems: true
    items:
      type: string
      pattern: "^[a-f0-9]{64}$"
  upstream_binding_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  worker_id:
    type: string
    minLength: 1
  worker_role:
    type: string
    enum:
      - explorer
      - worker
      - codex-exec
      - external
  worker_result_status:
    type: string
    enum:
      - completed
      - blocked
      - failed
      - stale
  main_checkout_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  worker_base_commit:
    type: string
    pattern: "^[a-f0-9]{40}$"
  base_head_matches:
    type: boolean
  ownership_scope:
    type: array
    minItems: 1
    uniqueItems: true
    items:
      type: string
      minLength: 1
  changed_files:
    type: array
    minItems: 1
    uniqueItems: true
    items:
      type: string
      minLength: 1
  changed_file_count:
    type: integer
    minimum: 1
  changed_file_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  workspace_marker_hygiene_profile:
    const: workspace-enacted-marker-hygiene-v1
  workspace_marker_only_changed_files:
    type: array
    uniqueItems: true
    items:
      type: string
      minLength: 1
  workspace_marker_only_change_count:
    type: integer
    minimum: 0
  workspace_marker_hygiene_status:
    type: string
    enum:
      - clean
      - marker-only-reviewed
      - marker-only-blocked
  workspace_marker_hygiene_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  patch_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  verification_results:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/verification_result"
  verification_command_count:
    type: integer
    minimum: 1
  verification_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  required_verifications_passed:
    type: boolean
  blocking_reasons:
    type: array
    items:
      type: string
      minLength: 1
  integration_decision:
    type: string
    enum:
      - accept-ready
      - blocked
  result_summary:
    type: string
    minLength: 1
  raw_patch_payload_stored:
    const: false
  raw_upstream_payload_stored:
    const: false
  raw_worker_identity_payload_stored:
    const: false
  raw_workspace_marker_payload_stored:
    const: false
  raw_remote_metadata_payload_stored:
    const: false
  raw_remote_revocation_payload_stored:
    const: false
  raw_remote_revocation_freshness_payload_stored:
    const: false
  raw_remote_revocation_timestamp_payload_stored:
    const: false
  raw_remote_revocation_timestamp_replay_guard_payload_stored:
    const: false
  raw_transcript_payload_stored:
    const: false
  raw_verification_payload_stored:
    const: false
  receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  receipt_ref:
    type: string
    pattern: "^receipt://parallel-codex/parallel-codex-result-[a-f0-9]{12}$"
$defs:
  verification_result:
    type: object
    additionalProperties: false
    required:
      - command
      - status
      - exit_code
      - stdout_digest
      - stderr_digest
      - raw_stdout_stored
      - raw_stderr_stored
    properties:
      command:
        type: string
        minLength: 1
      status:
        type: string
        enum:
          - pass
          - fail
          - timeout
      exit_code:
        type: integer
      stdout_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      stderr_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      raw_stdout_stored:
        const: false
      raw_stderr_stored:
        const: false
