$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/neuro_integration_source_onboarding_catalog.schema"
title: NeuroIntegrationSourceOnboardingCatalog
description: >
  Digest-only catalog for onboarding current and future biological source types
  into the Neuro Integration Workbench without storing raw source payloads or
  claiming diagnosis, consciousness reproduction, identity replacement, or
  upload readiness.
type: object
additionalProperties: false
required:
  - schema_version
  - source_onboarding_catalog_ref
  - created_at
  - profile_id
  - catalog_policy
  - operator_ui_policy
  - source_types
  - source_type_count
  - source_families
  - source_family_count
  - onboarding_items
  - onboarding_item_count
  - onboarding_item_digests
  - onboarding_item_digest_set
  - operator_ui_cards
  - operator_ui_card_count
  - seed_source_types
  - expansion_source_types
  - open_biodata_source_types
  - future_biodata_source_types
  - future_source_type_count
  - required_replacement_lanes
  - seed_sources_cataloged
  - expansion_sources_cataloged
  - open_biodata_sources_cataloged
  - future_modalities_cataloged
  - all_items_bound
  - non_ml_operator_ready
  - coding_agent_ready
  - operator_ui_cards_bound
  - operator_ui_ready
  - source_onboarding_catalog_bound
  - storage_policy
  - claim_ceiling
  - conflict_refs
  - mind_upload_conflict_sink_url
  - raw_catalog_payload_stored
  - raw_source_payload_stored
  - raw_analysis_payload_stored
  - clinical_diagnosis_claimed
  - semantic_thought_content_generated
  - consciousness_reproduction_claimed
  - identity_replacement_claimed
  - upload_readiness_claimed
  - source_onboarding_catalog_digest
properties:
  schema_version:
    const: "1.0"
  source_onboarding_catalog_ref:
    type: string
    pattern: "^source-onboarding-catalog://neuro-integration/niw-source-onboarding-catalog-[a-f0-9]{12}$"
  created_at:
    type: string
    format: date-time
  profile_id:
    const: neuro-source-onboarding-catalog-v1
  catalog_policy:
    const: source-type-alias+family+lane-onboarding-only
  operator_ui_policy:
    const: operator-status-card+safe-next-action+disabled-claim-only
  source_types:
    type: array
    minItems: 23
    uniqueItems: true
    items:
      $ref: "#/$defs/source_type"
  source_type_count:
    type: integer
    minimum: 23
  source_families:
    type: object
    minProperties: 23
    additionalProperties:
      type: string
      minLength: 1
  source_family_count:
    type: integer
    minimum: 8
  onboarding_items:
    type: array
    minItems: 23
    items:
      $ref: "#/$defs/onboarding_item"
  onboarding_item_count:
    type: integer
    minimum: 23
  onboarding_item_digests:
    type: array
    minItems: 23
    items:
      $ref: "#/$defs/sha256"
  onboarding_item_digest_set:
    $ref: "#/$defs/sha256"
  operator_ui_cards:
    type: array
    minItems: 23
    items:
      $ref: "#/$defs/operator_ui_card"
  operator_ui_card_count:
    type: integer
    minimum: 23
  seed_source_types:
    const:
      - questionnaire
      - eeg
  expansion_source_types:
    const:
      - fmri_bold
      - brain_organoid
  open_biodata_source_types:
    const:
      - biosensor
      - behavioral_task
      - omics
      - clinical_metadata
  future_biodata_source_types:
    type: array
    minItems: 15
    uniqueItems: true
    items:
      enum:
        - meg
        - ecog
        - neural_spiking
        - fnirs
        - diffusion_mri
        - eye_tracking
        - speech_acoustics
        - gait_kinematics
        - microbiome
        - metabolomics
        - proteomics
        - digital_phenotyping
        - sleep_staging
        - electrophysiology_organoid
        - morphology_organoid
  future_source_type_count:
    const: 15
  required_replacement_lanes:
    type: array
    minItems: 5
    uniqueItems: true
    items:
      enum:
        - measurement
        - analysis
        - data-curation
        - operator-copilot
        - agent-automation
  seed_sources_cataloged:
    const: true
  expansion_sources_cataloged:
    const: true
  open_biodata_sources_cataloged:
    const: true
  future_modalities_cataloged:
    const: true
  all_items_bound:
    const: true
  non_ml_operator_ready:
    const: true
  coding_agent_ready:
    const: true
  operator_ui_cards_bound:
    const: true
  operator_ui_ready:
    const: true
  source_onboarding_catalog_bound:
    const: true
  storage_policy:
    const: source-type-digest+collection-method+lane-hint-only
  claim_ceiling:
    const: feature-alignment-and-analysis-plan-only
  conflict_refs:
    type: array
    minItems: 1
    items:
      type: object
  mind_upload_conflict_sink_url:
    const: https://mind-upload.com/frontiers/neurodata-integration
  raw_catalog_payload_stored:
    const: false
  raw_source_payload_stored:
    const: false
  raw_analysis_payload_stored:
    const: false
  clinical_diagnosis_claimed:
    const: false
  semantic_thought_content_generated:
    const: false
  consciousness_reproduction_claimed:
    const: false
  identity_replacement_claimed:
    const: false
  upload_readiness_claimed:
    const: false
  source_onboarding_catalog_digest:
    $ref: "#/$defs/sha256"
$defs:
  sha256:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_type:
    type: string
    pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
  onboarding_item:
    type: object
    additionalProperties: false
    required:
      - onboarding_item_ref
      - source_type
      - source_family
      - onboarding_status
      - aliases
      - collection_method_id
      - analysis_recipe_hint
      - required_replacement_lanes
      - operator_summary
      - coding_agent_task
      - operator_ui_card
      - operator_skill_floor
      - requires_ml_expertise
      - claim_ceiling
      - raw_catalog_payload_stored
      - raw_source_payload_stored
      - raw_analysis_payload_stored
      - clinical_diagnosis_claimed
      - semantic_thought_content_generated
      - consciousness_reproduction_claimed
      - identity_replacement_claimed
      - upload_readiness_claimed
      - onboarding_item_bound
      - onboarding_item_digest
    properties:
      onboarding_item_ref:
        type: string
        pattern: "^source-onboarding-item://neuro-integration/niw-source-onboarding-item-[a-f0-9]{12}$"
      source_type:
        $ref: "#/$defs/source_type"
      source_family:
        type: string
        minLength: 1
      onboarding_status:
        enum:
          - seed-required
          - already-bound
          - onboardable
          - research-frontier
      aliases:
        type: array
        uniqueItems: true
        items:
          type: string
          minLength: 1
      collection_method_id:
        type: string
        minLength: 1
      analysis_recipe_hint:
        type: string
        minLength: 1
      required_replacement_lanes:
        type: array
        minItems: 5
        uniqueItems: true
        items:
          enum:
            - measurement
            - analysis
            - data-curation
            - operator-copilot
            - agent-automation
      operator_summary:
        type: string
        minLength: 1
      coding_agent_task:
        type: string
        minLength: 1
      operator_ui_card:
        $ref: "#/$defs/operator_ui_card"
      operator_skill_floor:
        const: non_ml_operator
      requires_ml_expertise:
        const: false
      claim_ceiling:
        const: feature-alignment-and-analysis-plan-only
      raw_catalog_payload_stored:
        const: false
      raw_source_payload_stored:
        const: false
      raw_analysis_payload_stored:
        const: false
      clinical_diagnosis_claimed:
        const: false
      semantic_thought_content_generated:
        const: false
      consciousness_reproduction_claimed:
        const: false
      identity_replacement_claimed:
        const: false
      upload_readiness_claimed:
        const: false
      onboarding_item_bound:
        const: true
      onboarding_item_digest:
        $ref: "#/$defs/sha256"
  operator_ui_card:
    type: object
    additionalProperties: false
    required:
      - card_id
      - source_type
      - display_group
      - primary_label
      - secondary_label
      - status_badge
      - safe_next_action
      - operator_control
      - agent_control
      - risk_banner
      - disabled_claims
      - raw_payload_displayed
      - operator_ui_card_bound
    properties:
      card_id:
        type: string
        pattern: "^source-onboarding-ui-[a-z0-9][a-z0-9-]{0,80}$"
      source_type:
        $ref: "#/$defs/source_type"
      display_group:
        enum:
          - seed
          - current-expansion
          - current-open-biodata
          - future-onboarding
          - research-frontier
      primary_label:
        type: string
        minLength: 1
      secondary_label:
        type: string
        minLength: 1
      status_badge:
        enum:
          - Seed required
          - Current context
          - Future candidate
          - Research frontier
          - Review required
      safe_next_action:
        type: string
        minLength: 1
      operator_control:
        const: review-source-onboarding-card
      agent_control:
        type: string
        minLength: 1
      risk_banner:
        const: catalog-only-no-diagnosis-identity-or-upload-readiness
      disabled_claims:
        type: array
        minItems: 5
        uniqueItems: true
        items:
          enum:
            - clinical_diagnosis
            - semantic_thought_content
            - consciousness_reproduction
            - identity_replacement
            - upload_readiness
      raw_payload_displayed:
        const: false
      operator_ui_card_bound:
        const: true
