$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/parallel_codex_integration_execution_receipt.schema"
title: ParallelCodexIntegrationExecutionReceipt
description: >
  Digest-only receipt for reducing one integration-ready Parallel Codex batch
  into an ordered main-checkout apply plan plus post-apply verification
  evidence. The receipt binds the source batch receipt digest, current checkout
  head, ordered receipt set, per-step changed-file manifests, apply plan digest,
  required verification manifest, and raw batch / worker / patch / verification
  payload redaction before a commit is made from the main checkout.
type: object
additionalProperties: false
required:
  - kind
  - schema_version
  - receipt_id
  - generated_at
  - profile_id
  - integration_policy_profile
  - reference_runbook_ref
  - source_batch_receipt_ref
  - source_batch_receipt_digest
  - source_batch_receipt_digest_bound
  - source_batch_decision
  - source_batch_ready_for_execution
  - main_checkout_head
  - current_checkout_head
  - current_head_matches_batch
  - ordered_integration_receipt_refs
  - ordered_integration_receipt_digests
  - ordered_integration_digest
  - changed_file_owner_manifest_digest
  - quarantined_receipt_set_digest
  - conflict_digest
  - apply_plan_profile
  - apply_steps
  - apply_step_count
  - apply_plan_digest
  - post_apply_verification_profile
  - post_apply_verification_results
  - post_apply_verification_command_count
  - post_apply_verification_manifest_digest
  - required_verifications_passed
  - blocking_reasons
  - execution_decision
  - result_summary
  - raw_batch_payload_stored
  - raw_apply_plan_payload_stored
  - raw_worker_receipt_payload_stored
  - raw_verification_payload_stored
  - receipt_digest
  - receipt_ref
properties:
  kind:
    const: parallel_codex_integration_execution_receipt
  schema_version:
    type: string
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  receipt_id:
    type: string
    pattern: "^parallel-codex-execution-[a-f0-9]{12}$"
  generated_at:
    type: string
    format: date-time
  profile_id:
    const: parallel-codex-integration-execution-plan-v1
  integration_policy_profile:
    const: main-checkout-worker-result-ingestion-v1
  reference_runbook_ref:
    const: references/parallel-codex-orchestration.md
  source_batch_receipt_ref:
    type: string
    pattern: "^receipt://parallel-codex/parallel-codex-batch-[a-f0-9]{12}$"
  source_batch_receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_batch_receipt_digest_bound:
    type: boolean
  source_batch_decision:
    type: string
    enum:
      - integration-ready
      - blocked
  source_batch_ready_for_execution:
    type: boolean
  main_checkout_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  current_checkout_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  current_head_matches_batch:
    type: boolean
  ordered_integration_receipt_refs:
    type: array
    minItems: 1
    items:
      type: string
      minLength: 1
  ordered_integration_receipt_digests:
    type: array
    minItems: 1
    items:
      type: string
      pattern: "^[a-f0-9]{64}$"
  ordered_integration_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  changed_file_owner_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  quarantined_receipt_set_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  conflict_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  apply_plan_profile:
    const: ordered-receipt-apply-plan-digest-v1
  apply_steps:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/apply_step"
  apply_step_count:
    type: integer
    minimum: 1
  apply_plan_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  post_apply_verification_profile:
    const: post-apply-required-verification-v1
  post_apply_verification_results:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/verification_result"
  post_apply_verification_command_count:
    type: integer
    minimum: 1
  post_apply_verification_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  required_verifications_passed:
    type: boolean
  blocking_reasons:
    type: array
    items:
      type: string
      minLength: 1
  execution_decision:
    type: string
    enum:
      - ready-to-apply
      - blocked
  result_summary:
    type: string
    minLength: 1
  raw_batch_payload_stored:
    const: false
  raw_apply_plan_payload_stored:
    const: false
  raw_worker_receipt_payload_stored:
    const: false
  raw_verification_payload_stored:
    const: false
  receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  receipt_ref:
    type: string
    pattern: "^receipt://parallel-codex/parallel-codex-execution-[a-f0-9]{12}$"
$defs:
  apply_step:
    type: object
    additionalProperties: false
    required:
      - step_index
      - receipt_ref
      - receipt_digest
      - changed_files
      - changed_file_count
      - changed_file_manifest_digest
      - raw_patch_payload_stored
      - apply_step_digest
    properties:
      step_index:
        type: integer
        minimum: 1
      receipt_ref:
        type: string
        minLength: 1
      receipt_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      changed_files:
        type: array
        items:
          type: string
          minLength: 1
      changed_file_count:
        type: integer
        minimum: 0
      changed_file_manifest_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      raw_patch_payload_stored:
        const: false
      apply_step_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
  verification_result:
    type: object
    additionalProperties: false
    required:
      - command
      - status
      - exit_code
      - stdout_digest
      - stderr_digest
      - raw_stdout_stored
      - raw_stderr_stored
    properties:
      command:
        type: string
        minLength: 1
      status:
        type: string
        enum:
          - pass
          - fail
      exit_code:
        type: integer
      stdout_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      stderr_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      raw_stdout_stored:
        const: false
      raw_stderr_stored:
        const: false
