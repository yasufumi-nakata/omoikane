$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/parallel_codex_integration_execution_receipt.schema"
title: ParallelCodexIntegrationExecutionReceipt
description: >
  Digest-only receipt for reducing one integration-ready Parallel Codex batch
  into an ordered main-checkout apply plan plus post-apply verification
  evidence. The receipt binds the source batch receipt digest, current checkout
  head, ordered receipt set, per-step changed-file manifests, apply plan digest,
  repo-local patch artifact path / digest bindings,
  command-bound git-apply-check pre-apply dry-run receipts, required
  verification manifest, post-apply verification context binding to the apply
  plan / patch artifact manifest / pre-apply dry-run manifest, digest-only
  checkout mutation attestation, commit finalization gate digest, and raw batch /
  worker / patch / dry-run / verification / checkout mutation / patch cleanup /
  finalization payload redaction before a commit is accepted from the main
  checkout.
type: object
additionalProperties: false
required:
  - kind
  - schema_version
  - receipt_id
  - generated_at
  - profile_id
  - integration_policy_profile
  - reference_runbook_ref
  - source_batch_receipt_ref
  - source_batch_receipt_digest
  - source_batch_receipt_digest_bound
  - source_batch_decision
  - source_batch_ready_for_execution
  - main_checkout_head
  - current_checkout_head
  - current_head_matches_batch
  - ordered_integration_receipt_refs
  - ordered_integration_receipt_digests
  - ordered_integration_digest
  - changed_file_owner_manifest_digest
  - quarantined_receipt_set_digest
  - conflict_digest
  - apply_plan_profile
  - apply_steps
  - apply_step_count
  - apply_plan_digest
  - patch_artifact_binding_profile
  - patch_artifact_manifest_digest
  - repo_local_patch_artifact_count
  - repo_local_patch_artifacts_bound
  - patch_artifact_cleanup_profile
  - patch_artifact_cleanup_status
  - patch_artifact_cleanup_ref
  - patch_artifact_cleanup_digest
  - patch_artifact_cleanup_artifact_paths
  - patch_artifact_cleanup_artifact_count
  - patch_artifact_cleanup_artifact_paths_bound
  - patch_artifact_cleanup_artifact_count_bound
  - patch_artifact_cleanup_manifest_digest_bound
  - patch_artifact_cleanup_pre_apply_dry_run_manifest_digest_bound
  - patch_artifact_cleanup_checkout_mutation_event_digest_bound
  - patch_artifact_cleanup_post_apply_head_bound
  - patch_artifact_cleanup_verified
  - pre_apply_dry_run_profile
  - pre_apply_dry_run_results
  - pre_apply_dry_run_result_count
  - pre_apply_dry_run_manifest_digest
  - pre_apply_dry_run_passed
  - post_apply_verification_profile
  - post_apply_verification_context_profile
  - post_apply_verification_results
  - post_apply_verification_command_count
  - post_apply_verification_manifest_digest
  - post_apply_verification_apply_plan_digest_bound
  - post_apply_verification_patch_artifact_manifest_digest_bound
  - post_apply_verification_pre_apply_manifest_digest_bound
  - post_apply_verification_context_digest
  - post_apply_verification_context_bound
  - checkout_mutation_attestation_profile
  - checkout_mutation_event_profile
  - checkout_mutation_source
  - checkout_mutation_status
  - checkout_mutation_event_ref
  - checkout_mutation_event_digest
  - checkout_mutation_pre_apply_head
  - checkout_mutation_post_apply_head
  - checkout_mutation_head_advanced
  - checkout_mutation_apply_plan_digest_bound
  - checkout_mutation_patch_artifact_manifest_digest_bound
  - checkout_mutation_pre_apply_dry_run_manifest_digest_bound
  - checkout_mutation_post_apply_verification_context_digest_bound
  - checkout_mutation_changed_file_owner_manifest_digest_bound
  - checkout_mutation_attested
  - commit_finalization_profile
  - commit_finalization_status
  - commit_finalization_ref
  - commit_finalization_digest
  - commit_finalization_source_batch_digest_bound
  - commit_finalization_apply_plan_digest_bound
  - commit_finalization_patch_artifact_manifest_digest_bound
  - commit_finalization_pre_apply_dry_run_manifest_digest_bound
  - commit_finalization_post_apply_verification_context_digest_bound
  - commit_finalization_checkout_mutation_event_digest_bound
  - commit_finalization_patch_artifact_cleanup_digest_bound
  - commit_finalization_changed_file_owner_manifest_digest_bound
  - commit_finalization_required_verifications_bound
  - commit_finalization_ready
  - required_verifications_passed
  - blocking_reasons
  - execution_decision
  - result_summary
  - raw_batch_payload_stored
  - raw_apply_plan_payload_stored
  - raw_pre_apply_dry_run_payload_stored
  - raw_checkout_mutation_payload_stored
  - raw_patch_artifact_cleanup_payload_stored
  - raw_commit_finalization_payload_stored
  - raw_worker_receipt_payload_stored
  - raw_verification_payload_stored
  - receipt_digest
  - receipt_ref
properties:
  kind:
    const: parallel_codex_integration_execution_receipt
  schema_version:
    type: string
    pattern: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  receipt_id:
    type: string
    pattern: "^parallel-codex-execution-[a-f0-9]{12}$"
  generated_at:
    type: string
    format: date-time
  profile_id:
    const: parallel-codex-integration-execution-plan-v1
  integration_policy_profile:
    const: main-checkout-worker-result-ingestion-v1
  reference_runbook_ref:
    const: references/parallel-codex-orchestration.md
  source_batch_receipt_ref:
    type: string
    pattern: "^receipt://parallel-codex/parallel-codex-batch-[a-f0-9]{12}$"
  source_batch_receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  source_batch_receipt_digest_bound:
    type: boolean
  source_batch_decision:
    type: string
    enum:
      - integration-ready
      - blocked
  source_batch_ready_for_execution:
    type: boolean
  main_checkout_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  current_checkout_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  current_head_matches_batch:
    type: boolean
  ordered_integration_receipt_refs:
    type: array
    minItems: 1
    items:
      type: string
      minLength: 1
  ordered_integration_receipt_digests:
    type: array
    minItems: 1
    items:
      type: string
      pattern: "^[a-f0-9]{64}$"
  ordered_integration_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  changed_file_owner_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  quarantined_receipt_set_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  conflict_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  apply_plan_profile:
    const: ordered-receipt-apply-plan-digest-v1
  apply_steps:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/apply_step"
  apply_step_count:
    type: integer
    minimum: 1
  apply_plan_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  patch_artifact_binding_profile:
    const: repo-local-patch-artifact-binding-v1
  patch_artifact_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  repo_local_patch_artifact_count:
    type: integer
    minimum: 1
  repo_local_patch_artifacts_bound:
    type: boolean
  patch_artifact_cleanup_profile:
    const: repo-local-patch-artifact-cleanup-v1
  patch_artifact_cleanup_status:
    type: string
    enum:
      - removed
      - retained
  patch_artifact_cleanup_ref:
    type: string
    pattern: "^cleanup://parallel-codex/[a-f0-9]{12}$"
  patch_artifact_cleanup_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  patch_artifact_cleanup_artifact_paths:
    type: array
    minItems: 1
    items:
      type: string
      pattern: "^artifacts/parallel-codex/[a-f0-9]{12}\\.patch$"
  patch_artifact_cleanup_artifact_count:
    type: integer
    minimum: 1
  patch_artifact_cleanup_artifact_paths_bound:
    type: boolean
  patch_artifact_cleanup_artifact_count_bound:
    type: boolean
  patch_artifact_cleanup_manifest_digest_bound:
    type: boolean
  patch_artifact_cleanup_pre_apply_dry_run_manifest_digest_bound:
    type: boolean
  patch_artifact_cleanup_checkout_mutation_event_digest_bound:
    type: boolean
  patch_artifact_cleanup_post_apply_head_bound:
    type: boolean
  patch_artifact_cleanup_verified:
    type: boolean
  pre_apply_dry_run_profile:
    const: pre-apply-dry-run-check-v1
  pre_apply_dry_run_results:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/pre_apply_dry_run_result"
  pre_apply_dry_run_result_count:
    type: integer
    minimum: 1
  pre_apply_dry_run_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  pre_apply_dry_run_passed:
    type: boolean
  post_apply_verification_profile:
    const: post-apply-required-verification-v1
  post_apply_verification_context_profile:
    const: post-apply-verification-apply-context-binding-v1
  post_apply_verification_results:
    type: array
    minItems: 1
    items:
      $ref: "#/$defs/verification_result"
  post_apply_verification_command_count:
    type: integer
    minimum: 1
  post_apply_verification_manifest_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  post_apply_verification_apply_plan_digest_bound:
    type: boolean
  post_apply_verification_patch_artifact_manifest_digest_bound:
    type: boolean
  post_apply_verification_pre_apply_manifest_digest_bound:
    type: boolean
  post_apply_verification_context_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  post_apply_verification_context_bound:
    type: boolean
  checkout_mutation_attestation_profile:
    const: main-checkout-mutation-attestation-v1
  checkout_mutation_event_profile:
    const: digest-bound-checkout-mutation-event-v1
  checkout_mutation_source:
    type: string
    minLength: 1
  checkout_mutation_status:
    type: string
    enum:
      - attested
      - unattested
      - mismatch
  checkout_mutation_event_ref:
    type: string
    pattern: "^checkout-mutation://parallel-codex/[a-f0-9]{12}$"
  checkout_mutation_event_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  checkout_mutation_pre_apply_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  checkout_mutation_post_apply_head:
    type: string
    pattern: "^[a-f0-9]{40}$"
  checkout_mutation_head_advanced:
    type: boolean
  checkout_mutation_apply_plan_digest_bound:
    type: boolean
  checkout_mutation_patch_artifact_manifest_digest_bound:
    type: boolean
  checkout_mutation_pre_apply_dry_run_manifest_digest_bound:
    type: boolean
  checkout_mutation_post_apply_verification_context_digest_bound:
    type: boolean
  checkout_mutation_changed_file_owner_manifest_digest_bound:
    type: boolean
  checkout_mutation_attested:
    type: boolean
  commit_finalization_profile:
    const: main-checkout-commit-finalization-gate-v1
  commit_finalization_status:
    type: string
    enum:
      - ready
      - blocked
  commit_finalization_ref:
    type: string
    pattern: "^commit-finalization://parallel-codex/[a-f0-9]{12}$"
  commit_finalization_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  commit_finalization_source_batch_digest_bound:
    type: boolean
  commit_finalization_apply_plan_digest_bound:
    type: boolean
  commit_finalization_patch_artifact_manifest_digest_bound:
    type: boolean
  commit_finalization_pre_apply_dry_run_manifest_digest_bound:
    type: boolean
  commit_finalization_post_apply_verification_context_digest_bound:
    type: boolean
  commit_finalization_checkout_mutation_event_digest_bound:
    type: boolean
  commit_finalization_patch_artifact_cleanup_digest_bound:
    type: boolean
  commit_finalization_changed_file_owner_manifest_digest_bound:
    type: boolean
  commit_finalization_required_verifications_bound:
    type: boolean
  commit_finalization_ready:
    type: boolean
  required_verifications_passed:
    type: boolean
  blocking_reasons:
    type: array
    items:
      type: string
      minLength: 1
  execution_decision:
    type: string
    enum:
      - ready-to-apply
      - blocked
  result_summary:
    type: string
    minLength: 1
  raw_batch_payload_stored:
    const: false
  raw_apply_plan_payload_stored:
    const: false
  raw_pre_apply_dry_run_payload_stored:
    const: false
  raw_checkout_mutation_payload_stored:
    const: false
  raw_patch_artifact_cleanup_payload_stored:
    const: false
  raw_commit_finalization_payload_stored:
    const: false
  raw_worker_receipt_payload_stored:
    const: false
  raw_verification_payload_stored:
    const: false
  receipt_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
  receipt_ref:
    type: string
    pattern: "^receipt://parallel-codex/parallel-codex-execution-[a-f0-9]{12}$"
$defs:
  apply_step:
    type: object
    additionalProperties: false
    required:
      - step_index
      - receipt_ref
      - receipt_digest
      - changed_files
      - changed_file_count
      - changed_file_manifest_digest
      - patch_artifact_profile
      - patch_artifact_source
      - patch_artifact_ref
      - patch_artifact_path
      - patch_artifact_command_target
      - patch_artifact_digest
      - raw_patch_payload_stored
      - apply_step_digest
    properties:
      step_index:
        type: integer
        minimum: 1
      receipt_ref:
        type: string
        minLength: 1
      receipt_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      changed_files:
        type: array
        items:
          type: string
          minLength: 1
      changed_file_count:
        type: integer
        minimum: 0
      changed_file_manifest_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      patch_artifact_profile:
        const: repo-local-patch-artifact-binding-v1
      patch_artifact_source:
        const: repo-local-patch-file
      patch_artifact_ref:
        type: string
        pattern: "^patch://parallel-codex/[a-f0-9]{12}$"
      patch_artifact_path:
        type: string
        pattern: "^artifacts/parallel-codex/[a-f0-9]{12}\\.patch$"
      patch_artifact_command_target:
        type: string
        pattern: "^artifacts/parallel-codex/[a-f0-9]{12}\\.patch$"
      patch_artifact_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      raw_patch_payload_stored:
        const: false
      apply_step_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
  pre_apply_dry_run_result:
    type: object
    additionalProperties: false
    required:
      - step_index
      - receipt_ref
      - receipt_digest
      - command_profile
      - patch_artifact_profile
      - patch_artifact_source
      - patch_artifact_ref
      - patch_artifact_path
      - patch_artifact_command_target
      - patch_artifact_digest
      - patch_artifact_digest_bound
      - command
      - status
      - exit_code
      - stdout_digest
      - stderr_digest
      - command_receipt_digest
      - raw_patch_payload_stored
      - raw_stdout_stored
      - raw_stderr_stored
    properties:
      step_index:
        type: integer
        minimum: 1
      receipt_ref:
        type: string
        minLength: 1
      receipt_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      command_profile:
        const: command-bound-git-apply-check-v1
      patch_artifact_profile:
        const: repo-local-patch-artifact-binding-v1
      patch_artifact_source:
        const: repo-local-patch-file
      patch_artifact_ref:
        type: string
        pattern: "^patch://parallel-codex/[a-f0-9]{12}$"
      patch_artifact_path:
        type: string
        pattern: "^artifacts/parallel-codex/[a-f0-9]{12}\\.patch$"
      patch_artifact_command_target:
        type: string
        pattern: "^artifacts/parallel-codex/[a-f0-9]{12}\\.patch$"
      patch_artifact_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      patch_artifact_digest_bound:
        type: boolean
      command:
        type: string
        pattern: "^git apply --check artifacts/parallel-codex/[a-f0-9]{12}\\.patch$"
      status:
        type: string
        enum:
          - pass
          - fail
      exit_code:
        type: integer
      stdout_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      stderr_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      command_receipt_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      raw_patch_payload_stored:
        const: false
      raw_stdout_stored:
        const: false
      raw_stderr_stored:
        const: false
  verification_result:
    type: object
    additionalProperties: false
    required:
      - command
      - status
      - exit_code
      - stdout_digest
      - stderr_digest
      - raw_stdout_stored
      - raw_stderr_stored
    properties:
      command:
        type: string
        minLength: 1
      status:
        type: string
        enum:
          - pass
          - fail
      exit_code:
        type: integer
      stdout_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      stderr_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      raw_stdout_stored:
        const: false
      raw_stderr_stored:
        const: false
