$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://omoikane.dev/specs/schemas/neuro_integration_source_bundle.schema"
title: NeuroIntegrationSourceBundle
description: >
  Digest-only source bundle that binds questionnaire and EEG feature summaries
  first, then attaches fMRI, brain organoid, and future biological source
  summaries without storing raw payloads.
type: object
additionalProperties: false
required:
  - schema_version
  - source_bundle_ref
  - created_at
  - profile_id
  - identity_id
  - source_count
  - source_types
  - source_families
  - sources
  - source_digest_set
  - seed_sources_required
  - seed_survey_eeg_bound
  - expansion_source_types_present
  - expansion_modalities_bound
  - storage_policy
  - conflict_refs
  - mind_upload_conflict_sink_url
  - raw_source_payload_stored
  - raw_questionnaire_payload_stored
  - raw_eeg_payload_stored
  - raw_neuroimaging_payload_stored
  - raw_organoid_payload_stored
  - consciousness_reproduction_claimed
  - identity_replacement_claimed
  - source_bundle_digest
properties:
  schema_version:
    const: "1.0"
  source_bundle_ref:
    type: string
    pattern: "^source-bundle://neuro-integration/niw-source-bundle-[a-f0-9]{12}$"
  created_at:
    type: string
    format: date-time
  profile_id:
    const: neuro-cross-modal-source-bundle-v1
  identity_id:
    type: string
    minLength: 1
  source_count:
    type: integer
    minimum: 2
  source_types:
    type: array
    minItems: 2
    uniqueItems: true
    items:
      $ref: "#/$defs/source_type"
  source_families:
    type: object
    minProperties: 2
    additionalProperties:
      type: string
      minLength: 1
  sources:
    type: array
    minItems: 2
    items:
      $ref: "#/$defs/source_manifest"
  source_digest_set:
    type: string
    pattern: "^[a-f0-9]{64}$"
  seed_sources_required:
    const:
      - questionnaire
      - eeg
  seed_survey_eeg_bound:
    const: true
  expansion_source_types_present:
    type: array
    minItems: 1
    uniqueItems: true
    items:
      enum:
        - fmri_bold
        - brain_organoid
  expansion_modalities_bound:
    const: true
  storage_policy:
    const: feature-digest+analysis-axis-summary-only
  conflict_refs:
    type: array
    minItems: 1
    items:
      type: object
  mind_upload_conflict_sink_url:
    const: https://mind-upload.com/frontiers/neurodata-integration
  raw_source_payload_stored:
    const: false
  raw_questionnaire_payload_stored:
    const: false
  raw_eeg_payload_stored:
    const: false
  raw_neuroimaging_payload_stored:
    const: false
  raw_organoid_payload_stored:
    const: false
  consciousness_reproduction_claimed:
    const: false
  identity_replacement_claimed:
    const: false
  source_bundle_digest:
    type: string
    pattern: "^[a-f0-9]{64}$"
$defs:
  source_type:
    type: string
    pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
  source_manifest:
    type: object
    additionalProperties: false
    required:
      - source_type
      - source_family
      - source_ref
      - app_ref
      - participant_ref
      - consent_ref
      - license_ref
      - feature_summary_ref
      - feature_digest
      - feature_name_digest
      - numeric_feature_count
      - string_feature_count
      - analysis_axes
      - construct_coverage
      - storage_policy
      - raw_payload_stored
    properties:
      source_type:
        $ref: "#/$defs/source_type"
      source_family:
        type: string
        minLength: 1
      source_ref:
        type: string
        minLength: 1
      app_ref:
        type: string
        minLength: 1
      participant_ref:
        type: string
        minLength: 1
      consent_ref:
        type: string
        minLength: 1
      license_ref:
        type: string
        minLength: 1
      feature_summary_ref:
        type: string
        minLength: 1
      feature_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      feature_name_digest:
        type: string
        pattern: "^[a-f0-9]{64}$"
      numeric_feature_count:
        type: integer
        minimum: 0
      string_feature_count:
        type: integer
        minimum: 0
      analysis_axes:
        type: object
        minProperties: 1
        additionalProperties:
          type: number
      construct_coverage:
        type: array
        minItems: 1
        uniqueItems: true
        items:
          type: string
          minLength: 1
      storage_policy:
        const: feature-digest+analysis-axis-summary-only
      raw_payload_stored:
        const: false
