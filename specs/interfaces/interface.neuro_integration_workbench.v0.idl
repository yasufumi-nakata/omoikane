idl_version: 1
kind: service
namespace: interface.neuro_integration_workbench.v0
service: NeuroIntegrationWorkbenchService
summary: >
  Canonical L6 contract for an LLM-native multi-application workbench that
  starts with questionnaire plus EEG feature integration and can attach fMRI,
  brain organoid, biosensor, behavioral, omics, clinical metadata, and future
  biological data sources without claiming diagnosis, consciousness
  reproduction, or identity replacement.
imports:
  biodata_survey_eeg_fusion_receipt: ../schemas/biodata_survey_eeg_fusion_receipt.schema
  neuro_integration_app_registry_receipt: ../schemas/neuro_integration_app_registry_receipt.schema
  neuro_integration_source_bundle: ../schemas/neuro_integration_source_bundle.schema
  neuro_integration_workspace: ../schemas/neuro_integration_workspace.schema
  neuro_integration_analysis_receipt: ../schemas/neuro_integration_analysis_receipt.schema
  neuro_integration_operator_guide: ../schemas/neuro_integration_operator_guide.schema
  neuro_integration_application_replacement_plan: ../schemas/neuro_integration_application_replacement_plan.schema
  neuro_integration_application_connector_bundle: ../schemas/neuro_integration_application_connector_bundle.schema
  neuro_integration_collection_protocol: ../schemas/neuro_integration_collection_protocol.schema
  neuro_integration_collection_run: ../schemas/neuro_integration_collection_run.schema
  neuro_integration_measurement_quality_gate: ../schemas/neuro_integration_measurement_quality_gate.schema
  neuro_integration_cross_modal_analysis_plan: ../schemas/neuro_integration_cross_modal_analysis_plan.schema
  neuro_integration_cross_modal_analysis_run: ../schemas/neuro_integration_cross_modal_analysis_run.schema
  neuro_integration_interpretation_synthesis: ../schemas/neuro_integration_interpretation_synthesis.schema
operations:
  register_application:
    summary: Register one measurement, analysis, curation, operator-copilot, or agent-automation app as a replaceable workbench lane.
    input:
      inline_schema:
        type: object
        required:
          - app_name
          - app_kind
          - supported_source_types
          - workflow_roles
        properties:
          app_name:
            type: string
            minLength: 1
          app_kind:
            enum: [measurement, analysis, data-curation, visualization, operator-copilot, agent-automation]
          supported_source_types:
            type: array
            minItems: 1
            uniqueItems: true
            items:
              type: string
              pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
          workflow_roles:
            type: array
            minItems: 1
            uniqueItems: true
            items:
              enum: [measurement, analysis, data-curation, operator-copilot, agent-automation]
          operator_skill_floor:
            enum: [non_ml_operator, coding_agent, analyst, researcher]
          llm_native:
            type: boolean
    output:
      schema_ref: neuro_integration_app_registry_receipt
    guarantees:
      - application replacement lanes must be digest-bound by app_digest
      - measurement, analysis, data-curation, operator-copilot, and agent-automation lanes must be representable
      - non-ML operators and coding agents must both have explicit operator-skill floor metadata
      - raw application and credential payload storage must remain false
  bind_source_bundle:
    summary: Bind questionnaire, EEG, fMRI, organoid, biosensor, behavioral, omics, clinical metadata, and future biological feature summaries into one digest-only source bundle.
    input:
      inline_schema:
        type: object
        required:
          - identity_id
          - source_manifests
        properties:
          identity_id:
            type: string
            minLength: 1
          source_manifests:
            type: array
            minItems: 2
            items:
              type: object
              required:
                - source_type
                - source_ref
                - app_ref
                - participant_ref
                - consent_ref
                - license_ref
                - feature_summary_ref
                - feature_summary
          upstream_receipts:
            type: array
            items:
              schema_ref: biodata_survey_eeg_fusion_receipt
    output:
      schema_ref: neuro_integration_source_bundle
    guarantees:
      - questionnaire and EEG must be present before the seed analysis can pass
      - BioData survey+EEG fusion receipts must be carried as digest-only upstream bindings
      - fMRI and brain organoid sources must be expansion context, not identity proof
      - biosensor, behavioral task, omics, clinical metadata, and future biological sources must remain feature-summary context
      - every source must bind consent, license, app, participant, and feature digest refs
      - raw questionnaire, EEG, neuroimaging, organoid, and source payload storage must remain false
      - consciousness reproduction and identity replacement claims must remain false
  open_workspace:
    summary: Open one LLM-native workspace tying application receipts, source bundle, operator profile, and replacement lanes.
    input:
      inline_schema:
        type: object
        required:
          - identity_id
          - app_receipts
          - source_bundle
          - analysis_goal
          - operator_profile
        properties:
          identity_id:
            type: string
            minLength: 1
          app_receipts:
            type: array
            minItems: 1
            items:
              schema_ref: neuro_integration_app_registry_receipt
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          analysis_goal:
            type: string
            minLength: 1
          operator_profile:
            type: object
    output:
      schema_ref: neuro_integration_workspace
    guarantees:
      - workspace_digest must bind app digests, source bundle digest, operator profile, and claim ceiling
      - all replacement lanes must be covered before the workbench can claim multi-application replacement readiness
      - LLM-native workflow and beginner operator support must be explicit
      - raw app, source, and analysis payload storage must remain false
  build_survey_eeg_fusion:
    summary: Derive bounded questionnaire-plus-EEG feature alignment axes while carrying fMRI and organoid expansion lanes.
    input:
      inline_schema:
        type: object
        required:
          - workspace
          - source_bundle
        properties:
          workspace:
            schema_ref: neuro_integration_workspace
          source_bundle:
            schema_ref: neuro_integration_source_bundle
    output:
      schema_ref: neuro_integration_analysis_receipt
    guarantees:
      - seed_pair_digest must bind questionnaire and EEG feature digests
      - derived axes must remain feature-alignment and analysis-plan proxies
      - fMRI and organoid lanes must stay expansion context with the same claim ceiling
      - clinical diagnosis, consciousness reproduction, and identity replacement claims must remain false
  build_operator_guide:
    summary: Emit plain-language cards and coding-agent task templates for non-ML operators and LLM-native automation.
    input:
      inline_schema:
        type: object
        required:
          - workspace
          - analysis
        properties:
          workspace:
            schema_ref: neuro_integration_workspace
          analysis:
            schema_ref: neuro_integration_analysis_receipt
    output:
      schema_ref: neuro_integration_operator_guide
    guarantees:
      - plain-language cards must explain safe actions without requiring ML expertise
      - coding-agent templates must stay schema-bound and digest-only
      - guide_digest must bind cards, templates, workspace digest, analysis digest, and claim ceiling
      - raw instruction and analysis payload storage must remain false
  build_application_replacement_plan:
    summary: Emit a digest-only plan proving each bound source type is covered by measurement, analysis, curation, operator-copilot, and agent-automation lanes.
    input:
      inline_schema:
        type: object
        required:
          - app_receipts
          - source_bundle
          - workspace
          - operator_guide
        properties:
          app_receipts:
            type: array
            minItems: 1
            items:
              schema_ref: neuro_integration_app_registry_receipt
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          workspace:
            schema_ref: neuro_integration_workspace
          operator_guide:
            schema_ref: neuro_integration_operator_guide
    output:
      schema_ref: neuro_integration_application_replacement_plan
    guarantees:
      - every source type in the current source bundle must be covered by all required replacement lanes
      - the plan must bind app digests, source bundle digest, workspace digest, and operator guide digest
      - non-ML operator and coding-agent handoffs must be explicit and require no ML expertise
      - raw application, source, and operator payload storage must remain false
  bind_application_connector_bundle:
    summary: Bind external application connector refs, credential refs, data-contract refs, and LLM tool refs to a replacement plan without storing raw connector payloads.
    input:
      inline_schema:
        type: object
        required:
          - app_receipts
          - replacement_plan
          - connector_manifests
        properties:
          app_receipts:
            type: array
            minItems: 1
            items:
              schema_ref: neuro_integration_app_registry_receipt
          replacement_plan:
            schema_ref: neuro_integration_application_replacement_plan
          connector_manifests:
            type: array
            minItems: 1
            items:
              type: object
              required:
                - app_ref
                - connector_kind
                - protocol
                - endpoint_ref
                - credential_ref
                - permission_ref
                - data_contract_ref
                - llm_tool_ref
                - operator_label
                - supported_source_types
              properties:
                app_ref:
                  type: string
                  minLength: 1
                connector_kind:
                  enum: [measurement-ingest, analysis-runner, curation-ledger, operator-console, agent-runner, visualization-viewer]
                protocol:
                  enum: [local-file, https-api, database-view, notebook-runner, llm-tool, message-queue]
                endpoint_ref:
                  type: string
                  minLength: 1
                credential_ref:
                  type: string
                  minLength: 1
                permission_ref:
                  type: string
                  minLength: 1
                data_contract_ref:
                  type: string
                  minLength: 1
                llm_tool_ref:
                  type: string
                  minLength: 1
                operator_label:
                  type: string
                  minLength: 1
                supported_source_types:
                  type: array
                  minItems: 1
                  uniqueItems: true
                  items:
                    type: string
                    pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
                dry_run_supported:
                  type: boolean
    output:
      schema_ref: neuro_integration_application_connector_bundle
    guarantees:
      - every app in the replacement plan must have at least one connector receipt
      - every source type must be covered by connector refs across all required replacement lanes
      - connector receipts must bind endpoint refs, credential refs, permission refs, data contract refs, and LLM tool refs by digest only
      - operator-safe dry-run paths must be explicit for non-ML operators and coding agents
      - raw connector, credential, and endpoint payload storage must remain false
  build_collection_protocol:
    summary: Bind each biological source summary to consent refs, measurement connector refs, and collection-window refs before analysis planning.
    input:
      inline_schema:
        type: object
        required:
          - source_bundle
          - replacement_plan
          - connector_bundle
        properties:
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          replacement_plan:
            schema_ref: neuro_integration_application_replacement_plan
          connector_bundle:
            schema_ref: neuro_integration_application_connector_bundle
    output:
      schema_ref: neuro_integration_collection_protocol
    guarantees:
      - every source in the source bundle must have one digest-bound collection step
      - questionnaire and EEG collection must be bound before downstream analysis claims pass
      - fMRI, brain organoid, biosensor, behavioral task, omics, clinical metadata, and future biological sources must bind measurement connectors as expansion collection context
      - non-ML operator and coding-agent collection handoffs must require no ML expertise
      - raw source, collection, connector, and credential payload storage must remain false
      - semantic thought content, diagnosis, consciousness reproduction, and identity replacement claims must remain false
  execute_collection_protocol:
    summary: Execute a collection protocol into bounded per-source collection result summaries for operator and coding-agent review.
    input:
      inline_schema:
        type: object
        required:
          - source_bundle
          - connector_bundle
          - collection_protocol
        properties:
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          connector_bundle:
            schema_ref: neuro_integration_application_connector_bundle
          collection_protocol:
            schema_ref: neuro_integration_collection_protocol
    output:
      schema_ref: neuro_integration_collection_run
    guarantees:
      - every collection protocol step must produce one bounded collection result summary
      - questionnaire and EEG collection results must be present before downstream analysis claims pass
      - result summaries must bind collection step digests, feature digests, connector refs, and collection-window refs
      - operator and coding-agent review readiness must be explicit and require no ML expertise
      - raw source, collection, connector, and result payload storage must remain false
      - semantic thought content, diagnosis, consciousness reproduction, and identity replacement claims must remain false
  bind_measurement_quality_gate:
    summary: Bind collection run results to calibration, artifact/QC, consent freshness, operator review, and quality authority refs before analysis planning.
    input:
      inline_schema:
        type: object
        required:
          - source_bundle
          - collection_run
          - quality_manifests
        properties:
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          collection_run:
            schema_ref: neuro_integration_collection_run
          quality_manifests:
            type: array
            minItems: 1
            items:
              type: object
              required:
                - source_type
                - calibration_ref
                - artifact_qc_ref
                - consent_freshness_ref
                - operator_review_ref
                - quality_authority_ref
              properties:
                source_type:
                  type: string
                  pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
                calibration_ref:
                  type: string
                  minLength: 1
                artifact_qc_ref:
                  type: string
                  minLength: 1
                consent_freshness_ref:
                  type: string
                  minLength: 1
                operator_review_ref:
                  type: string
                  minLength: 1
                quality_authority_ref:
                  type: string
                  minLength: 1
                calibration_score:
                  type: number
                  minimum: 0
                  maximum: 1
                artifact_acceptance_score:
                  type: number
                  minimum: 0
                  maximum: 1
                consent_freshness_score:
                  type: number
                  minimum: 0
                  maximum: 1
                sampling_completeness_score:
                  type: number
                  minimum: 0
                  maximum: 1
    output:
      schema_ref: neuro_integration_measurement_quality_gate
    guarantees:
      - every source in the collection run must have one bounded measurement quality item
      - questionnaire and EEG quality gates must be bound before downstream analysis claims pass
      - calibration, artifact/QC, consent freshness, operator review, and quality authority refs must be digest-only
      - operator and coding-agent review readiness must remain explicit and require no ML expertise
      - raw source, quality, calibration, artifact, and consent payload storage must remain false
      - diagnosis, consciousness reproduction, and identity replacement claims must remain false
  build_cross_modal_analysis_plan:
    summary: Emit a digest-only plan for every current source-type pair so questionnaire, EEG, fMRI, organoid, biosensor, behavioral, omics, clinical metadata, and future biological summaries can be analyzed through bounded recipes.
    input:
      inline_schema:
        type: object
        required:
          - source_bundle
          - analysis
          - operator_guide
          - replacement_plan
          - connector_bundle
        properties:
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          analysis:
            schema_ref: neuro_integration_analysis_receipt
          operator_guide:
            schema_ref: neuro_integration_operator_guide
          replacement_plan:
            schema_ref: neuro_integration_application_replacement_plan
          connector_bundle:
            schema_ref: neuro_integration_application_connector_bundle
    output:
      schema_ref: neuro_integration_cross_modal_analysis_plan
    guarantees:
      - every current source-type pair must have a bounded analysis recipe
      - the questionnaire plus EEG pair must reuse the seed Survey EEG Fusion analysis receipt
      - each analysis pair must bind measurement, analysis, curation, operator-copilot, and agent-automation connector refs
      - non-ML operator and coding-agent execution must require no ML expertise
      - raw source, analysis, connector, and plan payload storage must remain false
      - diagnosis, consciousness reproduction, and identity replacement claims must remain false
  execute_cross_modal_analysis_plan:
    summary: Emit bounded digest-only result summaries for every pair in a cross-modal analysis plan.
    input:
      inline_schema:
        type: object
        required:
          - source_bundle
          - connector_bundle
          - cross_modal_analysis_plan
        properties:
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          connector_bundle:
            schema_ref: neuro_integration_application_connector_bundle
          cross_modal_analysis_plan:
            schema_ref: neuro_integration_cross_modal_analysis_plan
    output:
      schema_ref: neuro_integration_cross_modal_analysis_run
    guarantees:
      - every planned source-type pair must produce one bounded result summary
      - result summaries must bind pair digests and connector evidence refs
      - operator and coding-agent review readiness must be explicit
      - raw source, analysis, connector, and result payload storage must remain false
      - diagnosis, consciousness reproduction, and identity replacement claims must remain false
  synthesize_operator_interpretation:
    summary: Bind measurement quality and cross-modal analysis results into plain-language cards and coding-agent tasks for non-ML review.
    input:
      inline_schema:
        type: object
        required:
          - source_bundle
          - operator_guide
          - measurement_quality_gate
          - cross_modal_analysis_run
        properties:
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          operator_guide:
            schema_ref: neuro_integration_operator_guide
          measurement_quality_gate:
            schema_ref: neuro_integration_measurement_quality_gate
          cross_modal_analysis_run:
            schema_ref: neuro_integration_cross_modal_analysis_run
    output:
      schema_ref: neuro_integration_interpretation_synthesis
    guarantees:
      - every cross-modal analysis result must produce one plain-language synthesis card
      - each synthesis card must bind measurement quality item digests before operator action
      - questionnaire plus EEG seed interpretation must remain explicit before expansion context
      - non-ML operator next actions and coding-agent tasks must require no ML expertise
      - raw source, analysis, quality, interpretation, and agent-task payload storage must remain false
      - diagnosis, consciousness reproduction, identity replacement, and upload-readiness claims must remain false
  validate_integration_bundle:
    summary: Verify app, source, workspace, analysis, operator-guide, optional replacement-plan, optional connector-bundle, optional collection-protocol, optional collection-run, optional measurement-quality-gate, optional cross-modal analysis-plan, optional cross-modal analysis-run, and optional interpretation-synthesis digest binding and claim ceilings.
    input:
      inline_schema:
        type: object
        required:
          - app_receipts
          - source_bundle
          - workspace
          - analysis
          - operator_guide
        properties:
          app_receipts:
            type: array
            minItems: 1
            items:
              schema_ref: neuro_integration_app_registry_receipt
          source_bundle:
            schema_ref: neuro_integration_source_bundle
          workspace:
            schema_ref: neuro_integration_workspace
          analysis:
            schema_ref: neuro_integration_analysis_receipt
          operator_guide:
            schema_ref: neuro_integration_operator_guide
          replacement_plan:
            schema_ref: neuro_integration_application_replacement_plan
          connector_bundle:
            schema_ref: neuro_integration_application_connector_bundle
          collection_protocol:
            schema_ref: neuro_integration_collection_protocol
          collection_run:
            schema_ref: neuro_integration_collection_run
          measurement_quality_gate:
            schema_ref: neuro_integration_measurement_quality_gate
          cross_modal_analysis_plan:
            schema_ref: neuro_integration_cross_modal_analysis_plan
          cross_modal_analysis_run:
            schema_ref: neuro_integration_cross_modal_analysis_run
          interpretation_synthesis:
            schema_ref: neuro_integration_interpretation_synthesis
    output:
      inline_schema:
        type: object
        required:
          - ok
          - seed_survey_eeg_bound
          - replacement_lanes_bound
          - llm_native_workflow_bound
          - beginner_operator_supported
          - coding_agent_ready
          - application_replacement_plan_bound
          - application_connector_bundle_bound
          - source_type_lane_coverage_bound
          - connector_source_type_coverage_bound
          - collection_protocol_bound
          - collection_protocol_digest_bound
          - source_collection_coverage_bound
          - seed_collection_bound
          - collection_payload_redacted
          - collection_semantic_thought_claim_redacted
          - collection_run_bound
          - collection_run_digest_bound
          - collection_results_bound
          - collection_result_payload_redacted
          - collection_result_semantic_thought_claim_redacted
          - measurement_quality_gate_bound
          - measurement_quality_gate_digest_bound
          - measurement_quality_items_bound
          - measurement_quality_payload_redacted
          - survey_eeg_fusion_receipt_bound
          - upstream_receipt_payload_redacted
          - connector_bundle_digest_bound
          - connector_payload_redacted
          - cross_modal_analysis_plan_bound
          - cross_modal_analysis_plan_digest_bound
          - cross_modal_source_pair_coverage_bound
          - cross_modal_analysis_payload_redacted
          - cross_modal_analysis_run_bound
          - cross_modal_analysis_run_digest_bound
          - cross_modal_pair_results_bound
          - cross_modal_result_payload_redacted
          - interpretation_synthesis_bound
          - interpretation_synthesis_digest_bound
          - interpretation_synthesis_cards_bound
          - interpretation_operator_action_ready
          - interpretation_payload_redacted
          - claim_ceiling_bound
          - raw_payload_redacted
          - no_diagnosis_or_identity_claim
          - no_semantic_thought_content_claim
        properties:
          ok:
            type: boolean
          seed_survey_eeg_bound:
            type: boolean
          replacement_lanes_bound:
            type: boolean
          llm_native_workflow_bound:
            type: boolean
          beginner_operator_supported:
            type: boolean
          coding_agent_ready:
            type: boolean
          application_replacement_plan_bound:
            type: boolean
          application_connector_bundle_bound:
            type: boolean
          source_type_lane_coverage_bound:
            type: boolean
          connector_source_type_coverage_bound:
            type: boolean
          collection_protocol_bound:
            type: boolean
          collection_protocol_digest_bound:
            type: boolean
          source_collection_coverage_bound:
            type: boolean
          seed_collection_bound:
            type: boolean
          collection_payload_redacted:
            type: boolean
          collection_semantic_thought_claim_redacted:
            type: boolean
          collection_run_bound:
            type: boolean
          collection_run_digest_bound:
            type: boolean
          collection_results_bound:
            type: boolean
          collection_result_payload_redacted:
            type: boolean
          collection_result_semantic_thought_claim_redacted:
            type: boolean
          measurement_quality_gate_bound:
            type: boolean
          measurement_quality_gate_digest_bound:
            type: boolean
          measurement_quality_items_bound:
            type: boolean
          measurement_quality_payload_redacted:
            type: boolean
          survey_eeg_fusion_receipt_bound:
            type: boolean
          upstream_receipt_payload_redacted:
            type: boolean
          connector_bundle_digest_bound:
            type: boolean
          connector_payload_redacted:
            type: boolean
          cross_modal_analysis_plan_bound:
            type: boolean
          cross_modal_analysis_plan_digest_bound:
            type: boolean
          cross_modal_source_pair_coverage_bound:
            type: boolean
          cross_modal_analysis_payload_redacted:
            type: boolean
          cross_modal_analysis_run_bound:
            type: boolean
          cross_modal_analysis_run_digest_bound:
            type: boolean
          cross_modal_pair_results_bound:
            type: boolean
          cross_modal_result_payload_redacted:
            type: boolean
          interpretation_synthesis_bound:
            type: boolean
          interpretation_synthesis_digest_bound:
            type: boolean
          interpretation_synthesis_cards_bound:
            type: boolean
          interpretation_operator_action_ready:
            type: boolean
          interpretation_payload_redacted:
            type: boolean
          claim_ceiling_bound:
            type: boolean
          raw_payload_redacted:
            type: boolean
          no_diagnosis_or_identity_claim:
            type: boolean
          no_semantic_thought_content_claim:
            type: boolean
          connector_count:
            type: integer
            minimum: 0
          collection_step_count:
            type: integer
            minimum: 0
          collection_result_count:
            type: integer
            minimum: 0
          measurement_quality_item_count:
            type: integer
            minimum: 0
          analysis_pair_count:
            type: integer
            minimum: 0
          analysis_result_count:
            type: integer
            minimum: 0
          interpretation_card_count:
            type: integer
            minimum: 0
events:
  - name: neuro_integration_workbench.source_bundle.bound
    payload_schema: neuro_integration_source_bundle
  - name: neuro_integration_workbench.survey_eeg_fusion.bound
    payload_schema: neuro_integration_analysis_receipt
  - name: neuro_integration_workbench.application_replacement_plan.bound
    payload_schema: neuro_integration_application_replacement_plan
  - name: neuro_integration_workbench.application_connector_bundle.bound
    payload_schema: neuro_integration_application_connector_bundle
  - name: neuro_integration_workbench.collection_protocol.bound
    payload_schema: neuro_integration_collection_protocol
  - name: neuro_integration_workbench.collection_run.bound
    payload_schema: neuro_integration_collection_run
  - name: neuro_integration_workbench.measurement_quality_gate.bound
    payload_schema: neuro_integration_measurement_quality_gate
  - name: neuro_integration_workbench.cross_modal_analysis_plan.bound
    payload_schema: neuro_integration_cross_modal_analysis_plan
  - name: neuro_integration_workbench.cross_modal_analysis_run.bound
    payload_schema: neuro_integration_cross_modal_analysis_run
  - name: neuro_integration_workbench.interpretation_synthesis.bound
    payload_schema: neuro_integration_interpretation_synthesis
