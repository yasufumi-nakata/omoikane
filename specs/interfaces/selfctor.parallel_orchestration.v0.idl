idl_version: 1
kind: service
namespace: selfctor.parallel_orchestration.v0
service: ParallelCodexOrchestrationService
summary: Bind parallel Codex, remote branch / PR, and Yaoyorozu worker-dispatch results to digest-only receipts with signed worker identity, repo-local workspace marker diff or structured patch-segment classification, source metadata, remote source revocation evidence, signed provider timestamp evidence, timestamp replay guards, remote source content identity, remote source main-head ancestry, batch-level changed-file conflict arbitration, quarantined blocked receipt set digests, ordered apply plan digests, repo-local patch artifact bindings, command-bound git apply dry-run manifests, context-bound post-apply verification manifests, checkout mutation attestations, patch artifact cleanup receipts, commit finalization gates, and post-commit origin/main publication with pre-push remote freshness, protected-branch provider policy receipts, and status-check suite freshness before GitHub handoff.
imports:
  parallel_codex_worker_result_receipt: ../schemas/parallel_codex_worker_result_receipt.schema
  parallel_codex_integration_batch_receipt: ../schemas/parallel_codex_integration_batch_receipt.schema
  parallel_codex_integration_execution_receipt: ../schemas/parallel_codex_integration_execution_receipt.schema
  parallel_codex_post_commit_publication_receipt: ../schemas/parallel_codex_post_commit_publication_receipt.schema
operations:
  ingest_worker_result:
    summary: Normalize one worker result, changed-file list, patch digest, and verification command set into a main-checkout ingestion receipt.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - worker_id
          - worker_role
          - worker_result_status
          - main_checkout_head
          - worker_base_commit
          - ownership_scope
          - changed_files
          - verification_results
          - result_summary
        properties:
          worker_id:
            type: string
            minLength: 1
          worker_role:
            type: string
            enum: [explorer, worker, codex-exec, external]
          worker_result_status:
            type: string
            enum: [completed, blocked, failed, stale]
          source_system:
            type: string
            enum:
              - direct-worker-result
              - yaoyorozu-worker-dispatch
              - remote-branch-pr-worker-result
          worker_identity_ref:
            type: string
            minLength: 1
          worker_identity_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          worker_identity_signature_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          main_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          worker_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          ownership_scope:
            type: array
            minItems: 1
            items:
              type: string
              minLength: 1
          changed_files:
            type: array
            minItems: 1
            items:
              type: string
              minLength: 1
          workspace_marker_only_changed_files:
            type: array
            items:
              type: string
              minLength: 1
          workspace_diff_by_file:
            type: object
            additionalProperties:
              type: string
          workspace_patch_segments_by_file:
            type: object
            additionalProperties:
              type: array
              items:
                type: object
                additionalProperties: false
                required:
                  - operation
                  - line_count
                  - contains_workspace_marker
                properties:
                  operation:
                    type: string
                    enum: [add, remove, modify, context]
                  line_count:
                    type: integer
                    minimum: 0
                  contains_workspace_marker:
                    type: boolean
                  content_digest:
                    type: string
                    pattern: "^[a-f0-9]{64}$"
          verification_results:
            type: array
            minItems: 1
          result_summary:
            type: string
            minLength: 1
          patch_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_branch_ref:
            type: string
            minLength: 1
          remote_pr_ref:
            type: string
            minLength: 1
          remote_review_authority_ref:
            type: string
            minLength: 1
          remote_review_authority_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          accepted_source_policy_ref:
            type: string
            minLength: 1
          accepted_source_policy_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_ref:
            type: string
            minLength: 1
          remote_source_revocation_status:
            type: string
            enum: [current-not-revoked, revoked, stale, not-applicable]
          remote_source_revocation_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_checked_at_ref:
            type: string
            minLength: 1
          remote_source_revocation_freshness_window_seconds:
            type: integer
            minimum: 1
            maximum: 900
          remote_source_revocation_expires_at_ref:
            type: string
            minLength: 1
          remote_source_revocation_freshness_status:
            type: string
            enum: [fresh, expired, not-applicable]
          remote_source_revocation_freshness_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_ref:
            type: string
            minLength: 1
          remote_source_revocation_timestamp_status:
            type: string
            enum: [signed-current, stale, invalid, not-applicable]
          remote_source_revocation_timestamp_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_signature_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_nonce_ref:
            type: string
            minLength: 1
          remote_source_revocation_timestamp_previous_nonce_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_replay_status:
            type: string
            enum: [unique, replayed, not-applicable]
          remote_source_revocation_timestamp_replay_guard_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_content_ref:
            type: string
            minLength: 1
          remote_source_content_status:
            type: string
            enum: [bound, mismatch, not-applicable]
          remote_source_head_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_source_tree_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_diff_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_content_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_source_merge_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_source_ancestry_status:
            type: string
            enum: [ancestor-bound, unrelated, not-applicable]
          remote_source_ancestry_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_metadata_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
    output:
      schema_ref: parallel_codex_worker_result_receipt
    guarantees:
      - worker_base_commit must match main_checkout_head before integration_decision can become accept-ready
      - direct worker results carry source_system=direct-worker-result and no upstream dispatch refs
      - remote branch / PR worker results carry source_system=remote-branch-pr-worker-result plus branch ref, PR ref, review authority digest, accepted source policy digest, current-not-revoked source revocation digest, signed provider timestamp digest, replay-unique timestamp nonce evidence, remote source content identity digest, remote source main-head ancestry digest, and remote_metadata_digest
      - worker_identity_ref, worker_identity_digest, and integrity-guardian worker_identity_signature_digest are bound to patch digest and base/head commit evidence
      - workspace-enacted marker-only changed files are classified from repo-local diff summaries or structured patch-segment manifests, counted, and digest-bound, and receipts whose only payload is marker comments remain blocked
      - remote metadata, remote source revocation status, revocation freshness window, signed provider timestamp evidence, timestamp replay guard, remote source content identity, and remote source ancestry are digest-bound and redacted before remote results can become accept-ready
      - changed_files must remain inside both the repo-local allowed workspace prefixes and the worker ownership_scope
      - patch payload, raw worker identity payload, raw workspace marker diff or segment payload, raw remote metadata payload, raw remote revocation payload, raw remote content payload, raw remote ancestry payload, raw remote timestamp replay payload, raw worker transcript, raw stdout, and raw stderr are never stored; only digest fields, line counts, segment counts, and classifier status remain
      - unittest discover and gap-report required verification commands must pass before main checkout integration is accepted
      - blocked, stale, or failed worker results remain schema-bound but cannot be integrated
  ingest_yaoyorozu_dispatch_receipt:
    summary: Reduce one Yaoyorozu worker-dispatch receipt and its patch-candidate receipts into a Parallel Codex main-checkout ingestion receipt.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - dispatch_receipt
          - main_checkout_head
          - worker_base_commit
          - verification_results
        properties:
          dispatch_receipt:
            type: object
            minProperties: 1
          main_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          worker_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          verification_results:
            type: array
            minItems: 1
          result_summary:
            type: string
          ownership_scope:
            type: array
            items:
              type: string
              minLength: 1
    output:
      schema_ref: parallel_codex_worker_result_receipt
    guarantees:
      - source_system is yaoyorozu-worker-dispatch
      - the derived worker identity evidence binds the Yaoyorozu dispatch receipt id to the same patch digest used for main-checkout ingestion
      - upstream dispatch receipt digest, patch-candidate receipt refs/digests, and changed-file list are bound by upstream_binding_digest
      - patch_digest is derived from the dispatch receipt digest, dispatch plan digest, patch-candidate receipt digests, and changed files
      - raw Yaoyorozu dispatch payloads, raw patch payloads, remote metadata payloads, remote revocation payloads, transcripts, stdout, and stderr are not stored in the Parallel Codex receipt
      - main checkout integration remains blocked unless the worker base commit is fresh and the required verification commands pass
  plan_integration_batch:
    summary: Reduce multiple Parallel Codex worker-result receipts into one deterministic integration batch receipt with conflict arbitration.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - receipts
          - main_checkout_head
          - verification_results
          - result_summary
        properties:
          receipts:
            type: array
            minItems: 1
            items:
              schema_ref: parallel_codex_worker_result_receipt
          main_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          verification_results:
            type: array
            minItems: 1
          result_summary:
            type: string
            minLength: 1
    output:
      schema_ref: parallel_codex_integration_batch_receipt
    guarantees:
      - only validated accept-ready worker receipts with matching main_checkout_head enter ordered integration
      - blocked, failed, stale, marker-only, stale-head, and otherwise invalid receipts are quarantined with receipt refs and digests only
      - the quarantined blocked receipt set is reduced to blocked-receipt-quarantine-manifest-v1 and quarantined_receipt_set_digest so raw blocked worker receipts never need to be stored
      - accepted receipts are ordered deterministically by receipt digest and receipt ref before integration
      - changed file owners are reduced to a digest-bound owner manifest before any checkout mutation
      - any changed-file overlap between accepted receipts makes the batch schema-bound but blocked
      - required unittest and gap-report verification commands must pass for the batch to become integration-ready
      - raw worker receipt payloads, raw conflict payloads, raw stdout, and raw stderr are never stored
  plan_integration_execution:
    summary: Reduce one integration-ready batch receipt into an ordered main-checkout apply plan, repo-local patch artifact binding, command-bound git apply dry-run receipt set, post-apply verification receipt bound to the apply context, digest-only checkout mutation attestation, patch artifact cleanup receipt, and a commit finalization gate.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - batch_receipt
          - current_checkout_head
          - post_apply_verification_results
          - result_summary
        properties:
          batch_receipt:
            schema_ref: parallel_codex_integration_batch_receipt
          current_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          pre_apply_dry_run_results:
            type: array
            minItems: 1
          post_apply_verification_results:
            type: array
            minItems: 1
          checkout_mutation_attestation:
            type: object
            additionalProperties: true
          patch_artifact_cleanup_receipt:
            type: object
            additionalProperties: true
          result_summary:
            type: string
            minLength: 1
    output:
      schema_ref: parallel_codex_integration_execution_receipt
    guarantees:
      - source batch receipt digest must validate before execution_decision can become ready-to-apply
      - current checkout head must still match the batch main checkout head before apply
      - ordered integration receipt refs/digests are carried forward from the batch and reduced to ordered apply steps
      - each apply step binds receipt ref, receipt digest, changed-file manifest digest, repo-local patch artifact path, and apply_step_digest without raw patch payload storage
      - apply_plan_digest and patch_artifact_manifest_digest bind the ordered step digest set, per-step patch artifact refs, and `artifacts/parallel-codex/*.patch` paths before a main checkout commit
      - pre_apply_dry_run_manifest_digest binds one command-bound `git apply --check artifacts/parallel-codex/*.patch` receipt per apply step, including patch_artifact_ref, patch_artifact_path, patch_artifact_digest, and command_receipt_digest; any failed or unbound dry-run keeps execution_decision blocked before checkout mutation
      - post-apply unittest and gap-report verification commands must pass and are stored only as digests
      - post-apply verification must bind the apply plan digest, repo-local patch artifact manifest digest, pre-apply dry-run manifest digest, source batch digest, and current checkout head into post-apply-verification-apply-context-binding-v1 before ready-to-apply
      - checkout mutation attestation must bind pre-apply head, post-apply head, apply plan digest, patch artifact manifest digest, pre-apply dry-run manifest digest, post-apply verification context digest, and changed-file owner manifest digest before commit
      - patch artifact cleanup must bind the ordered `artifacts/parallel-codex/*.patch` paths, patch artifact manifest digest, pre-apply dry-run manifest digest, checkout mutation event digest, and post-apply head; retained artifacts keep execution_decision blocked before commit
      - commit finalization gate must bind source batch digest, current checkout head, apply plan digest, patch artifact manifest digest, pre-apply dry-run manifest digest, post-apply verification context digest, checkout mutation event digest, post-apply head, patch artifact cleanup digest, changed-file owner manifest digest, and passing verification state before commit
      - conflict, worker receipt, batch, patch, dry-run stdout/stderr, verification stdout/stderr, checkout mutation event payload, patch cleanup payload, commit finalization payload, and other raw payloads are never stored
  plan_post_commit_publication:
    summary: Bind a commit-finalized integration execution receipt to a pre-push `git ls-remote origin refs/heads/main` freshness receipt, command-level `git push origin HEAD:refs/heads/main` receipt, post-push `git ls-remote origin refs/heads/main` remote-head verification receipt, ls-remote head/ref output bindings, digest-only protected-branch provider policy receipt with freshness / signed timestamp / replay guard, post-push status/check suite evidence, and status/check suite freshness before GitHub handoff.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - execution_receipt
          - local_commit_head
          - remote_head
          - result_summary
        properties:
          execution_receipt:
            schema_ref: parallel_codex_integration_execution_receipt
          local_commit_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          pre_push_remote_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_name:
            const: origin
          remote_ref:
            const: refs/heads/main
          pre_push_remote_verification_result:
            type: object
            additionalProperties: true
          push_result:
            type: object
            additionalProperties: true
          remote_verification_result:
            type: object
            additionalProperties: true
          protected_branch_provider:
            const: github
          protected_branch_policy_ref:
            type: string
            minLength: 1
          protected_branch_policy_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          protected_branch_status:
            enum: [protected, unprotected, unknown]
          protected_branch_required_checks:
            type: array
            minItems: 1
            items:
              type: string
              minLength: 1
          protected_branch_policy_checked_at_ref:
            type: string
            minLength: 1
          protected_branch_policy_freshness_window_seconds:
            type: integer
            minimum: 1
            maximum: 900
          protected_branch_policy_freshness_status:
            enum: [fresh, expired, unknown]
          protected_branch_provider_timestamp_ref:
            type: string
            minLength: 1
          protected_branch_provider_timestamp_status:
            enum: [signed-current, stale, invalid]
          protected_branch_provider_timestamp_signature_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          protected_branch_provider_timestamp_nonce_ref:
            type: string
            minLength: 1
          protected_branch_provider_timestamp_replay_status:
            enum: [unique, replayed]
          protected_branch_receipt_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          status_check_provider:
            const: github
          status_check_suite_ref:
            type: string
            minLength: 1
          status_check_commit_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          status_check_results:
            type: array
            minItems: 1
            items:
              type: object
              additionalProperties: true
          status_check_suite_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          status_check_suite_checked_at_ref:
            type: string
            minLength: 1
          status_check_suite_freshness_window_seconds:
            type: integer
            minimum: 1
            maximum: 900
          status_check_suite_freshness_status:
            enum: [fresh, expired, unknown]
          status_check_suite_freshness_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          result_summary:
            type: string
            minLength: 1
    output:
      schema_ref: parallel_codex_post_commit_publication_receipt
    guarantees:
      - source execution receipt digest must be bound and validation-ready before publication_status can become published
      - source commit finalization must be ready before a push result can be treated as GitHub handoff evidence
      - pre-push origin/main head must match the source execution current checkout head before a push result can be treated as GitHub handoff evidence
      - local commit head must match the source execution post-apply head and remote head must match that local commit
      - push command is fixed to `git push origin HEAD:refs/heads/main` and both pre-push and post-push remote verification commands are fixed to `git ls-remote origin refs/heads/main`
      - pre-push remote verification output must bind the source execution current checkout head and `refs/heads/main` ref to the command stdout digest before GitHub handoff
      - post-push remote verification output must bind the published commit head and `refs/heads/main` ref to the command stdout digest before GitHub handoff
      - protected branch provider evidence must show github refs/heads/main as protected, fresh within 900 seconds, signed-current by the provider timestamp, replay-guard unique, and must bind the required reference verification checks before ready_for_github_handoff can become true
      - post-push status/check suite evidence must cover the protected branch required checks, bind each check-run digest to the published commit head, show completed/success, and carry a fresh <=900s suite snapshot digest before ready_for_github_handoff can become true
      - pre-push verification, push, and post-push verification stdout/stderr plus provider branch-protection / freshness / timestamp / replay-guard / status-check / status-check freshness payloads are stored only as digests, and publication_digest binds source execution, local head, pre-push remote head, published remote head, command receipts, remote verification output digests, protected branch receipt, status-check suite digest, and status-check freshness digest
  validate_post_commit_publication_receipt:
    summary: Recompute post-commit publication command digests, pre-push/post-push ls-remote output binding digests, protected branch policy/freshness/timestamp/replay digests, post-push status/check suite digest, status/check suite freshness digest, publication digest, receipt digest, and blocking reasons.
    input:
      schema_ref: parallel_codex_post_commit_publication_receipt
    output:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - ok
          - ready_for_github_handoff
          - errors
        properties:
          ok:
            type: boolean
          ready_for_github_handoff:
            type: boolean
          errors:
            type: array
            items:
              type: string
  validate_worker_result_receipt:
    summary: Recompute the changed-file manifest digest, verification manifest digest, receipt digest, and blocking reasons for a worker result receipt.
    input:
      schema_ref: parallel_codex_worker_result_receipt
    output:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - ok
          - ready_for_main_checkout
          - errors
        properties:
          ok:
            type: boolean
          ready_for_main_checkout:
            type: boolean
          errors:
            type: array
            items:
              type: string
  validate_integration_batch_receipt:
    summary: Recompute batch receipt set, ordered integration, quarantined receipt set, changed-file owner, conflict, verification, and receipt digests.
    input:
      schema_ref: parallel_codex_integration_batch_receipt
    output:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - ok
          - ready_for_integration
          - errors
        properties:
          ok:
            type: boolean
          ready_for_integration:
            type: boolean
          errors:
            type: array
            items:
              type: string
  validate_integration_execution_receipt:
    summary: Recompute execution apply-plan digest, checkout mutation attestation digest, patch artifact cleanup digest, commit finalization digest, post-apply verification manifest digest, receipt digest, and blocking reasons.
    input:
      schema_ref: parallel_codex_integration_execution_receipt
    output:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - ok
          - ready_to_apply
          - errors
        properties:
          ok:
            type: boolean
          ready_to_apply:
            type: boolean
          errors:
            type: array
            items:
              type: string
events:
  selfctor.parallel_orchestration.worker_result_ingested:
    payload:
      schema_ref: parallel_codex_worker_result_receipt
  selfctor.parallel_orchestration.integration_batch_planned:
    payload:
      schema_ref: parallel_codex_integration_batch_receipt
  selfctor.parallel_orchestration.integration_execution_planned:
    payload:
      schema_ref: parallel_codex_integration_execution_receipt
  selfctor.parallel_orchestration.post_commit_publication_planned:
    payload:
      schema_ref: parallel_codex_post_commit_publication_receipt
