idl_version: 1
kind: service
namespace: selfctor.parallel_orchestration.v0
service: ParallelCodexOrchestrationService
summary: Bind parallel Codex, remote branch / PR, and Yaoyorozu worker-dispatch results to digest-only receipts with signed worker identity, repo-local workspace marker diff or structured patch-segment classification, source metadata, remote source revocation evidence, signed provider timestamp evidence, timestamp replay guards, remote source content identity, remote source main-head ancestry, batch-level changed-file conflict arbitration, quarantined blocked receipt set digests, ordered apply plan digests, pre-apply dry-run manifests, and post-apply verification manifests before main checkout integration.
imports:
  parallel_codex_worker_result_receipt: ../schemas/parallel_codex_worker_result_receipt.schema
  parallel_codex_integration_batch_receipt: ../schemas/parallel_codex_integration_batch_receipt.schema
  parallel_codex_integration_execution_receipt: ../schemas/parallel_codex_integration_execution_receipt.schema
operations:
  ingest_worker_result:
    summary: Normalize one worker result, changed-file list, patch digest, and verification command set into a main-checkout ingestion receipt.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - worker_id
          - worker_role
          - worker_result_status
          - main_checkout_head
          - worker_base_commit
          - ownership_scope
          - changed_files
          - verification_results
          - result_summary
        properties:
          worker_id:
            type: string
            minLength: 1
          worker_role:
            type: string
            enum: [explorer, worker, codex-exec, external]
          worker_result_status:
            type: string
            enum: [completed, blocked, failed, stale]
          source_system:
            type: string
            enum:
              - direct-worker-result
              - yaoyorozu-worker-dispatch
              - remote-branch-pr-worker-result
          worker_identity_ref:
            type: string
            minLength: 1
          worker_identity_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          worker_identity_signature_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          main_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          worker_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          ownership_scope:
            type: array
            minItems: 1
            items:
              type: string
              minLength: 1
          changed_files:
            type: array
            minItems: 1
            items:
              type: string
              minLength: 1
          workspace_marker_only_changed_files:
            type: array
            items:
              type: string
              minLength: 1
          workspace_diff_by_file:
            type: object
            additionalProperties:
              type: string
          workspace_patch_segments_by_file:
            type: object
            additionalProperties:
              type: array
              items:
                type: object
                additionalProperties: false
                required:
                  - operation
                  - line_count
                  - contains_workspace_marker
                properties:
                  operation:
                    type: string
                    enum: [add, remove, modify, context]
                  line_count:
                    type: integer
                    minimum: 0
                  contains_workspace_marker:
                    type: boolean
                  content_digest:
                    type: string
                    pattern: "^[a-f0-9]{64}$"
          verification_results:
            type: array
            minItems: 1
          result_summary:
            type: string
            minLength: 1
          patch_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_branch_ref:
            type: string
            minLength: 1
          remote_pr_ref:
            type: string
            minLength: 1
          remote_review_authority_ref:
            type: string
            minLength: 1
          remote_review_authority_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          accepted_source_policy_ref:
            type: string
            minLength: 1
          accepted_source_policy_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_ref:
            type: string
            minLength: 1
          remote_source_revocation_status:
            type: string
            enum: [current-not-revoked, revoked, stale, not-applicable]
          remote_source_revocation_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_checked_at_ref:
            type: string
            minLength: 1
          remote_source_revocation_freshness_window_seconds:
            type: integer
            minimum: 1
            maximum: 900
          remote_source_revocation_expires_at_ref:
            type: string
            minLength: 1
          remote_source_revocation_freshness_status:
            type: string
            enum: [fresh, expired, not-applicable]
          remote_source_revocation_freshness_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_ref:
            type: string
            minLength: 1
          remote_source_revocation_timestamp_status:
            type: string
            enum: [signed-current, stale, invalid, not-applicable]
          remote_source_revocation_timestamp_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_signature_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_nonce_ref:
            type: string
            minLength: 1
          remote_source_revocation_timestamp_previous_nonce_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_revocation_timestamp_replay_status:
            type: string
            enum: [unique, replayed, not-applicable]
          remote_source_revocation_timestamp_replay_guard_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_content_ref:
            type: string
            minLength: 1
          remote_source_content_status:
            type: string
            enum: [bound, mismatch, not-applicable]
          remote_source_head_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_source_tree_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_diff_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_content_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_source_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_source_merge_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          remote_source_ancestry_status:
            type: string
            enum: [ancestor-bound, unrelated, not-applicable]
          remote_source_ancestry_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
          remote_metadata_digest:
            type: string
            pattern: "^[a-f0-9]{64}$"
    output:
      schema_ref: parallel_codex_worker_result_receipt
    guarantees:
      - worker_base_commit must match main_checkout_head before integration_decision can become accept-ready
      - direct worker results carry source_system=direct-worker-result and no upstream dispatch refs
      - remote branch / PR worker results carry source_system=remote-branch-pr-worker-result plus branch ref, PR ref, review authority digest, accepted source policy digest, current-not-revoked source revocation digest, signed provider timestamp digest, replay-unique timestamp nonce evidence, remote source content identity digest, remote source main-head ancestry digest, and remote_metadata_digest
      - worker_identity_ref, worker_identity_digest, and integrity-guardian worker_identity_signature_digest are bound to patch digest and base/head commit evidence
      - workspace-enacted marker-only changed files are classified from repo-local diff summaries or structured patch-segment manifests, counted, and digest-bound, and receipts whose only payload is marker comments remain blocked
      - remote metadata, remote source revocation status, revocation freshness window, signed provider timestamp evidence, timestamp replay guard, remote source content identity, and remote source ancestry are digest-bound and redacted before remote results can become accept-ready
      - changed_files must remain inside both the repo-local allowed workspace prefixes and the worker ownership_scope
      - patch payload, raw worker identity payload, raw workspace marker diff or segment payload, raw remote metadata payload, raw remote revocation payload, raw remote content payload, raw remote ancestry payload, raw remote timestamp replay payload, raw worker transcript, raw stdout, and raw stderr are never stored; only digest fields, line counts, segment counts, and classifier status remain
      - unittest discover and gap-report required verification commands must pass before main checkout integration is accepted
      - blocked, stale, or failed worker results remain schema-bound but cannot be integrated
  ingest_yaoyorozu_dispatch_receipt:
    summary: Reduce one Yaoyorozu worker-dispatch receipt and its patch-candidate receipts into a Parallel Codex main-checkout ingestion receipt.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - dispatch_receipt
          - main_checkout_head
          - worker_base_commit
          - verification_results
        properties:
          dispatch_receipt:
            type: object
            minProperties: 1
          main_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          worker_base_commit:
            type: string
            pattern: "^[a-f0-9]{40}$"
          verification_results:
            type: array
            minItems: 1
          result_summary:
            type: string
          ownership_scope:
            type: array
            items:
              type: string
              minLength: 1
    output:
      schema_ref: parallel_codex_worker_result_receipt
    guarantees:
      - source_system is yaoyorozu-worker-dispatch
      - the derived worker identity evidence binds the Yaoyorozu dispatch receipt id to the same patch digest used for main-checkout ingestion
      - upstream dispatch receipt digest, patch-candidate receipt refs/digests, and changed-file list are bound by upstream_binding_digest
      - patch_digest is derived from the dispatch receipt digest, dispatch plan digest, patch-candidate receipt digests, and changed files
      - raw Yaoyorozu dispatch payloads, raw patch payloads, remote metadata payloads, remote revocation payloads, transcripts, stdout, and stderr are not stored in the Parallel Codex receipt
      - main checkout integration remains blocked unless the worker base commit is fresh and the required verification commands pass
  plan_integration_batch:
    summary: Reduce multiple Parallel Codex worker-result receipts into one deterministic integration batch receipt with conflict arbitration.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - receipts
          - main_checkout_head
          - verification_results
          - result_summary
        properties:
          receipts:
            type: array
            minItems: 1
            items:
              schema_ref: parallel_codex_worker_result_receipt
          main_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          verification_results:
            type: array
            minItems: 1
          result_summary:
            type: string
            minLength: 1
    output:
      schema_ref: parallel_codex_integration_batch_receipt
    guarantees:
      - only validated accept-ready worker receipts with matching main_checkout_head enter ordered integration
      - blocked, failed, stale, marker-only, stale-head, and otherwise invalid receipts are quarantined with receipt refs and digests only
      - the quarantined blocked receipt set is reduced to blocked-receipt-quarantine-manifest-v1 and quarantined_receipt_set_digest so raw blocked worker receipts never need to be stored
      - accepted receipts are ordered deterministically by receipt digest and receipt ref before integration
      - changed file owners are reduced to a digest-bound owner manifest before any checkout mutation
      - any changed-file overlap between accepted receipts makes the batch schema-bound but blocked
      - required unittest and gap-report verification commands must pass for the batch to become integration-ready
      - raw worker receipt payloads, raw conflict payloads, raw stdout, and raw stderr are never stored
  plan_integration_execution:
    summary: Reduce one integration-ready batch receipt into an ordered main-checkout apply plan and post-apply verification receipt.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - batch_receipt
          - current_checkout_head
          - post_apply_verification_results
          - result_summary
        properties:
          batch_receipt:
            schema_ref: parallel_codex_integration_batch_receipt
          current_checkout_head:
            type: string
            pattern: "^[a-f0-9]{40}$"
          pre_apply_dry_run_results:
            type: array
            minItems: 1
          post_apply_verification_results:
            type: array
            minItems: 1
          result_summary:
            type: string
            minLength: 1
    output:
      schema_ref: parallel_codex_integration_execution_receipt
    guarantees:
      - source batch receipt digest must validate before execution_decision can become ready-to-apply
      - current checkout head must still match the batch main checkout head before apply
      - ordered integration receipt refs/digests are carried forward from the batch and reduced to ordered apply steps
      - each apply step binds receipt ref, receipt digest, changed-file manifest digest, and apply_step_digest without raw patch payload storage
      - apply_plan_digest binds the ordered step digest set before a main checkout commit
      - pre_apply_dry_run_manifest_digest binds one dry-run check per apply step, and any failed dry-run keeps execution_decision blocked before checkout mutation
      - post-apply unittest and gap-report verification commands must pass and are stored only as digests
      - conflict, worker receipt, batch, patch, dry-run stdout/stderr, verification stdout/stderr, and other raw payloads are never stored
  validate_worker_result_receipt:
    summary: Recompute the changed-file manifest digest, verification manifest digest, receipt digest, and blocking reasons for a worker result receipt.
    input:
      schema_ref: parallel_codex_worker_result_receipt
    output:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - ok
          - ready_for_main_checkout
          - errors
        properties:
          ok:
            type: boolean
          ready_for_main_checkout:
            type: boolean
          errors:
            type: array
            items:
              type: string
  validate_integration_batch_receipt:
    summary: Recompute batch receipt set, ordered integration, quarantined receipt set, changed-file owner, conflict, verification, and receipt digests.
    input:
      schema_ref: parallel_codex_integration_batch_receipt
    output:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - ok
          - ready_for_integration
          - errors
        properties:
          ok:
            type: boolean
          ready_for_integration:
            type: boolean
          errors:
            type: array
            items:
              type: string
  validate_integration_execution_receipt:
    summary: Recompute execution apply-plan digest, post-apply verification manifest digest, receipt digest, and blocking reasons.
    input:
      schema_ref: parallel_codex_integration_execution_receipt
    output:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - ok
          - ready_to_apply
          - errors
        properties:
          ok:
            type: boolean
          ready_to_apply:
            type: boolean
          errors:
            type: array
            items:
              type: string
events:
  selfctor.parallel_orchestration.worker_result_ingested:
    payload:
      schema_ref: parallel_codex_worker_result_receipt
  selfctor.parallel_orchestration.integration_batch_planned:
    payload:
      schema_ref: parallel_codex_integration_batch_receipt
  selfctor.parallel_orchestration.integration_execution_planned:
    payload:
      schema_ref: parallel_codex_integration_execution_receipt
