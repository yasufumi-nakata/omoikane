idl_version: 1
kind: service
namespace: interface.biodata_transmitter.v0
service: BioDataTransmitterService
summary: >
  Canonical L6 contract for a person-bound transmitter that maps declared
  human biosignal features through a catalog-bound internal body-state latent
  before generating bounded target biosignal, affect, and thought-pressure
  proxies.
imports:
  biodata_human_biosignal_catalog: ../schemas/biodata_human_biosignal_catalog.schema
  biodata_transmitter_session: ../schemas/biodata_transmitter_session.schema
  biodata_body_state_latent: ../schemas/biodata_body_state_latent.schema
  biodata_signal_bundle: ../schemas/biodata_signal_bundle.schema
  biodata_calibration_profile: ../schemas/biodata_calibration_profile.schema
  biodata_calibration_confidence_gate: ../schemas/biodata_calibration_confidence_gate.schema
  biodata_calibration_refresh_receipt: ../schemas/biodata_calibration_refresh_receipt.schema
  biodata_dataset_adapter_receipt: ../schemas/biodata_dataset_adapter_receipt.schema
  biodata_survey_eeg_fusion_receipt: ../schemas/biodata_survey_eeg_fusion_receipt.schema
  biodata_circadian_phase_verifier_receipt: ../schemas/biodata_circadian_phase_verifier_receipt.schema
  biodata_feature_window_series_profile: ../schemas/biodata_feature_window_series_profile.schema
  biodata_feature_window_series_drift_gate: ../schemas/biodata_feature_window_series_drift_gate.schema
  biodata_drift_threshold_policy_authority_receipt: ../schemas/biodata_drift_threshold_policy_authority_receipt.schema
  biodata_mind_state_bridge: ../schemas/biodata_mind_state_bridge.schema
operations:
  get_human_biosignal_catalog:
    summary: Return the public human biosignal modality family catalog and uncatalogued-modality policy.
    input:
      inline_schema:
        type: object
        additionalProperties: false
    output:
      schema_ref: biodata_human_biosignal_catalog
    guarantees:
      - catalog_digest must bind the modality families and alias map
      - alias targets must resolve to known catalog modalities
      - uncatalogued human biosensors must remain accepted through the generic proxy policy
      - raw catalog and raw biosignal payload storage must remain false
  open_session:
    summary: Open one transmitter session for a single identity and explicit, catalog-bound human biosignal modality set.
    input:
      inline_schema:
        type: object
        required:
          - identity_id
          - source_modalities
          - target_modalities
        properties:
          identity_id:
            type: string
            minLength: 1
          source_modalities:
            type: array
            minItems: 1
            uniqueItems: true
            items:
              type: string
              pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
          target_modalities:
            type: array
            minItems: 1
            uniqueItems: true
            items:
              type: string
              pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
    output:
      schema_ref: biodata_transmitter_session
    guarantees:
      - session must remain person-bound to one identity_id
      - modality_policy_id, human_biosignal_catalog_digest, source_modality_families, target_modality_families, and uncatalogued_modality_policy must be bound
      - unresolved equivalence and thought-content claims must point to mind-upload.com conflict refs
      - raw source payload and raw generated waveform storage must be false
  adapt_dataset_feature_window:
    summary: Bind one external dataset feature window to a body-state latent without storing raw samples.
    input:
      inline_schema:
        type: object
        required:
          - session_id
          - dataset_manifest
          - window_feature_summaries
          - context_label
        properties:
          session_id:
            type: string
            minLength: 8
          dataset_manifest:
            type: object
            required:
              - dataset_ref
              - participant_ref
              - license_ref
              - window_ref
              - modality_file_refs
            properties:
              dataset_ref:
                type: string
                minLength: 1
              participant_ref:
                type: string
                minLength: 1
              license_ref:
                type: string
                minLength: 1
              window_ref:
                type: string
                minLength: 1
              modality_file_refs:
                type: object
                minProperties: 1
          window_feature_summaries:
            type: object
            minProperties: 1
          context_label:
            type: string
            minLength: 1
    output:
      inline_schema:
        type: object
        required:
          - adapter_receipt
          - latent_state
        properties:
          adapter_receipt:
            schema_ref: biodata_dataset_adapter_receipt
          latent_state:
            schema_ref: biodata_body_state_latent
    guarantees:
      - dataset_manifest_digest must bind the dataset ref, participant ref, license ref, window ref, and modality file refs
      - source_feature_digest and latent_digest must match the generated body-state latent
      - full confidence-gate readiness requires all session-declared source modality feature-window coverage
      - raw dataset payload, raw signal samples, and raw feature-window payload storage must remain false
  bind_survey_eeg_window_fusion:
    summary: Bind one self-report survey score summary to an EEG feature window and body-state latent for bounded LLM-native analysis.
    input:
      inline_schema:
        type: object
        required:
          - session
          - adapter_receipt
          - latent_state
          - survey_instrument_manifest
          - survey_score_summary
          - alignment_evidence_refs
          - analysis_question
          - operator_intent_ref
        properties:
          session:
            schema_ref: biodata_transmitter_session
          adapter_receipt:
            schema_ref: biodata_dataset_adapter_receipt
          latent_state:
            schema_ref: biodata_body_state_latent
          survey_instrument_manifest:
            type: object
            required:
              - instrument_ref
              - administration_ref
              - participant_ref
              - language
              - scale_refs
            properties:
              instrument_ref:
                type: string
                minLength: 1
              administration_ref:
                type: string
                minLength: 1
              participant_ref:
                type: string
                minLength: 1
              language:
                type: string
                minLength: 2
              scale_refs:
                type: object
                minProperties: 1
          survey_score_summary:
            type: object
            minProperties: 2
          alignment_evidence_refs:
            type: array
            minItems: 2
            uniqueItems: true
            items:
              type: string
              minLength: 1
          analysis_question:
            type: string
            minLength: 1
          operator_intent_ref:
            type: string
            minLength: 1
    output:
      schema_ref: biodata_survey_eeg_fusion_receipt
    guarantees:
      - adapter receipt, EEG feature digest, latent digest, survey instrument digest, survey score digest, and alignment evidence digest set must be bound into one fused_window_digest
      - survey scores must be normalized score summaries; raw survey answers and raw EEG samples must not be stored
      - output must bind llm-native-no-ml-operator-playbook-v1 so non-ML operators can consume a plain-language workflow artifact
      - claim ceiling must remain survey-eeg-correlation-input-only with no diagnosis, thought-content, consciousness, or identity-replacement claim
  bind_circadian_phase_verifier:
    summary: Bind circadian phase refs to external clock, sleep diary, and wearable evidence before series use.
    input:
      inline_schema:
        type: object
        required:
          - session
          - circadian_phase_refs
          - verifier_sources
        properties:
          session:
            schema_ref: biodata_transmitter_session
          circadian_phase_refs:
            type: array
            minItems: 2
            uniqueItems: true
            items:
              type: string
              minLength: 1
          verifier_sources:
            type: array
            minItems: 3
            maxItems: 3
            items:
              type: object
              required:
                - source_type
                - source_ref
                - evidence_ref
                - verifier_key_ref
              properties:
                source_type:
                  type: string
                  enum: [external-clock, sleep-diary, wearable]
                source_ref:
                  type: string
                  minLength: 1
                evidence_ref:
                  type: string
                  minLength: 1
                verifier_key_ref:
                  type: string
                  minLength: 1
    output:
      schema_ref: biodata_circadian_phase_verifier_receipt
    guarantees:
      - phase_ref_digest_set must bind the ordered circadian phase refs
      - verifier_source_digest_set must bind external clock, sleep diary, and wearable evidence refs
      - raw clock, sleep diary, wearable, phase, and verifier payload storage must remain false
  build_feature_window_series_profile:
    summary: Aggregate two or more dataset adapter receipts into a digest-only longitudinal / circadian latent series.
    input:
      inline_schema:
        type: object
        required:
          - session
          - adapter_receipts
          - latent_states
          - circadian_phase_refs
        properties:
          session:
            schema_ref: biodata_transmitter_session
          adapter_receipts:
            type: array
            minItems: 2
            items:
              schema_ref: biodata_dataset_adapter_receipt
          latent_states:
            type: array
            minItems: 2
            items:
              schema_ref: biodata_body_state_latent
          circadian_phase_refs:
            type: array
            minItems: 2
            uniqueItems: true
            items:
              type: string
              minLength: 1
          circadian_phase_verifier_receipt:
            schema_ref: biodata_circadian_phase_verifier_receipt
    output:
      schema_ref: biodata_feature_window_series_profile
    guarantees:
      - adapter_receipt_digests and latent_digests must be ordered and digest-bound
      - circadian_phase_refs must contain at least two unique phase refs
      - circadian_phase_verifier_digest must be bound when external phase evidence is supplied
      - axis_drift_summary must be derived from body-state latent axes, not raw source payload
      - raw dataset, signal sample, feature-window, latent, and series payload storage must remain false
  bind_feature_window_series_drift_gate:
    summary: Compare one feature-window series drift summary against bounded thresholds before calibration gate consumption.
    input:
      inline_schema:
        type: object
        required:
          - session
          - series_profile
          - calibration_profile
        properties:
          session:
            schema_ref: biodata_transmitter_session
          series_profile:
            schema_ref: biodata_feature_window_series_profile
          calibration_profile:
            schema_ref: biodata_calibration_profile
          axis_thresholds:
            type: object
            additionalProperties:
              type: number
              minimum: 0
          threshold_policy_authority_receipt:
            schema_ref: biodata_drift_threshold_policy_authority_receipt
    output:
      schema_ref: biodata_feature_window_series_drift_gate
    guarantees:
      - series_profile_digest and calibration_digest must both be bound
      - feature-window series latent digests must match the calibration source latent digests
      - axis_drift_checks must compare ordered series drift against bounded thresholds
      - threshold policy authority refs must be digest-bound when supplied
      - raw series, calibration, and drift payload storage must remain false
  bind_drift_threshold_policy_authority:
    summary: Bind feature-window drift thresholds to clinical, jurisdiction, and Guardian authority refs.
    input:
      inline_schema:
        type: object
        required:
          - session
          - policy_sources
        properties:
          session:
            schema_ref: biodata_transmitter_session
          policy_sources:
            type: array
            minItems: 3
            maxItems: 3
            items:
              type: object
              required:
                - authority_role
                - authority_ref
                - policy_ref
                - signer_key_ref
                - signature_ref
                - jurisdiction
              properties:
                authority_role:
                  type: string
                  enum: [clinical-reviewer, jurisdiction-policy, guardian]
                authority_ref:
                  type: string
                  minLength: 1
                policy_ref:
                  type: string
                  minLength: 1
                signer_key_ref:
                  type: string
                  minLength: 1
                signature_ref:
                  type: string
                  minLength: 1
                jurisdiction:
                  type: string
                  minLength: 1
          axis_thresholds:
            type: object
            additionalProperties:
              type: number
              minimum: 0
    output:
      schema_ref: biodata_drift_threshold_policy_authority_receipt
    guarantees:
      - axis_threshold_digest must bind the exact threshold set consumed by the drift gate
      - clinical reviewer, jurisdiction policy, and Guardian authority refs must all be present
      - signer key refs and signature refs are retained only as digest-bound refs
      - raw threshold policy, signature, authority, and reviewer payload storage must remain false
  encode_body_state:
    summary: Convert source biosignal features into a digest-bound internal body-state latent.
    input:
      inline_schema:
        type: object
        required:
          - session_id
          - biosignal_features
          - context_label
        properties:
          session_id:
            type: string
            minLength: 8
          biosignal_features:
            type: object
            minProperties: 1
          context_label:
            type: string
            minLength: 1
    output:
      schema_ref: biodata_body_state_latent
    guarantees:
      - source_feature_digest must bind the input feature summary
      - source_modality_projections must bind every observed modality by feature digest, family, catalog status, and generic projection summary
      - physiological axes must include cardiac, autonomic, respiratory, neural, affect, and thought proxies
      - thought axis must not contain generated semantic thought content
  generate_biosignal_bundle:
    summary: Generate bounded target biosignal proxies from one internal body-state latent.
    input:
      inline_schema:
        type: object
        required:
          - session_id
          - latent_state
        properties:
          session_id:
            type: string
            minLength: 8
          latent_state:
            schema_ref: biodata_body_state_latent
          target_modalities:
            type: array
            minItems: 1
            uniqueItems: true
            items:
              type: string
              pattern: "^[a-z0-9][a-z0-9_-]{0,63}$"
    output:
      schema_ref: biodata_signal_bundle
    guarantees:
      - source_latent_digest must match the latent input digest
      - target signals must bind target_modality_family, catalog_status, and human_biosignal_catalog_digest
      - unknown target modalities must be emitted only as generic feature-summary biosignal proxies
      - semantic_thought_content_generated must remain false
      - subjective_equivalence_claimed must remain false
  build_calibration_profile:
    summary: Bind multiple days of body-state latents into one digest-only personal calibration profile.
    input:
      inline_schema:
        type: object
        required:
          - session_id
          - latent_states
          - calibration_day_refs
        properties:
          session_id:
            type: string
            minLength: 8
          latent_states:
            type: array
            minItems: 2
            items:
              schema_ref: biodata_body_state_latent
          calibration_day_refs:
            type: array
            minItems: 2
            uniqueItems: true
            items:
              type: string
              pattern: "^calibration-day://"
    output:
      schema_ref: biodata_calibration_profile
    guarantees:
      - source_latent_digest_set_digest must bind the ordered source latent digests and day refs
      - axis_baselines must be digest-only personal baselines derived from at least two days
      - raw source, raw latent, and raw calibration payload storage must remain false
  validate_transmission:
    summary: Verify session, latent, generated bundle, literature refs, and conflict sink binding.
    input:
      inline_schema:
        type: object
        required:
          - session
          - latent_state
          - generated_bundle
        properties:
          session:
            schema_ref: biodata_transmitter_session
          latent_state:
            schema_ref: biodata_body_state_latent
          generated_bundle:
            schema_ref: biodata_signal_bundle
    output:
      inline_schema:
        type: object
        required:
          - ok
          - literature_backed_intermediate
          - mind_upload_conflict_sink_bound
          - target_modalities_generated
          - semantic_thought_content_generated
          - subjective_equivalence_claimed
        properties:
          ok:
            type: boolean
          literature_backed_intermediate:
            type: boolean
          mind_upload_conflict_sink_bound:
            type: boolean
          target_modalities_generated:
            type: boolean
          semantic_thought_content_generated:
            const: false
          subjective_equivalence_claimed:
            const: false
  validate_calibration_profile:
    summary: Verify multi-day calibration digest binding, raw-payload redaction, and conflict sink boundaries.
    input:
      inline_schema:
        type: object
        required:
          - session
          - latent_states
          - calibration_profile
        properties:
          session:
            schema_ref: biodata_transmitter_session
          latent_states:
            type: array
            minItems: 2
            items:
              schema_ref: biodata_body_state_latent
          calibration_profile:
            schema_ref: biodata_calibration_profile
    output:
      inline_schema:
        type: object
        required:
          - ok
          - multi_day_calibration_bound
          - source_latent_digest_set_bound
          - calibration_digest_bound
          - axis_baselines_bound
          - raw_calibration_payload_stored
        properties:
          ok:
            type: boolean
          multi_day_calibration_bound:
            type: boolean
          source_latent_digest_set_bound:
            type: boolean
          calibration_digest_bound:
            type: boolean
          axis_baselines_bound:
            type: boolean
          raw_calibration_payload_stored:
            const: false
  bind_calibration_confidence_gate:
    summary: Bind one complete calibration profile to identity-confirmation and sensory-loopback confidence gates without raw payload storage.
    input:
      inline_schema:
        type: object
        required:
          - session
          - calibration_profile
          - target_gate_refs
        properties:
          session:
            schema_ref: biodata_transmitter_session
          calibration_profile:
            schema_ref: biodata_calibration_profile
          target_gate_refs:
            type: object
            minProperties: 2
            maxProperties: 2
            propertyNames:
              enum:
                - identity-confirmation
                - sensory-loopback
            additionalProperties:
              type: string
              minLength: 1
          feature_window_series_drift_gate_receipt:
            schema_ref: biodata_feature_window_series_drift_gate
          calibration_refresh_receipt:
            schema_ref: biodata_calibration_refresh_receipt
    output:
      schema_ref: biodata_calibration_confidence_gate
    guarantees:
      - calibration_digest_bound must prove the receipt is bound to the exact calibration profile
      - feature-window series drift gate digest must be directly bound when a drift gate receipt is supplied
      - calibration refresh receipt digest must be directly bound when current freshness is supplied
      - source_modalities_covered must cover every session-declared source modality before any target gate can pass
      - identity-confirmation gates require confidence_score >= 0.8
      - sensory-loopback gates require confidence_score >= 0.7
      - raw calibration and gate payload storage must remain false
  bind_calibration_refresh_receipt:
    summary: Bind a calibration profile to a current drift gate, self consent, Guardian review, and a bounded freshness window before confidence-gate consumption.
    input:
      inline_schema:
        type: object
        required:
          - session
          - calibration_profile
          - feature_window_series_drift_gate_receipt
          - refresh_sources
        properties:
          session:
            schema_ref: biodata_transmitter_session
          calibration_profile:
            schema_ref: biodata_calibration_profile
          feature_window_series_drift_gate_receipt:
            schema_ref: biodata_feature_window_series_drift_gate
          refresh_sources:
            type: array
            minItems: 3
            maxItems: 3
            items:
              type: object
              required:
                - source_type
                - source_ref
                - evidence_ref
                - verifier_key_ref
                - freshness_status_ref
              properties:
                source_type:
                  type: string
                  enum: [current-drift-gate, self-consent, guardian-review]
                source_ref:
                  type: string
                  minLength: 1
                evidence_ref:
                  type: string
                  minLength: 1
                verifier_key_ref:
                  type: string
                  minLength: 1
                freshness_status_ref:
                  type: string
                  minLength: 1
          freshness_window_days:
            type: integer
            minimum: 1
            maximum: 90
          refresh_deadline_ref:
            type: string
            minLength: 1
          refreshed_at_ref:
            type: string
            minLength: 1
    output:
      schema_ref: biodata_calibration_refresh_receipt
    guarantees:
      - calibration_digest and drift_gate_digest must both be bound before confidence-gate reuse
      - refresh sources must cover current-drift-gate, self-consent, and guardian-review
      - freshness_window_days must be bounded to 1-90 days and refresh_status must be fresh
      - raw calibration, drift, threshold-policy, refresh, and gate payload storage must remain false
  validate_calibration_confidence_gate:
    summary: Verify calibration confidence-gate digest binding, target threshold checks, and raw-payload redaction.
    input:
      inline_schema:
        type: object
        required:
          - session
          - calibration_profile
          - gate_receipt
        properties:
          session:
            schema_ref: biodata_transmitter_session
          calibration_profile:
            schema_ref: biodata_calibration_profile
          gate_receipt:
            schema_ref: biodata_calibration_confidence_gate
    output:
      inline_schema:
        type: object
        required:
          - ok
          - calibration_profile_bound
          - required_modalities_bound
          - target_gate_set_digest_bound
          - gate_receipt_digest_bound
          - calibration_refresh_bound
          - identity_confirmation_gate_bound
          - sensory_loopback_gate_bound
          - raw_gate_payload_stored
        properties:
          ok:
            type: boolean
          calibration_profile_bound:
            type: boolean
          required_modalities_bound:
            type: boolean
          target_gate_set_digest_bound:
            type: boolean
          gate_receipt_digest_bound:
            type: boolean
          calibration_refresh_bound:
            type: boolean
          calibration_refresh_status:
            type: string
            enum: [fresh, not-bound]
          calibration_refresh_window_bound:
            type: boolean
          identity_confirmation_gate_bound:
            type: boolean
          sensory_loopback_gate_bound:
            type: boolean
          raw_gate_payload_stored:
            const: false
  bind_mind_state_bridge:
    summary: Bind a BioData body-state latent to bounded downstream mind-state consumers without raw payload or consciousness claims.
    input:
      inline_schema:
        type: object
        required:
          - session
          - latent_state
          - generated_bundle
          - calibration_profile
          - calibration_confidence_gate
        properties:
          session:
            schema_ref: biodata_transmitter_session
          latent_state:
            schema_ref: biodata_body_state_latent
          generated_bundle:
            schema_ref: biodata_signal_bundle
          calibration_profile:
            schema_ref: biodata_calibration_profile
          calibration_confidence_gate:
            schema_ref: biodata_calibration_confidence_gate
          feature_window_series_profile:
            schema_ref: biodata_feature_window_series_profile
    output:
      schema_ref: biodata_mind_state_bridge
    guarantees:
      - body_state_latent_digest, generated_bundle_digest, and calibration_confidence_gate_digest must all be bound
      - QualiaBuffer and SelfModel consumers receive only digest-bound surrogate/advisory refs
      - L3 perception, affect, and attention consumers receive handoff receipts under the same claim ceiling
      - semantic_thought_content_generated, subjective_equivalence_claimed, consciousness_reproduction_claimed, and identity_replacement_claimed must remain false
      - raw biodata, latent, generated, gate, qualia, and self-model payload storage must remain false
  validate_mind_state_bridge:
    summary: Verify BioData mind-state bridge digest binding, allowed consumers, and no-consciousness claim ceiling.
    input:
      inline_schema:
        type: object
        required:
          - session
          - latent_state
          - generated_bundle
          - calibration_profile
          - calibration_confidence_gate
          - bridge_receipt
        properties:
          session:
            schema_ref: biodata_transmitter_session
          latent_state:
            schema_ref: biodata_body_state_latent
          generated_bundle:
            schema_ref: biodata_signal_bundle
          calibration_profile:
            schema_ref: biodata_calibration_profile
          calibration_confidence_gate:
            schema_ref: biodata_calibration_confidence_gate
          bridge_receipt:
            schema_ref: biodata_mind_state_bridge
          feature_window_series_profile:
            schema_ref: biodata_feature_window_series_profile
    output:
      inline_schema:
        type: object
        required:
          - ok
          - body_state_latent_bound
          - generated_bundle_bound
          - calibration_confidence_gate_bound
          - qualia_surrogate_bound
          - self_model_advisory_bound
          - l2_l3_handoffs_bound
          - claim_ceiling_bound
          - bridge_digest_bound
          - consciousness_reproduction_claimed
          - identity_replacement_claimed
        properties:
          ok:
            type: boolean
          body_state_latent_bound:
            type: boolean
          generated_bundle_bound:
            type: boolean
          calibration_confidence_gate_bound:
            type: boolean
          feature_window_series_bound:
            type: boolean
          qualia_surrogate_bound:
            type: boolean
          self_model_advisory_bound:
            type: boolean
          l2_l3_handoffs_bound:
            type: boolean
          claim_ceiling_bound:
            type: boolean
          bridge_digest_bound:
            type: boolean
          consciousness_reproduction_claimed:
            const: false
          identity_replacement_claimed:
            const: false
  validate_feature_window_series_drift_gate:
    summary: Verify BioData feature-window series drift threshold binding and raw-payload redaction.
    input:
      inline_schema:
        type: object
        required:
          - session
          - series_profile
          - calibration_profile
          - drift_gate_receipt
        properties:
          session:
            schema_ref: biodata_transmitter_session
          series_profile:
            schema_ref: biodata_feature_window_series_profile
          calibration_profile:
            schema_ref: biodata_calibration_profile
          drift_gate_receipt:
            schema_ref: biodata_feature_window_series_drift_gate
          threshold_policy_authority_receipt:
            schema_ref: biodata_drift_threshold_policy_authority_receipt
    output:
      inline_schema:
        type: object
        required:
          - ok
          - series_profile_bound
          - calibration_profile_bound
          - series_calibration_latent_set_bound
          - drift_threshold_digest_bound
          - drift_gate_digest_bound
          - raw_drift_payload_stored
        properties:
          ok:
            type: boolean
          series_profile_bound:
            type: boolean
          calibration_profile_bound:
            type: boolean
          series_calibration_latent_set_bound:
            type: boolean
          drift_threshold_digest_bound:
            type: boolean
          drift_gate_digest_bound:
            type: boolean
          threshold_policy_authority_bound:
            type: boolean
          raw_drift_payload_stored:
            const: false
  validate_calibration_refresh_receipt:
    summary: Verify BioData calibration refresh-window binding and raw-payload redaction before confidence-gate consumption.
    input:
      inline_schema:
        type: object
        required:
          - session
          - calibration_profile
          - feature_window_series_drift_gate_receipt
          - refresh_receipt
        properties:
          session:
            schema_ref: biodata_transmitter_session
          calibration_profile:
            schema_ref: biodata_calibration_profile
          feature_window_series_drift_gate_receipt:
            schema_ref: biodata_feature_window_series_drift_gate
          refresh_receipt:
            schema_ref: biodata_calibration_refresh_receipt
    output:
      inline_schema:
        type: object
        required:
          - ok
          - calibration_profile_bound
          - feature_window_series_drift_gate_bound
          - refresh_window_bound
          - refresh_source_digest_set_bound
          - refresh_receipt_digest_bound
          - raw_refresh_payload_stored
        properties:
          ok:
            type: boolean
          calibration_profile_bound:
            type: boolean
          feature_window_series_drift_gate_bound:
            type: boolean
          threshold_policy_authority_digest_bound:
            type: boolean
          refresh_window_bound:
            type: boolean
          refresh_source_digest_set_bound:
            type: boolean
          refresh_receipt_digest_bound:
            type: boolean
          raw_refresh_payload_stored:
            const: false
  validate_drift_threshold_policy_authority:
    summary: Verify threshold authority quorum digest binding and raw-payload redaction.
    input:
      inline_schema:
        type: object
        required:
          - session
          - authority_receipt
        properties:
          session:
            schema_ref: biodata_transmitter_session
          axis_thresholds:
            type: object
            additionalProperties:
              type: number
              minimum: 0
          authority_receipt:
            schema_ref: biodata_drift_threshold_policy_authority_receipt
    output:
      inline_schema:
        type: object
        required:
          - ok
          - axis_threshold_digest_bound
          - authority_source_digest_set_bound
          - required_authority_roles_bound
          - authority_receipt_digest_bound
          - raw_threshold_policy_payload_stored
        properties:
          ok:
            type: boolean
          axis_threshold_digest_bound:
            type: boolean
          authority_source_digest_set_bound:
            type: boolean
          required_authority_roles_bound:
            type: boolean
          authority_receipt_digest_bound:
            type: boolean
          raw_threshold_policy_payload_stored:
            const: false
  validate_circadian_phase_verifier:
    summary: Verify circadian phase source quorum digest binding and raw-payload redaction.
    input:
      inline_schema:
        type: object
        required:
          - session
          - circadian_phase_refs
          - verifier_receipt
        properties:
          session:
            schema_ref: biodata_transmitter_session
          circadian_phase_refs:
            type: array
            minItems: 2
            uniqueItems: true
            items:
              type: string
              minLength: 1
          verifier_receipt:
            schema_ref: biodata_circadian_phase_verifier_receipt
    output:
      inline_schema:
        type: object
        required:
          - ok
          - phase_ref_digest_set_bound
          - verifier_source_digest_set_bound
          - required_source_types_bound
          - phase_verifier_digest_bound
          - raw_verifier_payload_stored
        properties:
          ok:
            type: boolean
          phase_ref_digest_set_bound:
            type: boolean
          verifier_source_digest_set_bound:
            type: boolean
          required_source_types_bound:
            type: boolean
          phase_verifier_digest_bound:
            type: boolean
          raw_verifier_payload_stored:
            const: false
  validate_dataset_adapter_receipt:
    summary: Verify dataset manifest digest binding, latent binding, modality coverage, and raw-payload redaction.
    input:
      inline_schema:
        type: object
        required:
          - session
          - dataset_manifest
          - latent_state
          - adapter_receipt
        properties:
          session:
            schema_ref: biodata_transmitter_session
          dataset_manifest:
            type: object
            minProperties: 1
          latent_state:
            schema_ref: biodata_body_state_latent
          adapter_receipt:
            schema_ref: biodata_dataset_adapter_receipt
    output:
      inline_schema:
        type: object
        required:
          - ok
          - dataset_manifest_digest_bound
          - source_feature_digest_bound
          - latent_digest_bound
          - required_modalities_bound
          - adapter_receipt_digest_bound
          - raw_dataset_payload_stored
          - raw_signal_samples_stored
          - raw_feature_window_payload_stored
        properties:
          ok:
            type: boolean
          dataset_manifest_digest_bound:
            type: boolean
          source_feature_digest_bound:
            type: boolean
          latent_digest_bound:
            type: boolean
          required_modalities_bound:
            type: boolean
          adapter_receipt_digest_bound:
            type: boolean
          raw_dataset_payload_stored:
            const: false
          raw_signal_samples_stored:
            const: false
          raw_feature_window_payload_stored:
            const: false
events:
  biodata_transmitter.dataset_feature_window_adapted:
    payload:
      schema_ref: biodata_dataset_adapter_receipt
  biodata_transmitter.circadian_phase_verifier_bound:
    payload:
      schema_ref: biodata_circadian_phase_verifier_receipt
  biodata_transmitter.body_state_encoded:
    payload:
      schema_ref: biodata_body_state_latent
  biodata_transmitter.signal_bundle_generated:
    payload:
      schema_ref: biodata_signal_bundle
  biodata_transmitter.calibration_profile_bound:
    payload:
      schema_ref: biodata_calibration_profile
  biodata_transmitter.drift_threshold_policy_authority_bound:
    payload:
      schema_ref: biodata_drift_threshold_policy_authority_receipt
  biodata_transmitter.calibration_refresh_bound:
    payload:
      schema_ref: biodata_calibration_refresh_receipt
  biodata_transmitter.calibration_confidence_gate_bound:
    payload:
      schema_ref: biodata_calibration_confidence_gate
  biodata_transmitter.mind_state_bridge_bound:
    payload:
      schema_ref: biodata_mind_state_bridge
  biodata_transmitter.feature_window_series_drift_gate_bound:
    payload:
      schema_ref: biodata_feature_window_series_drift_gate
compatibility:
  stability: bootstrap
  notes:
    - This contract changes the project image toward biosignal transduction without renaming OmoikaneOS.
    - The intermediate representation is a literature-backed physiological latent, not a claim of full qualia or semantic thought recovery.
    - Conflicting or under-evidenced claims are routed to mind-upload.com refs rather than treated as settled runtime facts.
    - Multi-day calibration profiles improve person-specific baselines but still do not claim subjective equivalence or semantic thought recovery.
    - Calibration confidence gates may raise confidence for identity confirmation and sensory loopback only through digest-bound calibration receipts; they do not expose raw biosignal or gate payloads.
    - Dataset feature-window adapters make session-declared external BioData corpora ingestible only as manifest digests, feature-window digests, and latent refs; raw samples are out of scope.
    - Circadian phase verifiers bind phase refs to external clock, sleep diary, and wearable evidence digests without storing raw phase evidence.
    - Feature-window series drift gates let calibration confidence gates consume current longitudinal evidence only through bounded, digest-only drift-threshold receipts.
    - Drift threshold policy authority receipts bind clinical, jurisdiction, and Guardian threshold policy refs without storing raw policy or signature payloads.
    - Calibration refresh receipts force current drift-gate, self-consent, Guardian review, and freshness-window evidence to be digest-bound before a calibration gate is reused.
    - Mind-state bridge receipts may feed L2/L3 surrogate/advisory consumers, but they remain body-state surrogate inputs and do not claim consciousness reproduction or identity replacement.
