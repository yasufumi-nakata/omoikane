idl_version: 1
kind: service
namespace: selfctor.gap_report.v0
service: GapReportService
summary: Emit a schema-bound self-construction gap report with top-level eval inventory drift checks, decision-log README index checks, decision-log metadata conformance checks, agent source definition validation, truth-source residual marker checks, tracked worktree marker-residue checks, tracked/untracked generated artifact hygiene checks for build output, caches, and platform metadata, ignored generated artifact hygiene checks for packaging/release output, ignored platform metadata hygiene checks, and a digest-bound scan receipt for automation gates.
imports:
  gap_report: ../schemas/gap_report.schema
operations:
  scan_repo:
    summary: Scan one repository root for open questions, required automation references, top-level and per-surface inventory drift, decision-log README index drift, decision-log frontmatter metadata violations, catalog coverage gaps, truth-source residual markers, agent source definition violations, runtime stubs, tracked worktree workspace marker residue, tracked/untracked build/cache/platform generated artifacts, ignored packaging/release generated artifacts, ignored platform metadata, and latest decision-log follow-up, then append a digest-only scan event to ContinuityLedger.
    input:
      inline_schema:
        type: object
        additionalProperties: false
        required:
          - repo_root
        properties:
          repo_root:
            type: string
            minLength: 1
    output:
      schema_ref: gap_report
    guarantees:
      - report counts must match the corresponding hit arrays and prioritized task list
      - scan_receipt must bind the entire report payload through report_digest without storing raw report payload separately
      - scan_receipt must bind each matched truth-source file through scan_surface_digests and surface_manifest_digest without storing raw source payloads
      - scan_receipt must bind report_digest plus surface_manifest_digest to a continuity_event_ref / continuity_event_digest pair without storing raw continuity event payload
      - scan_receipt must expose the real continuity ledger entry ref, entry hash, payload ref, and self+guardian signature roles after the reference runtime append path succeeds
      - all_zero must be true only when every gap count and prioritized_task_count is zero
      - inventory README scans must treat only top-level bullets as inventory entries and must report duplicate top-level entries before all-zero completion
      - evals/README.md must enumerate every implemented eval YAML by repo-local eval path, while evals/*/README.md must continue to enumerate each local eval surface
      - meta/decision-log/README.md must enumerate every repo-local dated decision-log markdown file and must not list missing decision-log files
      - every repo-local dated decision-log markdown file must carry frontmatter with date, deciders, related_docs, and an accepted/decided/superseded status before all-zero completion
      - agents/**/*.yaml must satisfy the schema-bound-agent-source-definition-v1 contract before all-zero completion, and violations must be reported without storing raw agent source payloads
      - operating-playbook, parallel-codex-orchestration, repo-coverage-checklist, and verification-checklist must be required repo-local references
      - present repo-local references must retain their required section-level policies so empty or truncated runbooks cannot pass the all-zero gate
      - abstract Backend extension hooks are excluded from implementation_stub_hits, while concrete NotImplementedError paths remain reportable
      - tracked worktree diff is digest-bound as git:tracked-worktree-diff and any added workspace-enacted marker residue is reported as worktree_workspace_marker_hits before all-zero completion
      - tracked generated artifact paths, including build output, caches, coverage output, bytecode, packaging output, patch artifacts, and platform metadata, are digest-bound as git:tracked-generated-artifacts and reported as tracked_generated_artifact_hits without reading raw artifact payloads
      - untracked generated artifact paths, including build output, caches, coverage output, bytecode, packaging output, patch artifacts, and platform metadata, are digest-bound as git:untracked-generated-artifacts and reported as untracked_generated_artifact_hits without reading raw artifact payloads
      - ignored generated artifact paths for packaging, release, patch, and coverage output are digest-bound as git:ignored-generated-artifacts and reported as ignored_generated_artifact_hits without reading raw artifact payloads; unittest-created bytecode and test caches remain outside this ignored-only gate
      - ignored platform metadata paths hidden by .gitignore or global excludes are digest-bound as git:ignored-platform-metadata and reported as ignored_platform_metadata_hits without reading raw artifact payloads
      - truth-source residual marker rules cover English and Japanese implementation-backlog wording before all-zero completion while closed backlog statements remain ignored
      - latest decision-log residual and frontier chains must respect closes_next_gaps frontmatter
events:
  selfctor.gap_report.scanned:
    payload:
      schema_ref: gap_report
